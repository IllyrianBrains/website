---
import SectionTitle from './SectionTitle.astro';

const joinUrl = '/anetaresohu/';
---
<section class="section grid-surface join-cta tone-grey">
  <div class="container">
    <SectionTitle kicker="Bashkohu" title="Bëhu pjesë e Illyrian Brains." text="Gjej komunitetin tënd, merr pjesë në një event ose ndihmo të krijojmë një komunitet të ri në qytetin ku jeton." />
    <div class="join-cta-actions">
      <a class="partner-button" href="/qytetet/">Gjej komunitetin tënd <span aria-hidden="true">↗</span></a>
      <a class="partner-button" href={joinUrl}>Bashkohu <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
