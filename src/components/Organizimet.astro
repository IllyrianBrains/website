---
import SectionTitle from './SectionTitle.astro';
import { cities } from '../data/cities';

const allImages = cities.map((city) => city.image).filter((image): image is string => Boolean(image));

// Alternating 1 (big) / 2 (stacked pair) rhythm, matching the source site's gallery.
type Slot = { double: false; images: [string] } | { double: true; images: [string, string] };
const slots: Slot[] = [];
for (let i = 0, big = true; i < allImages.length; big = !big) {
  if (big) {
    slots.push({ double: false, images: [allImages[i]] });
    i += 1;
  } else if (i + 1 < allImages.length) {
    slots.push({ double: true, images: [allImages[i], allImages[i + 1]] });
    i += 2;
  } else {
    slots.push({ double: false, images: [allImages[i]] });
    i += 1;
  }
}
const loopSlots = [...slots, ...slots];
---
<section class="section tone-white">
  {slots.length > 0 && (
    <div class="photo-strip" aria-hidden="true">
      <div class="photo-strip-track">
        {loopSlots.map((slot) => (
          slot.double ? (
            <div class="photo-slot photo-slot-double">
              <img src={encodeURI(slot.images[0])} alt="" loading="lazy" />
              <img src={encodeURI(slot.images[1])} alt="" loading="lazy" />
            </div>
          ) : (
            <div class="photo-slot photo-slot-single">
              <img src={encodeURI(slot.images[0])} alt="" loading="lazy" />
            </div>
          )
        ))}
      </div>
    </div>
  )}
  <div class="container">
    <SectionTitle title="Organizimet" text="Boshti i komuniteteve të Illyrian Brains është vazhdimësia e eventeve shoqërore për profesionistët. Këtu gjenden miq, diskutohen ide, krijohet ndryshim! Bëhuni pjesë e ndryshimit!" />
  </div>
</section>
