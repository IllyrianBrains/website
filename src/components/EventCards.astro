---
import type { CommunityEvent } from '../data/events';
import { cities, defaultCityImage } from '../data/cities';
const { items, emptyText = 'Nuk ka ende evente të publikuara.' } = Astro.props as { items: CommunityEvent[]; emptyText?: string };
const sorted = [...items].sort((a,b) => new Date(a.start).getTime() - new Date(b.start).getTime());
const date = new Intl.DateTimeFormat('sq-AL', { day:'numeric', month:'long', year:'numeric' });
const time = new Intl.DateTimeFormat('sq-AL', { hour:'2-digit', minute:'2-digit' });
const cityFor = (slug:string) => cities.find(city => city.slug === slug);
---
{sorted.length ? <div class="native-event-grid">
  {sorted.map(event => {
    const city = cityFor(event.citySlug);
    const start = new Date(event.start);
    return <article class="native-event-card">
      <img src={encodeURI(event.image || city?.image || defaultCityImage)} alt="" loading="lazy" />
      <div class="native-event-copy">
        <div class="native-event-meta"><span>{event.category || 'Event'}</span><time datetime={event.start}>{date.format(start)} · {time.format(start)}</time></div>
        <h3>{event.title}</h3>
        <p class="native-event-location">{event.location}{city ? ` · ${city.city}` : ''}</p>
        {event.description && <p>{event.description}</p>}
        <div class="native-event-actions">
          {city && <a href={`/qytetet/${city.slug}/`}>Shiko qytetin</a>}
          {event.registrationUrl && <a class="partner-button" href={event.registrationUrl} target="_blank" rel="noreferrer">Regjistrohu <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </article>;
  })}
</div> : <div class="native-event-empty"><span aria-hidden="true">◇</span><p>{emptyText}</p></div>}

<style>
  .native-event-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-top:40px}.native-event-card{overflow:hidden;border:1px solid var(--line);border-radius:14px;background:#fff;color:var(--ink)}.native-event-card>img{width:100%;height:210px;object-fit:cover}.native-event-copy{padding:24px}.native-event-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;color:var(--accent);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.native-event-meta time{color:var(--muted)}.native-event-card h3{margin:22px 0 8px;font-size:25px;line-height:1.25}.native-event-card p{color:var(--muted);font-size:16px;line-height:1.7}.native-event-card .native-event-location{color:var(--ink);font-weight:600}.native-event-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:24px;padding-top:18px;border-top:1px solid var(--line);font-size:14px;font-weight:700}.native-event-actions .partner-button{margin:0}.native-event-empty{display:flex;align-items:center;gap:15px;margin-top:36px;padding:28px;border:1px dashed #ffffff45;border-radius:12px;background:#ffffff0a}.native-event-empty span{color:#c9aebd;font-size:25px}.native-event-empty p{margin:0;color:#ffffffc7;font-size:17px}
</style>
