---
import { cities } from '../data/cities';
import { directoryMembers as members } from '../data/members';

const pages = [
  { title: 'Ballina', type: 'Faqe', url: '/', keywords: 'illyrian brains rrjeti komuniteti' },
  { title: 'Rrjeti', type: 'Faqe', url: '/qytetet/', keywords: 'qytetet anetaret shoqatat partneret bizneset' },
  { title: 'OJF Partnere', type: 'Faqe', url: '/shoqatat/', keywords: 'OJF Partnere bashkepunetore' },
  { title: 'Bizneset', type: 'Faqe', url: '/bizneset/', keywords: 'biznese diaspora' },
  { title: 'Eventet', type: 'Faqe', url: '/eventet/', keywords: 'kalendari takime aktivitete' },
  { title: 'Misioni', type: 'Rreth nesh', url: '/misioni/', keywords: 'vizioni vlerat organizata' },
  { title: 'Ekipet', type: 'Rreth nesh', url: '/ekipet/', keywords: 'bordi staff qytetet nismat ekipet' },
  { title: 'Statuti', type: 'Rreth nesh', url: '/statuti/', keywords: 'rregullat asambleja bordi anetaresia' },
  { title: 'Transparenca', type: 'Rreth nesh', url: '/dhuro/#transparenca', keywords: 'financimi kostot vetorganizim fonde' },
  { title: 'Dhuro', type: 'Faqe', url: '/dhuro/', keywords: 'donacion dhuro mbeshtet fond transparenca projekte ide' },
  { title: 'Bashkohu', type: 'Faqe', url: '/anetaresohu/', keywords: 'anetaresohu anetaresim kuota asambleja organizo qytet' },
  { title: 'Regjistrohu', type: 'Faqe', url: '/anetaresohu/regjistrohu/', keywords: 'regjistrohu regjistrim apliko anetaresohu linkedin' },
  { title: 'Profili yt', type: 'Faqe', url: '/anetaresohu/profili/', keywords: 'hyr login kycu profili edito perditeso anetar' },
  { title: 'Postimet', type: 'Faqe', url: '/rrjeti/postimet/', keywords: 'postime postim shkruaj ide kerkese kerkesat mundesi propozim ndihme feed aktiviteti anetar' },
  { title: 'Rrjeti im', type: 'Faqe', url: '/anetaresohu/rrjeti/', keywords: 'rrjeti im lidhje lidhjet ndiq ndjek ndjekes qyteti fusha profesioni sugjerime njerez anetar' },
  { title: 'Roli në rrjet', type: 'Faqe', url: '/anetaresohu/roli/', keywords: 'anetaresia ekipet roli organizator kontribues mbeshtetes kuota' },
  { title: 'Përfaqësimi', type: 'Faqe', url: '/anetaresohu/perfaqesimi/', keywords: 'perfaqesues shoqata ojf organizate biznes kompani startup shto menaxho' },
  { title: 'Atlas', type: 'Laboratori', url: 'https://atlas.illyrianbrains.org/', keywords: 'guida shtete diaspora', external: true },
  { title: 'Heritage', type: 'Laboratori', url: 'https://heritage.illyrianbrains.org/', keywords: 'trashegimi kulture', external: true },
  { title: 'Mentoring', type: 'Laboratori', url: 'https://mentoring.illyrianbrains.org/', keywords: 'mentor karriere zhvillim', external: true },
  { title: 'Playground', type: 'Laboratori', url: '/projektet/playground/', keywords: 'lojera komuniteti' },
  { title: 'Global', type: 'Faqe', url: 'https://global.illyrianbrains.org/', keywords: 'konferenca asambleja ib global', external: true },
];
const searchIndex = [
  ...cities.map(city => ({ title: city.city, type: 'Qytet', url: `/qytetet/${city.slug}/`, keywords: city.country, priority: 0 })),
  ...members.map(member => ({ title: member.name, type: 'Anëtar', url: member.profileUrl, keywords: `${member.username} ${member.title || ''} ${member.company || ''} ${(member.specialty || []).join(' ')} ${member.bio || ''} ${(member.fieldsOfExpertise || []).join(' ')} ${member.city || ''} ${member.country || ''} ${(member.team || []).join(' ')} ${member.membershipType || ''}`, priority: 1, member: { username: member.username, city: member.city || '', country: member.country || '', expertise: member.fieldsOfExpertise || [], specialty: member.specialty || [], groups: member.groups, since: member.since, avatar: member.avatar || '', profileUrl: member.profileUrl, bio: member.bio || '', title: member.title || '', company: member.company || '', website: member.website || '', linkedinUrl: member.linkedinUrl || '' } })),
  ...pages.map(page => ({ ...page, priority: 2 })),
];
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Ballina e Illyrian Brains">
    <img src="/assets/logo.png" alt="Illyrian Brains network" />
  </a>
  <button class="nav-toggle" type="button" aria-label="Hap menynë" aria-expanded="false" aria-controls="site-nav">
    <span></span><span></span><span></span>
  </button>
  <nav class="nav" id="site-nav" aria-label="Navigimi kryesor">
    <div class="nav-item dropdown">
      <button class="dropdown-toggle" type="button" aria-expanded="false" aria-controls="rrjeti-menu">
        Rrjeti<span class="nav-caret" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span>
      </button>
      <ul class="dropdown-menu" id="rrjeti-menu">
        <li><a href="/qytetet/">Qytetet</a></li>
        <li><a href="/anetaret/">Anëtarët</a></li>
        <li><a href="/shoqatat/">Shoqatat</a></li>
        <li><a href="/bizneset/">Bizneset</a></li>
        <li><a href="/rrjeti/postimet/">Postimet</a></li>
      </ul>
    </div>
    <a href="/eventet/">Eventet</a>
    <div class="nav-item dropdown">
      <button class="dropdown-toggle" type="button" aria-expanded="false" aria-controls="projektet-menu">
        Laboratori<span class="nav-caret" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span>
      </button>
      <ul class="dropdown-menu" id="projektet-menu">
        <li><a href="https://atlas.illyrianbrains.org/" target="_blank" rel="noreferrer">Atlas ↗</a></li>
        <li><a href="https://heritage.illyrianbrains.org/" target="_blank" rel="noreferrer">Heritage ↗</a></li>
        <li><a href="https://mentoring.illyrianbrains.org/" target="_blank" rel="noreferrer">Mentoring ↗</a></li>
        <li class="dropdown-divider" role="separator"></li>
        <li><a href="/projektet/playground/">Playground</a></li>
      </ul>
    </div>
    <div class="nav-item dropdown">
      <button class="dropdown-toggle" type="button" aria-expanded="false" aria-controls="rreth-nesh-menu">
        Rreth Nesh<span class="nav-caret" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span>
      </button>
      <ul class="dropdown-menu" id="rreth-nesh-menu">
        <li><a href="/misioni/">Misioni</a></li>
        <li><a href="/ekipet/">Ekipet</a></li>
        <li><a href="/statuti/">Statuti</a></li>
        <li><a href="/dhuro/#transparenca">Transparenca</a></li>
      </ul>
    </div>
    <div class="nav-meta">
      <div class="social-links" aria-label="Rrjetet sociale">
        <a class="social-link" href="https://www.linkedin.com/company/illyrian-brains/" target="_blank" rel="noreferrer" aria-label="Illyrian Brains në LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.5H3.2V19h3.3V8.5ZM4.85 3.2a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM19.8 13.1c0-3.2-1.7-4.9-4.1-4.9-1.9 0-2.75 1.05-3.23 1.78V8.5H9.2V19h3.27v-5.2c0-1.37.26-2.7 1.96-2.7 1.68 0 1.7 1.57 1.7 2.8V19h3.27l.4-5.9Z"/></svg>
        </a>
        <a class="social-link" href="https://www.instagram.com/illyrianbrains/" target="_blank" rel="noreferrer" aria-label="Illyrian Brains në Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle class="instagram-dot" cx="17.4" cy="6.8" r="1"/></svg>
        </a>
      </div>
      <button class="site-search-open" type="button" aria-label="Kërko në faqe" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"/><path d="m16 16 4.3 4.3"/></svg>
      </button>
    </div>
    <a class="nav-cta nav-cta-secondary" href="/dhuro/">Dhuro</a>
    <a class="nav-cta" href="/anetaresohu/">Bashkohu</a>
    <!-- Inline so it runs before the first paint: signed-in members see "Llogaria" straight away. -->
    <script is:inline>try { if (Object.keys(localStorage).some(key => /^sb-.+-auth-token$/.test(key))) { const a = document.currentScript.previousElementSibling; a.href = '/anetaresohu/rrjeti/'; a.textContent = 'Llogaria'; } } catch {}</script>
  </nav>
</header>
<!-- Shown by the script below only on the member pages, when a member is signed in. -->
<!-- Sticky workspace bar for the member pages. -->
<nav class="member-subnav" aria-label="Llogaria ime" hidden>
  <div class="member-subnav-head">
    <a href="/qytetet/" class="member-subnav-logo" aria-label="Rrjeti"><span aria-hidden="true"><i></i><i></i><i></i></span></a>
    <div><strong>Llogaria ime</strong></div>
  </div>
  <label class="member-subnav-select">
    <span>Faqja</span>
    <select aria-label="Zgjidh faqen e llogarisë">
      <option value="/anetaresohu/rrjeti/">Rrjeti im</option>
      <option value="/anetaresohu/roli/">Roli në rrjet</option>
      <option value="/anetaresohu/perfaqesimi/">Përfaqësimi</option>
      <option value="/anetaresohu/profili/">Profili im</option>
      <option value="/anetaresohu/admin/" data-admin-nav hidden>Paneli i bordit</option>
    </select>
  </label>
  <div class="member-subnav-tabs">
    <a href="/anetaresohu/rrjeti/"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2.6"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><path d="M6.6 7.3 10 10.3M17.4 7.3 14 10.3M6.6 16.7l3.4-3M17.4 16.7l-3.4-3"/></svg><span>Rrjeti im</span></a>
    <a href="/anetaresohu/roli/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg><span>Roli në rrjet</span></a>
    <a href="/anetaresohu/perfaqesimi/"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3.5 19c.4-3.8 2.2-5.7 5.5-5.7s5.1 1.9 5.5 5.7M15 7h6m-3-3v6M16 14h5m-5 4h5"/></svg><span>Përfaqësimi</span></a>
    <a href="/anetaresohu/admin/" data-admin-nav hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10h6v10M14 20V4h6v16M2 20h20"/></svg><span>Paneli i bordit</span></a>
  </div>
  <div class="member-subnav-actions">
    <a class="member-subnav-profile" href="/anetaresohu/profili/" title="Profili im"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c.5-4.2 3-6.3 7-6.3s6.5 2.1 7 6.3"/></svg><b>Profili im</b></a>
    <button class="member-subnav-signout" type="button" title="Dil nga llogaria"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h5v16h-5M10 8l-4 4 4 4M6 12h10"/></svg><b>Dil</b></button>
  </div>
</nav>

<div class="site-search-overlay" id="site-search-overlay" hidden>
  <section class="site-search-dialog" role="dialog" aria-modal="true" aria-labelledby="site-search-title">
    <div class="site-search-top">
      <div><p class="site-search-kicker">Kërko në Illyrian Brains</p><h2 id="site-search-title">Çfarë po kërkon?</h2></div>
      <button class="site-search-close" type="button" aria-label="Mbyll kërkimin">✕</button>
    </div>
    <div class="site-search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"/><path d="m16 16 4.3 4.3"/></svg><input id="site-search-input" type="search" placeholder="Kërko faqe, qytet, projekt ose person…" autocomplete="off"/></div>
    <p class="site-search-status" id="site-search-status">Shkruaj të paktën dy shkronja për të filluar.</p>
    <div class="site-search-results" id="site-search-results"></div>
  </section>
</div>
<script type="application/json" id="site-search-data" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')}></script>

<script>
  // Signed-in members: supabase-js keeps the magic-link session in
  // localStorage as sb-<project>-auth-token, so no library is needed to
  // tell whether someone is signed in. "Bashkohu" becomes "Llogaria" (to Rrjeti im) in the inline script next to it,
  // and the member sub navbar shows only on the member pages (rrjeti, profili,
  // roli and përfaqësimi), including redirects from the former organization editors.
  const subnav = document.querySelector<HTMLElement>('.member-subnav');
  try {
    const tokenKey = Object.keys(localStorage).find(key => /^sb-.+-auth-token$/.test(key));
    if (subnav && tokenKey && /^\/anetaresohu\/(rrjeti|profili|roli|perfaqesimi|shoqatat|bizneset|admin)\/?$/.test(location.pathname)) {
      subnav.hidden = false;
    }
  } catch {}
  // Signing out = forgetting the stored session (what supabase-js does
  // locally), so this works on pages that don't load the library. The key is
  // looked up on click: right after a magic-link sign-in it didn't exist yet
  // when this script ran.
  subnav?.querySelector('.member-subnav-signout')!.addEventListener('click', () => {
    try { Object.keys(localStorage).filter(key => /^sb-.+-auth-token$/.test(key)).forEach(key => localStorage.removeItem(key)); } catch {}
    location.href = '/anetaresohu/profili/';
  });
  const representativePath = /^\/anetaresohu\/(shoqatat|bizneset)\/?$/.test(location.pathname) ? '/anetaresohu/perfaqesimi/' : location.pathname;
  subnav?.querySelectorAll<HTMLAnchorElement>('.member-subnav-tabs a, .member-subnav-profile').forEach(link => { if (link.pathname === representativePath) link.setAttribute('aria-current', 'page'); });
  const subnavSelect = subnav?.querySelector<HTMLSelectElement>('.member-subnav-select select');
  if (subnavSelect) {
    const current = [...subnavSelect.options].find(option => option.value === representativePath || option.value === `${representativePath}/`);
    if (current) subnavSelect.value = current.value;
    subnavSelect.addEventListener('change', () => { location.href = subnavSelect.value; });
  }

  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('.nav');
  const dropdowns = document.querySelectorAll<HTMLElement>('.nav-item.dropdown');
  const searchOpen = document.querySelector<HTMLButtonElement>('.site-search-open');
  const searchOverlay = document.querySelector<HTMLElement>('#site-search-overlay');
  const searchClose = document.querySelector<HTMLButtonElement>('.site-search-close');
  const searchInput = document.querySelector<HTMLInputElement>('#site-search-input');
  const searchResults = document.querySelector<HTMLElement>('#site-search-results');
  const searchStatus = document.querySelector<HTMLElement>('#site-search-status');
  const searchData = JSON.parse(document.querySelector('#site-search-data')?.textContent || '[]');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('nav-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    // Lock background scroll while the mobile menu is open — otherwise the page
    // behind it scrolls (the menu doesn't cover the full viewport), which looks
    // broken and lets you scroll the hero content underneath the open menu.
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  const closeDropdowns = (except?: HTMLElement) => {
    dropdowns.forEach((dropdown) => {
      if (dropdown === except) return;
      dropdown.classList.remove('open');
      dropdown.querySelector<HTMLButtonElement>('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
    });
  };

  dropdowns.forEach((dropdown) => {
    const dropdownToggle = dropdown.querySelector<HTMLButtonElement>('.dropdown-toggle');
    dropdownToggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = dropdown.classList.toggle('open');
      dropdownToggle.setAttribute('aria-expanded', String(isOpen));
      closeDropdowns(dropdown);
    });
  });

  document.addEventListener('click', () => closeDropdowns());

  const normalize = (value:string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('sq');
  const escapeHtml = (value:string) => value.replace(/[&<>"']/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character] || character));
  const closeSearch = () => { if (!searchOverlay) return; searchOverlay.hidden = true; document.body.style.overflow = ''; searchOpen?.focus(); };
  const openSearch = () => { if (!searchOverlay) return; searchOverlay.hidden = false; nav?.classList.remove('nav-open'); toggle?.setAttribute('aria-expanded','false'); document.body.style.overflow = 'hidden'; requestAnimationFrame(() => searchInput?.focus()); };
  const renderSearch = () => {
    if (!searchResults || !searchStatus) return;
    const query = normalize(searchInput?.value.trim() || '');
    if (query.length < 2) { searchResults.innerHTML = ''; searchStatus.textContent = 'Shkruaj të paktën dy shkronja për të filluar.'; return; }
    const terms = query.split(/\s+/).filter(Boolean);
    const matches = searchData.map((item:any) => { const text=normalize(`${item.title} ${item.type} ${item.keywords||''}`); const score=terms.reduce((sum:number,term:string)=>sum+(normalize(item.title).startsWith(term)?4:text.includes(term)?1:-20),0); return {...item,score}; }).filter((item:any)=>item.score>=terms.length).sort((a:any,b:any)=>(a.priority??2)-(b.priority??2)||b.score-a.score||a.title.localeCompare(b.title,'sq')).slice(0,16);
    searchStatus.textContent = matches.length ? `${matches.length} rezultate` : 'Nuk u gjet asnjë rezultat. Provo një fjalë tjetër.';
    searchResults.innerHTML = matches.map((item:any,index:number) => item.member
      ? `<button class="site-search-result site-search-person" type="button" data-result-index="${index}"><span><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.type)}${item.member.city ? ` · ${escapeHtml(item.member.city)}` : ''}</small></span><b aria-hidden="true">→</b></button>`
      : `<a class="site-search-result" href="${encodeURI(item.url)}"${item.external?' target="_blank" rel="noreferrer"':''}><span><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.type)}</small></span><b aria-hidden="true">↗</b></a>`).join('');
    searchResults.querySelectorAll<HTMLButtonElement>('[data-result-index]').forEach(button => button.addEventListener('click', () => {
      const item = matches[Number(button.dataset.resultIndex)];
      if (!item?.member) return;
      const member = item.member;
      const initials = item.title.split(' ').map((part:string) => part[0]).join('').slice(0,2).toUpperCase();
      searchResults.innerHTML = `<article class="site-search-profile"><button class="site-search-profile-back" type="button">← Kthehu te rezultatet</button><div class="site-search-profile-head">${member.avatar ? `<img src="${escapeHtml(member.avatar)}" alt="">` : `<span>${escapeHtml(initials)}</span>`}<div><small>Anëtar i komunitetit</small><h3>${escapeHtml(item.title)}</h3><p>${member.title ? escapeHtml(member.title) : `@${escapeHtml(member.username)}`}</p></div></div>${member.bio ? `<p class="site-search-profile-bio">${escapeHtml(member.bio)}</p>` : ''}<div class="site-search-profile-meta">${member.expertise.map((value:string) => `<span>${escapeHtml(value)}</span>`).join('')}${member.specialty.map((value:string) => `<span class="specialty">${escapeHtml(value)}</span>`).join('')}${member.city ? `<span class="location">${escapeHtml(member.city)}${member.country ? `, ${escapeHtml(member.country)}` : ''}</span>` : ''}</div><div class="site-search-profile-actions">${member.website ? `<a class="partner-button" href="${encodeURI(member.website)}" target="_blank" rel="noreferrer">Faqja personale <span aria-hidden="true">↗</span></a>` : ''}${member.linkedinUrl ? `<a class="partner-button" href="${encodeURI(member.linkedinUrl)}" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>` : ''}${member.profileUrl ? `<a class="partner-button" href="${encodeURI(member.profileUrl)}" target="_blank" rel="noreferrer">Profili në forum <span aria-hidden="true">↗</span></a>` : ''}</div></article>`;
      searchStatus.textContent = 'Profili i anëtarit';
      searchResults.querySelector<HTMLButtonElement>('.site-search-profile-back')?.addEventListener('click', renderSearch);
    }));
  };
  searchOpen?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);
  searchOverlay?.addEventListener('click', event => { if (event.target === searchOverlay) closeSearch(); });
  searchInput?.addEventListener('input', renderSearch);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeDropdowns();
      if (!searchOverlay?.hidden) closeSearch();
      if (nav?.classList.contains('nav-open')) { nav.classList.remove('nav-open'); toggle?.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; }
    }
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); openSearch(); }
  });
</script>
