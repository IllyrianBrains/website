---
import '../styles/directory.css';
import DirectoryNetworkGraph from './DirectoryNetworkGraph.astro';
import SectionTitle from './SectionTitle.astro';
import RrjetiSection from './RrjetiSection.astro';
import { mailto, emailTemplates } from '../data/emails';
import { businesses, businessCategoryLabels, businessStageLabels, contributionTypeOptions } from '../data/businesses';
import { offers } from '../data/offers';
import { cities } from '../data/cities';
import { members } from '../data/members';

const categories = Object.entries(businessCategoryLabels).map(([id, label]) => ({ id, label }));
const stages = Object.entries(businessStageLabels).map(([id, label]) => ({ id, label }));
const memberByUsername = new Map(members.map(member => [member.username, member]));
const graphBusinesses = businesses.map((business, index) => ({
  id: `business-${index}`,
  label: business.name,
  category: business.category,
  categories: business.categories,
  cities: [...new Set([business.city, ...business.relatedCities].filter((city): city is string => Boolean(city)))],
  people: business.relatedMembers.map(username => ({ username, name: memberByUsername.get(username)?.name || `@${username}` })),
  url: business.website || business.linkedin || business.instagram,
}));
const businessCities = [...new Set(businesses.flatMap(business => [business.city, ...business.relatedCities]).filter((city): city is string => Boolean(city)))].sort((a, b) => a.localeCompare(b, 'sq'));
// Always show the standard contribution forms, even ones no business has yet —
// plus any other offer type found in offers.csv that isn't one of the standard ones.
const contributionTypes = [...new Set([...contributionTypeOptions, ...businesses.flatMap(business => business.contributionTypes)])];

// Businesses record city as free text (from hand-entered data), which doesn't always
// match the name used in cities.csv — e.g. an English exonym ("Rome") vs. the local
// spelling ("Roma"). Normalize and alias known cases so they land on the right marker
// instead of being silently dropped. (Mirrors the matching in harta.astro.)
const normalize = (value: string) => value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
const cityAliases: Record<string, string> = {
  florence: 'firenze', genoa: 'genova', milan: 'milano', rome: 'roma',
  nuremberg: 'nurnberg', 'city of london': 'london', 'greater london': 'london',
};
const cityByKey = new Map<string, (typeof cities)[number]>();
for (const city of cities) {
  const keys = new Set([normalize(city.slug), ...city.city.split('/').map(part => normalize(part))]);
  keys.forEach(key => cityByKey.set(key, city));
}
function matchCity(name?: string) {
  if (!name) return undefined;
  const key = normalize(name);
  return cityByKey.get(cityAliases[key] ?? key);
}

const businessesByCity = new Map<string, { name: string; website?: string }[]>();
let unmappedBusinesses = 0;
for (const business of businesses) {
  const relatedCityNames = [...new Set([business.city, ...business.relatedCities].filter((name): name is string => Boolean(name)))];
  let mapped = false;
  for (const cityName of relatedCityNames) {
    const city = matchCity(cityName);
    if (!city) continue;
    mapped = true;
    const list = businessesByCity.get(city.slug) ?? [];
    if (!list.some(item => item.name === business.name)) list.push({ name: business.name, website: business.website || business.linkedin || business.instagram });
    businessesByCity.set(city.slug, list);
  }
  if (!mapped) unmappedBusinesses++;
}
const businessMapCities = cities
  .map(city => ({ city: city.city, country: city.country, lat: city.lat, lng: city.lng, slug: city.slug, businesses: businessesByCity.get(city.slug) ?? [] }))
  .filter(city => city.businesses.length > 0);
---
<RrjetiSection eyebrow="Ekosistemi i biznesit" title="Bizneset e rrjetit." description="Bizneset e anëtarëve dhe të miqve të rrjetit, me oferta, mundësi pune dhe bashkëpunime për komunitetin." stats={[{ value: businesses.length, label: 'Biznese' }, { value: businessCities.length, label: 'Qytete' }, { value: offers.length, label: 'Oferta & kuponë' }]} filtersLabel="Filtro katalogun e bizneseve">
    <a slot="actions" href={mailto(emailTemplates.partnerBusiness)}>Prezanto biznesin <span aria-hidden="true">→</span></a>
      <div slot="filters" class="directory-filters member-filters">
        <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="business-search" type="search" placeholder="Kërko biznes…" aria-label="Kërko biznes"/></div>
        <select id="business-category" aria-label="Filtro sipas llojit të biznesit"><option value="">Të gjitha llojet</option>{categories.map(category => <option value={category.id}>{category.label}</option>)}</select>
        <select id="business-stage" aria-label="Filtro sipas fazës"><option value="">Të gjitha fazat</option>{stages.map(stage => <option value={stage.id}>{stage.label}</option>)}</select>
        <select id="business-city" aria-label="Filtro sipas qytetit"><option value="">Të gjithë qytetet</option>{businessCities.map(city => <option value={city}>{city}</option>)}</select>
      </div>
      {contributionTypes.length > 0 && (
        <div slot="filters" class="contribution-filter" aria-label="Filtro sipas llojit të kontributit">
          <span class="eyebrow">Lloji i kontributit</span>
          <div class="contribution-filter-options">
            {contributionTypes.map(type => <button type="button" class="contribution-chip" data-contribution-type={type} aria-pressed="false">{type}</button>)}
          </div>
        </div>
      )}
      <Fragment slot="results">
        <p class="directory-result-count" id="business-result-count"></p>
        <div class="business-directory-grid">
          {businesses.map(business => {
            const businessOffers = offers.filter(offer => offer.business === business.name);
            return (
            <article class="business-directory-card" data-categories={business.categories.join('|')} data-stage={business.stage} data-cities={[business.city, ...business.relatedCities].filter(Boolean).join('|')} data-contribution-types={business.contributionTypes.join('|')} data-search={`${business.name} ${business.description} ${business.city || ''} ${business.relatedCities.join(' ')} ${business.relatedMembers.join(' ')} ${business.country || ''}`.toLocaleLowerCase('sq')}>
              {(business.city || business.logo) && (
                <div class="business-card-top">
                  {business.city && <span class="business-city">{business.city}{business.country ? `, ${business.country}` : ''}</span>}
                  {business.logo && <img class="business-logo" src={business.logo} alt={`Logoja e ${business.name}`} loading="lazy" />}
                </div>
              )}
              <h3>{business.name}</h3>
              <p>{business.description}</p>
              {(business.website || business.linkedin || business.instagram) && <div class="business-links">
                {business.website && <a href={business.website} target="_blank" rel="noreferrer">Faqja zyrtare <span aria-hidden="true">↗</span></a>}
                {business.linkedin && <a href={business.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
                {business.instagram && <a href={business.instagram} target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>}
              </div>}
              {businessOffers.length > 0 && (
                <details class="business-offer-dropdown">
                  <summary>Oferta & kuponë <span aria-hidden="true">▾</span></summary>
                  <ul>
                    {businessOffers.map(offer => (
                      <li>
                        <strong>{offer.title}</strong>
                        <span class="offer-type">{offer.type}</span>
                        <span>{offer.audience}</span>
                        <span>{offer.validUntil ? `Deri më ${offer.validUntil}` : 'Pa afat'}</span>
                        {offer.url && <a href={offer.url} target="_blank" rel="noreferrer" aria-label={`Hap ofertën: ${offer.title}`}>Hap <span aria-hidden="true">↗</span></a>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              {business.sponsor && <span class="sponsor-star" role="img" aria-label="Sponsor" title="Sponsor">★</span>}
            </article>
            );
          })}
        </div>
        <p class="directory-empty" id="business-empty" hidden>Asnjë biznes nuk përputhet me filtrat.</p>
      </Fragment>


    <section class="section tone-grey"><div class="container">
      <div class="business-network">
        <DirectoryNetworkGraph kind="business" title="Bizneset në ekosistem." description="Eksploro si bizneset e komunitetit lidhen me anëtarët dhe kategoritë e zhvillimit profesional." categories={categories} items={graphBusinesses} />
      </div>
    </div></section>

    <section class="section tone-white"><div class="container">
      <div class="businesses-community-map-heading">
        <div><p class="eyebrow">Ku ndodhen</p><h2>Bizneset në hartë.</h2></div>
        <p>Bizneset e rrjetit, sipas qytetit ku janë të vendosura.</p>
      </div>
      <div class="businesses-community-map-layout">
        <div id="businesses-community-map" data-cities={JSON.stringify(businessMapCities)} aria-label="Harta e bizneseve të Illyrian Brains, sipas qytetit"></div>
      </div>
      {unmappedBusinesses > 0 && (
        <p class="map-footnote">{unmappedBusinesses} biznes{unmappedBusinesses === 1 ? '' : 'e'} nuk k{unmappedBusinesses === 1 ? 'a' : 'anë'} qytet të specifikuar dhe nuk shfaqet në hartë.</p>
      )}
    </div></section>
    <section class="section tone-grey" id="bashkepuno"><div class="container">
      <SectionTitle kicker="Bashkëpuno si biznes" title="Bëhu pjesë e ekosistemit." text="Publiko oferta, krijo mundësi ose mbështet rrjetin si sponsor. Na dërgo profilin e biznesit dhe përshkruaj ofertën ose kontributin." />
      <div class="focus-card collab-note">
        <h3>Bashkëpunime të mundshme</h3>
        <ul>
          <li><strong>Ofertë ose kupon</strong> — përfitime për anëtarët e rrjetit.</li>
          <li><strong>Sponsorizim</strong> — mbështetje për një event ose për rrjetin.</li>
          <li><strong>Donacion</strong> — për një fond ose projekt të caktuar.</li>
          <li><strong>Mundësi pune</strong> — pozicione ose praktika për anëtarët.</li>
          <li><strong>Ekspertizë</strong> — një prezantim ose workshop në një event qyteti.</li>
        </ul>
      </div>
      <a class="partner-button" href={mailto(emailTemplates.partnerBusiness)}>Prezanto biznesin <span aria-hidden="true">→</span></a>
    </div></section>
</RrjetiSection>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  const businessMapElement = document.querySelector('#businesses-community-map');
  if (businessMapElement && window.L) {
    const cityData = JSON.parse(businessMapElement.dataset.cities || '[]');
    const map = L.map(businessMapElement, { scrollWheelZoom: true, doubleClickZoom: true, touchZoom: true, zoomControl: true }).setView([44, 8], 3);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    const popupHtml = (city) => {
      const orgList = `<ul class="map-popup-orgs">${city.businesses.map((b) => `<li>${b.website ? `<a href="${b.website}" target="_blank" rel="noreferrer">${b.name}</a>` : b.name}</li>`).join('')}</ul>`;
      return `<div class="map-popup"><strong>${city.city}</strong><span>${city.country}</span><small>${city.businesses.length} biznes${city.businesses.length === 1 ? '' : 'e'}</small>${orgList}<a class="map-popup-link" href="/qytetet/${city.slug}/">Shiko qytetin ↗</a></div>`;
    };
    const markers = cityData.map((city) => L.circleMarker([city.lat, city.lng], {
      radius: Math.min(22, 8 + Math.sqrt(city.businesses.length) * 4), color: '#fff', weight: 2, opacity: .9, fillColor: '#293f52', fillOpacity: .85
    })
      .bindTooltip(`<div class="map-city-tooltip"><strong>${city.city}</strong><span>${city.businesses.length} biznes${city.businesses.length === 1 ? '' : 'e'}</span></div>`, { direction: 'top', offset: [0, -10], opacity: .96 })
      .bindPopup(popupHtml(city))
      .addTo(map));
    if (markers.length) map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [40, 40] });
  }
</script>
<style>
  .collab-note{max-width:760px;margin-top:28px}.collab-note strong{color:var(--ink);font-weight:700}
  .businesses-community-map-heading h2 { font-size: clamp(38px, 5vw, 58px); }
  .map-footnote { max-width: 68ch; margin-top: 18px; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .map-popup-orgs { display: flex; flex-direction: column; gap: 4px; margin: 8px 0 0; padding: 8px 0 0; border-top: 1px solid var(--line); list-style: none; }
  .map-popup-orgs li { font-size: 12px; }
  .map-popup-orgs a { color: var(--accent-dark); font-weight: 700; }
</style>
<script>
  const search=document.querySelector<HTMLInputElement>('#business-search'),category=document.querySelector<HTMLSelectElement>('#business-category'),stage=document.querySelector<HTMLSelectElement>('#business-stage'),city=document.querySelector<HTMLSelectElement>('#business-city'),contributionChips=[...document.querySelectorAll<HTMLButtonElement>('.contribution-chip')],count=document.querySelector<HTMLElement>('#business-result-count'),empty=document.querySelector<HTMLElement>('#business-empty'),cards=[...document.querySelectorAll<HTMLElement>('.business-directory-card')];
  const selectedContributions=new Set<string>();
  const filterBusinesses=()=>{const query=(search?.value||'').trim().toLocaleLowerCase('sq'),selectedCategory=category?.value||'',selectedStage=stage?.value||'',selectedCity=city?.value||'';let visible=0;cards.forEach(card=>{const cardTypes=(card.dataset.contributionTypes||'').split('|').filter(Boolean),cardCities=(card.dataset.cities||'').split('|').filter(Boolean);const show=(!query||(card.dataset.search||'').includes(query))&&(!selectedCategory||(card.dataset.categories||'').split('|').includes(selectedCategory))&&(!selectedStage||card.dataset.stage===selectedStage)&&(!selectedCity||cardCities.includes(selectedCity))&&(selectedContributions.size===0||cardTypes.some(type=>selectedContributions.has(type)));card.hidden=!show;if(show)visible++});if(count)count.textContent=`${visible} ${visible===1?'biznes u gjet':'biznese u gjetën'}`;if(empty)empty.hidden=visible>0};
  search?.addEventListener('input',filterBusinesses);category?.addEventListener('change',filterBusinesses);stage?.addEventListener('change',filterBusinesses);city?.addEventListener('change',filterBusinesses);
  contributionChips.forEach(chip=>chip.addEventListener('click',()=>{const type=chip.dataset.contributionType||'';if(selectedContributions.has(type))selectedContributions.delete(type);else selectedContributions.add(type);chip.classList.toggle('is-active',selectedContributions.has(type));chip.setAttribute('aria-pressed',String(selectedContributions.has(type)));filterBusinesses()}));
  filterBusinesses();
</script>
<style>
  .business-collaboration-card{border:1px solid rgba(255,255,255,.1)!important;background:linear-gradient(145deg,var(--business-card-start),var(--business-card-end))!important}.business-card-plum{--business-card-start:#80566f;--business-card-end:#5a394d}.business-card-blue{--business-card-start:#486f7e;--business-card-end:#294b5a}.business-card-ochre{--business-card-start:#b06f58;--business-card-end:#854938}.business-collaboration-card::after{border-color:rgba(255,255,255,.2)!important;box-shadow:0 0 70px rgba(255,255,255,.06)!important}
  .business-collaboration{padding:96px 0 104px;border-bottom:1px solid var(--line);background:#f7f6f4}.business-collaboration-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,430px);column-gap:70px;align-items:end;margin-bottom:44px}.business-collaboration-heading .eyebrow{grid-column:1/-1;margin-bottom:15px}.business-collaboration-heading h2{max-width:650px;margin:0;font-size:clamp(42px,5.3vw,66px);font-weight:400;line-height:.98;letter-spacing:-.045em}.business-collaboration-heading>p:last-child{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.business-collaboration-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.business-collaboration-card{--business-card:#744761;position:relative;display:flex;min-height:330px;flex-direction:column;justify-content:space-between;overflow:hidden;padding:27px 29px 30px;border-radius:12px;color:#fff;background:var(--business-card);box-shadow:0 14px 35px rgba(23,24,29,.12);transition:transform .22s ease,box-shadow .22s ease}.business-collaboration-card::after{content:'';position:absolute;right:-52px;top:-62px;width:180px;height:180px;border:1px solid rgba(255,255,255,.16);border-radius:50%}.business-collaboration-card:hover{transform:translateY(-5px);box-shadow:0 20px 42px rgba(23,24,29,.18)}.business-card-plum{--business-card:#744761}.business-card-blue{--business-card:#365d70}.business-card-ochre{--business-card:#a56f32}.business-card-number{position:relative;z-index:1;display:grid;width:36px;height:36px;place-items:center;border:1px solid rgba(255,255,255,.45);border-radius:50%;font-size:10px;font-weight:800;letter-spacing:.08em}.business-collaboration-card>div{position:relative;z-index:1}.business-collaboration-card h3{max-width:280px;margin:0 0 13px;font-size:clamp(25px,2.2vw,31px);font-weight:400;line-height:1.05;letter-spacing:-.025em}.business-collaboration-card p{max-width:310px;margin:0;color:rgba(255,255,255,.78);font-size:14px;line-height:1.65}@media(max-width:900px){.business-collaboration-heading{grid-template-columns:1fr;gap:20px}.business-collaboration-grid{grid-template-columns:1fr}.business-collaboration-card{min-height:250px}}@media(max-width:600px){.business-collaboration{padding:72px 0 78px}.business-collaboration-heading{margin-bottom:30px}.business-collaboration-heading h2{font-size:clamp(38px,11vw,48px)}.business-collaboration-heading>p:last-child{font-size:15px}.business-collaboration-card{min-height:235px;padding:24px}.business-collaboration-card h3{font-size:27px}}
  .catalog-heading{display:grid;grid-template-columns:1fr minmax(300px,480px);gap:55px;align-items:end;margin-bottom:34px}.catalog-heading h1{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.05}.catalog-heading>p{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.catalog-heading strong{color:var(--accent-dark)}
  .directory-filters{display:grid;grid-template-columns:minmax(230px,1fr) repeat(3,minmax(165px,220px));margin-bottom:14px;padding:18px;border:1px solid rgba(116,71,97,.2);border-radius:14px;background:var(--soft)}.directory-filters>*{min-width:0}.directory-filters select{width:100%}
  .contribution-filter{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-bottom:18px;padding:14px 18px;border:1px solid var(--line);border-radius:14px;background:#fff}.contribution-filter>.eyebrow{margin:0}.contribution-filter-options{display:flex;flex-wrap:wrap;gap:8px}.contribution-chip{padding:8px 14px;border:1px solid var(--line);border-radius:999px;color:var(--muted);background:#fff;font:700 12px var(--font-body);cursor:pointer;transition:.18s ease}.contribution-chip.is-active{color:#fff;border-color:var(--ink);background:var(--ink)}
  .directory-result-count{margin:0 0 34px;color:var(--muted);font-size:13px}.directory-empty{margin:35px 0;color:var(--muted)}.business-directory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.business-directory-card{position:relative;display:flex;min-height:174px;flex-direction:column;padding:26px 28px;border:1px solid var(--line);border-left:4px solid var(--card-accent,#744761);border-radius:8px;background:var(--card-bg,#fff);box-shadow:0 8px 24px rgba(23,24,29,.04)}.business-directory-card[hidden]{display:none}.business-city{align-self:flex-start;padding:5px 8px;border-radius:4px;color:var(--ink);background:rgba(255,255,255,.72);font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.business-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.business-logo{height:48px;max-width:120px;margin-left:auto;padding:4px;border-radius:6px;background:#fff;object-fit:contain}.business-directory-card h3{margin:14px 0 7px;font-size:20px;font-weight:400;line-height:1.15}.business-directory-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.business-links{display:flex;flex-wrap:wrap;gap:14px;margin-top:auto;padding:14px 34px 0 0}.business-links a{color:var(--accent-dark);font-size:12px;font-weight:700}.business-links a:hover{text-decoration:underline;text-underline-offset:3px}.sponsor-star{position:absolute;right:18px;bottom:16px;color:#b67a16;font-size:21px;line-height:1;text-shadow:0 1px 0 #fff}
  .business-offer-dropdown{margin-top:12px;padding-top:12px;border-top:1px solid rgba(23,24,29,.1)}.business-offer-dropdown summary{color:var(--card-accent,#744761);font-size:12px;font-weight:700;cursor:pointer;list-style:none}.business-offer-dropdown summary::-webkit-details-marker{display:none}.business-offer-dropdown ul{display:flex;flex-direction:column;gap:8px;margin:10px 0 0;padding:0;list-style:none}.business-offer-dropdown li{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:12px}.business-offer-dropdown li strong{width:100%;font-weight:700}.business-offer-dropdown li a{color:var(--accent-dark);font-weight:700}.offer-type{display:inline-block;padding:3px 8px;border-radius:4px;background:var(--soft);font-size:10px;font-weight:700}
  @media(max-width:980px){.business-directory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:1000px){.directory-filters{grid-template-columns:repeat(3,1fr)}.directory-filters .member-search{grid-column:1/-1}}@media(max-width:760px){.catalog-heading,.directory-filters{grid-template-columns:1fr}.catalog-heading{gap:18px}}@media(max-width:700px){.business-directory-grid{grid-template-columns:1fr}.business-directory-card{min-height:160px}}
</style>
