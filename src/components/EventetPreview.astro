---
import SectionTitle from './SectionTitle.astro';
const lumaEmbedUrl = 'https://luma.com/embed/calendar/cal-FWG6Cxwu8MbfxIl/events';
const lumaCalendarUrl = 'https://luma.com/ib-happyhours';
---
<section class="section tone-dark events-intro">
  <div class="container">
    <SectionTitle kicker="IB HappyHours" title="Takohemi rregullisht." text="Happy Hours sjellin komunitetin bashkë, qytet pas qyteti. Gjej takimin më të afërt dhe regjistrohu në kalendarin tonë zyrtar në Luma." />
    <a class="events-luma-link" href={lumaCalendarUrl} target="_blank" rel="noreferrer">Shiko IB HappyHours në Luma <span aria-hidden="true">↗</span></a>
  </div>
</section>

<section class="section tone-white events-calendar-section">
  <div class="container">
    <div class="events-calendar-heading">
      <div>
        <p class="eyebrow">Kalendari IB HappyHours</p>
        <h2>Takimet e ardhshme.</h2>
      </div>
      <p>Kalendari përditësohet drejtpërdrejt nga Luma. Zgjidh një Happy Hour për hollësitë, vendndodhjen dhe regjistrimin.</p>
    </div>
    <div class="luma-embed">
      <iframe src={lumaEmbedUrl} width="600" height="650" frameborder="0" allowfullscreen aria-hidden="false" tabindex="0" loading="lazy" title="Kalendari IB HappyHours në Luma"></iframe>
    </div>
    <a class="partner-button" href={lumaCalendarUrl} target="_blank" rel="noreferrer">Hap kalendarin e plotë në Luma <span aria-hidden="true">↗</span></a>
  </div>
</section>

<section class="section global-feature-section">
  <div class="container">
    <a class="global-feature" href="https://global.illyrianbrains.org/" target="_blank" rel="noreferrer" aria-label="Zbulo IB Global III">
      <div class="global-feature-copy">
        <p class="eyebrow">Eventi kryesor · 2026</p>
        <h2>IB Global III<br />vjen në Tiranë.</h2>
        <p class="global-feature-lead">Tri ditë me ide, bashkëpunim dhe komunitet — një mbrëmje mirëseardhjeje, takime mes anëtarëve dhe një konferencë për çdo fushë.</p>
        <p>IB Global është takimi vjetor që bashkon profesionistë shqiptarë nga qytetet e rrjetit, Shqipëria, Kosova dhe diaspora. Është hapësira ku njohjet bëhen bashkëpunime, ekspertiza ndahet dhe ndërtohet vizioni i përbashkët i komunitetit.</p>
        <span class="global-feature-link">Zbulo IB Global <span aria-hidden="true">↗</span></span>
      </div>
      <div class="global-feature-details">
        <div><span>Kur</span><strong>18–20</strong><p>Shtator 2026</p></div>
        <div><span>Ku</span><strong>Tiranë</strong><p>Shqipëri</p></div>
        <div><span>Formati</span><strong>3 ditë</strong><p>Komunitet · Konferencë · Punëtori</p></div>
      </div>
    </a>
  </div>
</section>

<style>
  .events-intro { padding-block: clamp(88px, 11vw, 140px); }
  .events-intro :global(.section-title) { max-width: 820px; }
  .events-luma-link { display: inline-flex; align-items: center; gap: 18px; margin-top: 28px; padding-bottom: 7px; border-bottom: 1px solid rgba(255,255,255,.45); color: #fff; font-size: 14px; font-weight: 700; }
  .events-luma-link:hover { border-color: #fff; }
  .global-feature-section { padding-block: clamp(55px, 8vw, 100px); color: #fff; background: #15161b; }
  .global-feature { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(230px, .55fr); gap: clamp(45px, 8vw, 100px); align-items: center; min-height: 510px; padding: clamp(34px, 6vw, 72px); border: 1px solid rgba(255,255,255,.13); border-radius: 18px; color: #fff; background: var(--night); transition: border-color .2s ease, transform .2s ease; }
  .global-feature:hover { border-color: rgba(255,255,255,.35); transform: translateY(-2px); }
  .global-feature:focus-visible { outline: 3px solid #c9aebd; outline-offset: 4px; }
  .global-feature-copy { min-width: 0; }
  .global-feature-copy .eyebrow { margin-bottom: 17px; color: #c9aebd; }
  .global-feature-copy h2 { margin: 0; font-size: clamp(43px, 5.5vw, 70px); font-weight: 300; line-height: .96; letter-spacing: -.045em; }
  .global-feature-copy > p:not(.eyebrow) { max-width: 650px; margin: 20px 0 0; color: rgba(255,255,255,.58); font-size: 14px; line-height: 1.75; }
  .global-feature-copy .global-feature-lead { color: rgba(255,255,255,.8); font-size: 17px; line-height: 1.65; }
  .global-feature-link { display: inline-flex; align-items: center; gap: 24px; margin-top: 30px; padding: 13px 18px; border: 1px solid rgba(255,255,255,.55); border-radius: 999px; font-size: 13px; font-weight: 700; transition: color .2s ease, background .2s ease, transform .2s ease; }
  .global-feature-link:hover { color: var(--ink); background: #fff; transform: translateY(-2px); }
  .global-feature-details { position: relative; z-index: 1; border-top: 1px solid rgba(255,255,255,.16); }
  .global-feature-details > div { padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,.16); }
  .global-feature-details span { display: block; margin-bottom: 7px; color: #c9aebd; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .15em; }
  .global-feature-details strong { display: block; font-family: var(--font-display); font-size: clamp(27px, 3vw, 39px); font-weight: 400; line-height: 1; }
  .global-feature-details p { margin: 7px 0 0; color: rgba(255,255,255,.48); font-size: 11px; line-height: 1.5; }
  .events-calendar-heading { display: grid; grid-template-columns: 1fr minmax(280px, 430px); gap: 48px; align-items: end; margin-bottom: 38px; }
  .events-calendar-heading h2 { margin: 0; font-size: clamp(38px, 5vw, 58px); font-weight: 400; line-height: 1.08; }
  .events-calendar-heading > p { margin: 0; color: var(--muted); font-size: 18px; line-height: 1.75; }
  .events-calendar-section .luma-embed { max-width: none; margin: 0; padding: 10px; border: 1px solid var(--line); border-radius: 14px; background: #fff; box-shadow: 0 18px 50px rgba(23,24,29,.06); }
  .events-calendar-section .luma-embed iframe { width: 100%; height: min(720px, 78vh); min-height: 560px; border: 0; border-radius: 8px; background: #fff; }
  @media (max-width: 760px) {
    .global-feature { grid-template-columns: 1fr; min-height: 0; }
    .global-feature-details { display: grid; grid-template-columns: 1fr 1fr; }
    .global-feature-details > div { padding-right: 14px; }
    .global-feature-details > div:last-child { grid-column: 1 / -1; }
    .events-calendar-heading { grid-template-columns: 1fr; gap: 18px; }
    .events-calendar-section .luma-embed { padding: 5px; }
    .events-calendar-section .luma-embed iframe { min-height: 620px; }
  }
</style>
