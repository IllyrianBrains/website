---
import '../styles/directory.css';
import MemberNetworkGraph from './MemberNetworkGraph.astro';
import RrjetiSection from './RrjetiSection.astro';
import SectionTitle from './SectionTitle.astro';
import { directoryMembers as members, cityAliases } from '../data/members';
import { cities } from '../data/cities';
const memberCities = [...new Set(members.map(member => member.city).filter((city):city is string => Boolean(city)))].sort();
const expertiseAreas = [...new Set(members.flatMap(member => member.fieldsOfExpertise || []))].sort((a,b) => a.localeCompare(b,'sq'));
// Publishable key: meant to be public, it can only read public_member_profiles (supabase/002-editing.sql).
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
// Members per city for the map: match the member's city to cities.csv (name or any "A / B" part).
const cityByName = new Map(cities.flatMap(city => [city.city, ...city.city.split('/').map(name => name.trim())].map(name => [name.toLocaleLowerCase('sq'), city])));
const memberCountByCity = new Map<(typeof cities)[number], number>();
let unmappedMembers = 0;
for (const member of members) {
  const city = member.city && cityByName.get(member.city.toLocaleLowerCase('sq'));
  if (city) memberCountByCity.set(city, (memberCountByCity.get(city) || 0) + 1);
  else unmappedMembers++;
}
const memberMapCities = [...memberCountByCity].map(([city, count]) => ({ city: city.city, country: city.country, slug: city.slug, lat: city.lat, lng: city.lng, count }));
const cityLinks = Object.fromEntries(cities.flatMap(city => [city.slug, ...city.city.split('/').map(name => name.trim())].map(name => [name.toLocaleLowerCase('sq'), `/qytetet/${city.slug}/`])));
---
<RrjetiSection eyebrow="Profesionistët e rrjetit" title="Anëtarë të rrjetit." description="Profesionistë shqiptarë nga fusha të ndryshme, në qytete anembanë botës. Kërko sipas emrit, fushës ose qytetit dhe hap profilin e secilit." stats={[{ value: members.length, label: 'Anëtarë të listuar', id: 'stat-total' }, { value: memberCities.length, label: 'Qytete' }, { value: '5000+', label: 'Madhësia e rrjetit' }]} filtersLabel="Filtro katalogun e anëtarëve">
    <a slot="actions" href="/anetaresohu/regjistrohu/">Regjistrohu <span aria-hidden="true">→</span></a>
      <div slot="filters" class="member-filters member-catalog-filters">
        <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="member-search" type="search" placeholder="Kërko sipas emrit…" aria-label="Kërko anëtarë"/></div>
        <select id="filter-expertise" aria-label="Filtro sipas fushës së ekspertizës"><option value="">Të gjitha fushat</option>{expertiseAreas.map(area => <option value={area}>{area}</option>)}</select>
        <select id="filter-city" aria-label="Filtro sipas qytetit"><option value="">Të gjithë qytetet</option>{memberCities.map(city => <option value={city}>{city}</option>)}</select>
        <select id="filter-level" aria-label="Filtro sipas nivelit të eksperiencës"><option value="">Të gjitha nivelet</option><option value="junior">Junior (0–2 vite)</option><option value="mid">Mid level (3–5 vite)</option><option value="senior">Senior (5–9 vite)</option><option value="expert">Expert (10+ vite)</option></select>
      </div>
      <Fragment slot="results">
        <p class="result-count" id="result-count"></p>
        <div class="member-grid" id="member-grid" data-members={JSON.stringify(members)} data-city-links={JSON.stringify(cityLinks)} data-city-aliases={JSON.stringify(cityAliases)} data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}></div>
      </Fragment>

    <section class="section tone-white"><div class="container">
      <SectionTitle kicker="Ku ndodhen" title="Anëtarët në hartë." text="Anëtarët e rrjetit, sipas qytetit ku jetojnë." />
      <div class="members-community-map-layout">
        <div id="members-community-map" data-cities={JSON.stringify(memberMapCities)} aria-label="Harta e anëtarëve të Illyrian Brains, sipas qytetit"></div>
      </div>
      {unmappedMembers > 0 && <p class="map-footnote">{unmappedMembers} anëtarë nuk kanë qytet të njohur dhe nuk shfaqen në hartë.</p>}
    </div></section>

    <section class="section tone-grey"><div class="container"><MemberNetworkGraph members={members} /></div></section>

<div class="member-drawer-overlay" id="member-overlay"></div><aside class="member-drawer" id="member-drawer" aria-hidden="true"><div class="member-drawer-inner" id="member-drawer-content"></div></aside>
</RrjetiSection>

<script>
  import { memberUrl } from '../scripts/members';
  const grid=document.querySelector<HTMLElement>('#member-grid'),search=document.querySelector<HTMLInputElement>('#member-search'),expertise=document.querySelector<HTMLSelectElement>('#filter-expertise'),city=document.querySelector<HTMLSelectElement>('#filter-city'),level=document.querySelector<HTMLSelectElement>('#filter-level'),count=document.querySelector<HTMLElement>('#result-count'),total=document.querySelector<HTMLElement>('#stat-total'),overlay=document.querySelector<HTMLElement>('#member-overlay'),drawer=document.querySelector<HTMLElement>('#member-drawer'),content=document.querySelector<HTMLElement>('#member-drawer-content');
  if(grid){let members=JSON.parse(grid.dataset.members||'[]');const escapeHtml=(value:string)=>value.replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]||character));const initials=(name:string)=>name.split(' ').map((part:string)=>part[0]).join('').slice(0,2).toUpperCase();const levelLabels:any={junior:'Junior (0–2 vite)',mid:'Mid level (3–5 vite)',senior:'Senior (5–9 vite)',expert:'Expert (10+ vite)'};const fields=(member:any)=>member.fieldsOfExpertise||[];const expertisePills=(member:any)=>fields(member).map((value:string)=>`<span class="member-pill member-pill-accent">${escapeHtml(value)}</span>`).join('');
  const cityLinks=JSON.parse(grid.dataset.cityLinks||'{}');
  // Full profile pages exist only for members in the build snapshot (not ones approved since the last deploy).
  const builtProfiles=new Set(members.map((member:any)=>member.username));
  const years=(item:any)=>{const end=item.current?'sot':item.endYear;return item.startYear&&end?`${item.startYear} – ${end}`:String(item.startYear||end||'')};
  const listItem=(icon:string,heading:string,lines:string[],yearText:string,description?:string)=>`<li><span class="profile-list-icon" aria-hidden="true">${escapeHtml(icon)}</span><div><strong>${escapeHtml(heading)}</strong>${lines.filter(Boolean).map(line=>`<span>${escapeHtml(line)}</span>`).join('')}${yearText?`<span class="profile-years">${escapeHtml(yearText)}</span>`:''}${description?`<p>${escapeHtml(description)}</p>`:''}</div></li>`;
  const section=(title:string,body:string)=>`<section class="profile-section"><h3>${title}</h3>${body}</section>`;
  const profileHtml=(member:any)=>{
    const place=[member.city,member.country].filter(Boolean).join(', ');
    const cityUrl=member.city&&cityLinks[member.city.toLocaleLowerCase('sq')];
    const meta=[member.company?escapeHtml(member.company):'',place?(cityUrl?`<a href="${cityUrl}">${escapeHtml(place)}</a>`:escapeHtml(place)):''].filter(Boolean).join(' · ');
    const experience=(member.experience||[]).map((item:any)=>listItem((item.organization||item.title)[0],item.title,[[item.organization,item.location].filter(Boolean).join(' · ')],years(item),item.description)).join('');
    const education=(member.education||[]).map((item:any)=>listItem(item.school[0],item.school,[[item.degree,item.field].filter(Boolean).join(' ')],years(item))).join('');
    const skills=`${expertisePills(member)}${(member.specialty||[]).map((value:string)=>`<span class="member-pill member-pill-specialty">${escapeHtml(value)}</span>`).join('')}`;
    const aspirations=member.aspirations||{};
    const aspired=[aspirations.field,aspirations.subfield].filter(Boolean).join(' · ');
    const aspirationPills=[...(aspirations.mentoring||[]).map((value:string)=>`<span class="member-pill member-pill-accent">${escapeHtml(value)}</span>`),...(aspirations.business||[]).map((value:string)=>`<span class="member-pill member-pill-gold">${escapeHtml(value)}</span>`)].join('');
    const aspirationsHtml=(aspired?`<p class="member-drawer-bio">Synon: <strong>${escapeHtml(aspired)}</strong></p>`:'')+(aspirationPills?`<div class="member-tags">${aspirationPills}</div>`:'')+(aspirations.note?`<p class="member-drawer-bio">${escapeHtml(aspirations.note)}</p>`:'');
    const languages=(member.languages||[]).map((value:string)=>`<span class="member-pill member-pill-location">${escapeHtml(value)}</span>`).join('');
    const network=(member.teams||[]).map((team:any)=>listItem(team.name[0],team.slug==='bordi'?team.name:`Ekipi ${team.name}`,[team.role==='Drejtues'?'Drejtues i ekipit':'Kontribues'],'')).join('')+(member.membershipType==='Organizator'&&member.city?listItem(member.city[0],`Organizator në ${member.city}`,['Organizon takimet e qytetit'],''):'');
    return `<button class="member-drawer-close" type="button" aria-label="Mbyll profilin">✕</button><div class="profile-cover"></div>`
      +`<div class="profile-head">${member.avatar?`<img class="member-drawer-avatar" src="${escapeHtml(member.avatar)}" alt="">`:`<span class="member-drawer-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<h2>${escapeHtml(member.name)}</h2><p class="member-drawer-role">${escapeHtml(member.title||fields(member).join(' · ')||'Ekspertiza TBD')}</p>${meta?`<p class="profile-meta">${meta}</p>`:''}<p class="profile-meta">${member.membershipType?`<span class="member-pill member-pill-gold">${escapeHtml(member.membershipType)}</span> `:''}${member.experienceLevel?`<span class="member-pill member-pill-accent">${escapeHtml(levelLabels[member.experienceLevel])}</span> `:''}Anëtar që nga ${escapeHtml(String(member.since))}</p>`
      +`<div class="member-drawer-actions">${builtProfiles.has(member.username)?`<a class="partner-button" href="${memberUrl(member.username)}">Profili i plotë <span>→</span></a>`:''}${member.linkedinUrl?`<a class="partner-button" href="${encodeURI(member.linkedinUrl)}" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a>`:''}${member.website?`<a class="partner-button" href="${encodeURI(member.website)}" target="_blank" rel="noreferrer">Faqja personale <span>↗</span></a>`:''}${member.profileUrl?`<a class="partner-button" href="${encodeURI(member.profileUrl)}" target="_blank" rel="noreferrer">Profili në forum <span>↗</span></a>`:''}</div></div>`
      +(network?section('Në rrjet',`<ul class="profile-list">${network}</ul><p class="profile-meta"><a href="/ekipet/">Shiko të gjitha ekipet →</a></p>`):'')
      +(member.bio?section('Rreth',`<p class="member-drawer-bio">${escapeHtml(member.bio)}</p>`):'')
      +(experience?section('Eksperienca',`<ul class="profile-list">${experience}</ul>`):'')
      +(education?section('Arsimimi',`<ul class="profile-list">${education}</ul>`):'')
      +(aspirationsHtml?section('Aspiratat e karrierës',aspirationsHtml):'')
      +(skills?section('Ekspertiza dhe aftësitë',`<div class="member-tags">${skills}</div>`):'')
      +(languages?section('Gjuhët',`<div class="member-tags">${languages}</div>`):'');
  };
  const render=()=>{const query=(search?.value||'').trim().toLowerCase();const filtered=members.filter((member:any)=>(!query||`${member.name} ${member.username} ${member.title||''} ${(member.specialty||[]).join(' ')} ${member.bio||''} ${fields(member).join(' ')} ${(member.experience||[]).map((item:any)=>`${item.title} ${item.organization||''}`).join(' ')} ${(member.education||[]).map((item:any)=>`${item.school} ${item.field||''}`).join(' ')}`.toLowerCase().includes(query))&&(!expertise?.value||fields(member).includes(expertise.value))&&(!city?.value||member.city===city.value)&&(!level?.value||member.experienceLevel===level.value)).sort((a:any,b:any)=>a.name.localeCompare(b.name));const filterUsed=Boolean(query||expertise?.value||city?.value||level?.value);const columns=getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length||1;const list=filterUsed?filtered:filtered.slice(0,columns*5);if(total)total.textContent=String(filterUsed?filtered.length:members.length);if(count)count.textContent=filterUsed?`${filtered.length} anëtar${filtered.length===1?'':'ë'} u gjet${filtered.length===1?'':'ën'}`:`Po shfaqen ${list.length} nga ${members.length} anëtarë · përdor filtrat për të parë të tjerët`;grid.innerHTML=list.length?list.map((member:any)=>`<button class="member-card" type="button" data-username="${escapeHtml(member.username)}"><div class="member-card-top">${member.avatar?`<img class="member-avatar" src="${escapeHtml(member.avatar)}" alt="" loading="lazy">`:`<span class="member-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<div><p class="member-card-name">${escapeHtml(member.name)}</p><p class="member-card-role">${escapeHtml(member.title||fields(member).join(' · ')||'Ekspertiza TBD')}</p>${member.company?`<p class="member-card-company">${escapeHtml(member.company)}</p>`:''}</div></div><div class="member-card-meta">${member.experienceLevel?`<span class="member-pill member-pill-accent">${escapeHtml(levelLabels[member.experienceLevel])}</span>`:''}${expertisePills(member)}${(member.specialty||[]).map((value:string)=>`<span class="member-pill member-pill-specialty">${escapeHtml(value)}</span>`).join('')}${member.city?`<span class="member-pill member-pill-location">${escapeHtml(member.city)}</span>`:''}</div><span class="member-card-action">Shiko profilin <span aria-hidden="true">→</span></span></button>`).join(''):'<p class="member-empty">Asnjë anëtar nuk përputhet me filtrat.</p>'};const close=()=>{drawer?.classList.remove('open');overlay?.classList.remove('open');drawer?.setAttribute('aria-hidden','true');document.body.style.overflow=''};grid.addEventListener('click',event=>{const username=(event.target as HTMLElement).closest<HTMLElement>('.member-card')?.dataset.username,member=members.find((item:any)=>item.username===username);if(!member||!drawer||!overlay||!content)return;content.innerHTML=profileHtml(member);drawer.classList.add('open');overlay.classList.add('open');drawer.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';content.querySelector('.member-drawer-close')?.addEventListener('click',close)});[search,expertise,city,level].forEach(control=>control?.addEventListener(control===search?'input':'change',render));let resizeTimer:number;window.addEventListener('resize',()=>{window.clearTimeout(resizeTimer);resizeTimer=window.setTimeout(render,120)});overlay?.addEventListener('click',close);document.addEventListener('keydown',event=>{if(event.key==='Escape')close()});const searchParam=new URLSearchParams(location.search).get('search');if(searchParam&&search)search.value=searchParam;render();
  // Swap the build-time snapshot for live data, so profile edits show without a redeploy.
  const refreshFilter=(select:HTMLSelectElement|null,values:string[])=>{if(!select)return;const current=select.value;select.replaceChildren(select.options[0],...values.map(value=>new Option(value,value)));select.value=values.includes(current)?current:''};
  const supabaseUrl=grid.dataset.supabaseUrl,supabaseKey=grid.dataset.supabaseKey;
  if(supabaseUrl&&supabaseKey){
    const aliases=JSON.parse(grid.dataset.cityAliases||'{}');
    fetch(`${supabaseUrl}/rest/v1/public_member_profiles?select=profile&order=name`,{headers:{apikey:supabaseKey,...(supabaseKey.startsWith('eyJ')&&{Authorization:`Bearer ${supabaseKey}`})}})
      .then(response=>response.ok?response.json():Promise.reject(response.status))
      .then((rows:any[])=>{
        members=rows.map(row=>({...row.profile,city:(row.profile.city&&aliases[row.profile.city.toLowerCase()])||row.profile.city}));
        refreshFilter(expertise,[...new Set<string>(members.flatMap(fields))].sort((a,b)=>a.localeCompare(b,'sq')));
        refreshFilter(city,[...new Set<string>(members.map((member:any)=>member.city).filter(Boolean))].sort());
        render();
      })
      .catch(error=>console.warn('Live member data unavailable, showing the build snapshot.',error));
  }
}
</script>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  const memberMapElement = document.querySelector('#members-community-map');
  if (memberMapElement && window.L) {
    const cityData = JSON.parse(memberMapElement.dataset.cities || '[]');
    const map = L.map(memberMapElement, { scrollWheelZoom: true, doubleClickZoom: true, touchZoom: true, zoomControl: true }).setView([44, 8], 3);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    const label = (count) => `${count} anëtar${count === 1 ? '' : 'ë'}`;
    const markers = cityData.map((city) => L.circleMarker([city.lat, city.lng], {
      radius: Math.min(24, 7 + Math.sqrt(city.count) * 3), color: '#fff', weight: 2, opacity: .9, fillColor: '#744761', fillOpacity: .85
    })
      .bindTooltip(`<div class="map-city-tooltip"><strong>${city.city}</strong><span>${label(city.count)}</span></div>`, { direction: 'top', offset: [0, -10], opacity: .96 })
      .bindPopup(`<div class="map-popup"><strong>${city.city}</strong><span>${city.country}</span><small>${label(city.count)}</small><a class="map-popup-link" href="/qytetet/${city.slug}/">Shiko qytetin ↗</a></div>`)
      .addTo(map));
    if (markers.length) map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [40, 40] });
  }
</script>

<style>
  /* Cards and the drawer are built with innerHTML, so they carry no scope attribute. */
  :global(.member-card-company){margin:3px 0 0;color:var(--accent-dark);font-size:12px;font-weight:800}.member-drawer-company{margin:-10px 0 22px;color:var(--accent-dark);font-size:16px;font-weight:800}:global(.member-tags a.member-pill-location){text-decoration:none;transition:border-color .18s ease,color .18s ease}:global(.member-tags a.member-pill-location:hover){border-color:var(--accent-dark);color:var(--accent-dark)}
  .member-collaboration-card{border:1px solid rgba(255,255,255,.1)!important;background:linear-gradient(145deg,var(--member-card-start),var(--member-card-end))!important}.member-card-plum{--member-card-start:#80566f;--member-card-end:#5a394d}.member-card-blue{--member-card-start:#486f7e;--member-card-end:#294b5a}.member-card-ochre{--member-card-start:#b06f58;--member-card-end:#854938}.member-collaboration-card::after{border-color:rgba(255,255,255,.2)!important;box-shadow:0 0 70px rgba(255,255,255,.06)!important}
  .member-collaboration{padding:96px 0 104px;border-bottom:1px solid var(--line);background:#f7f6f4}.member-collaboration-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,430px);column-gap:70px;align-items:end;margin-bottom:44px}.member-collaboration-heading .eyebrow{grid-column:1/-1;margin-bottom:15px}.member-collaboration-heading h2{max-width:650px;margin:0;font-size:clamp(42px,5.3vw,66px);font-weight:400;line-height:.98;letter-spacing:-.045em}.member-collaboration-heading>p:last-child{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.member-collaboration-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.member-collaboration-card{--member-collaboration-color:#744761;position:relative;display:flex;min-height:330px;flex-direction:column;justify-content:space-between;overflow:hidden;padding:27px 29px 30px;border-radius:12px;color:#fff;background:var(--member-collaboration-color);box-shadow:0 14px 35px rgba(23,24,29,.12);transition:transform .22s ease,box-shadow .22s ease}.member-collaboration-card::after{content:'';position:absolute;right:-52px;top:-62px;width:180px;height:180px;border:1px solid rgba(255,255,255,.16);border-radius:50%}.member-collaboration-card:hover{transform:translateY(-5px);box-shadow:0 20px 42px rgba(23,24,29,.18)}.member-card-plum{--member-collaboration-color:#744761}.member-card-blue{--member-collaboration-color:#365d70}.member-card-ochre{--member-collaboration-color:#a56f32}.member-collaboration-number{position:relative;z-index:1;display:grid;width:36px;height:36px;place-items:center;border:1px solid rgba(255,255,255,.45);border-radius:50%;font-size:10px;font-weight:800;letter-spacing:.08em}.member-collaboration-card>div{position:relative;z-index:1}.member-collaboration-card h3{max-width:290px;margin:0 0 13px;font-size:clamp(25px,2.2vw,31px);font-weight:400;line-height:1.05;letter-spacing:-.025em}.member-collaboration-card p{max-width:310px;margin:0;color:rgba(255,255,255,.78);font-size:14px;line-height:1.65}@media(max-width:900px){.member-collaboration-heading{grid-template-columns:1fr;gap:20px}.member-collaboration-grid{grid-template-columns:1fr}.member-collaboration-card{min-height:250px}}@media(max-width:600px){.member-collaboration{padding:72px 0 78px}.member-collaboration-heading{margin-bottom:30px}.member-collaboration-heading h2{font-size:clamp(38px,11vw,48px)}.member-collaboration-heading>p:last-child{font-size:15px}.member-collaboration-card{min-height:235px;padding:24px}.member-collaboration-card h3{font-size:27px}}
  .member-hero .about-body{max-width:640px;margin-top:18px;color:#ffffffb8;font-size:19px;line-height:1.75}.catalog-heading{display:grid;grid-template-columns:1fr minmax(300px,480px);gap:55px;align-items:end}.catalog-heading h1{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.05}.catalog-heading>p{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.catalog-heading strong{color:var(--accent-dark)}.member-catalog-filters{display:grid;grid-template-columns:minmax(230px,1fr) repeat(3,minmax(150px,190px));margin-top:34px;padding:20px;border:1px solid rgba(116,71,97,.2);border-radius:14px;background:var(--soft)}.member-catalog-filters>*{min-width:0}.member-catalog-filters select{width:100%}#anetaret .member-stats{margin:28px 0 40px;padding-block:24px;border-block:1px solid var(--line)}#anetaret .member-grid{margin-top:32px;margin-bottom:12px}@media(max-width:1000px){.member-catalog-filters{grid-template-columns:1fr 1fr}.member-catalog-filters .member-search{grid-column:1/-1}}@media(max-width:760px){.catalog-heading{grid-template-columns:1fr;gap:18px}}@media(max-width:560px){.member-hero .about-body{font-size:17px}.member-catalog-filters{grid-template-columns:1fr;margin-top:24px;padding:14px}.member-catalog-filters .member-search{grid-column:auto}#anetaret .member-stats{gap:20px;margin:22px 0 28px;padding-block:18px}#anetaret .member-stats>div{flex:1 1 90px}#anetaret .member-grid{margin-top:24px}.result-count{line-height:1.55}}
</style>
