---
// One Përfaqësimi workspace for every NGO and business a member represents
// (the `organizations` table; see supabase/006 and 011). Members may add and
// manage several entities here; admins review them before directory publication.
import '../../styles/account-organizations.css';
import AccountPage from '../../components/AccountPage.astro';
import { partnerCategoryLabels } from '../../data/partners';
import { businessCategoryLabels, businessStageLabels } from '../../data/businesses';
import { cities } from '../../data/cities';
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
const cityNames = [...new Set(cities.map(city => city.city))].sort((a, b) => a.localeCompare(b, 'sq'));

export function getStaticPaths() {
  return [{ params: { lloji: 'perfaqesimi' } }];
}

const categoryLabels = { ...partnerCategoryLabels, ...businessCategoryLabels } as Record<string, string>;
const labels = { category: categoryLabels, stage: businessStageLabels, add: 'Shto një subjekt', all: 'Të gjitha subjektet', empty: 'Ende nuk ke shtuar asnjë subjekt që përfaqëson.' };
---
<AccountPage title="Përfaqësimi · Illyrian Brains" description="Menaxho shoqatat, OJF-të dhe bizneset që përfaqëson në rrjet." heading="Përfaqësimi" intro="Subjektet që përfaqëson dhe personat përgjegjës për to." containerId="orgs" containerClass="orgs-page" containerAttrs={{ 'data-supabase-url': supabaseUrl, 'data-supabase-key': supabaseKey, 'data-labels': JSON.stringify(labels) }} statusId="orgs-status">

        <div class="profile-editor-card" id="signed-out" hidden>
          <h2>Hyr për të vazhduar</h2>
          <p>Kjo faqe është për anëtarët e rrjetit. Hyr me emailin tënd dhe kthehu këtu.</p>
          <a class="partner-button" href="/anetaresohu/profili/">Hyr <span aria-hidden="true">→</span></a>
        </div>

        <div id="signed-in" hidden>
          <div class="orgs-toolbar"><div><strong>Subjektet e mia</strong><span>Shoqata, OJF dhe biznese</span></div><button class="partner-button" type="button" id="org-add">Shto subjekt <span aria-hidden="true">+</span></button></div>
          <div class="orgs-layout">
          <form class="profile-editor-card orgs-form" id="org-form" novalidate hidden>
            <h2 id="form-title">Shto një subjekt</h2>
            <p class="orgs-form-section">Të dhënat</p>
            <label>Lloji *<select name="kind" id="org-kind"><option value="ngo">Shoqatë / OJF / nismë</option><option value="business">Biznes / startup / profesion i pavarur</option></select></label>
            <label>Emri *<input name="name" required minlength="2" maxlength="120" /></label>
            <div class="org-category-group" data-categories-for="ngo">
              <span class="profile-editor-label">Kategoritë e organizatës * <small class="orgs-hint">zgjidh një ose më shumë</small></span>
              <div class="profile-editor-chips orgs-categories">{Object.entries(partnerCategoryLabels).map(([value, label]) => <label class="profile-editor-chip"><input type="checkbox" name="categories" value={value} /> {label}</label>)}</div>
            </div>
            <div class="org-category-group" data-categories-for="business" hidden>
              <span class="profile-editor-label">Kategoritë e biznesit * <small class="orgs-hint">zgjidh një ose më shumë</small></span>
              <div class="profile-editor-chips orgs-categories">{Object.entries(businessCategoryLabels).map(([value, label]) => <label class="profile-editor-chip"><input type="checkbox" name="categories" value={value} /> {label}</label>)}</div>
            </div>
            <div class="profile-editor-grid">
              <label class="profile-editor-wide" id="org-stage" hidden>Faza *<select name="stage">{Object.entries(businessStageLabels).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
              <label>Qyteti<input name="city" list="org-city-options" maxlength="80" /></label>
              <label>Shteti<input name="country" maxlength="80" /></label>
            </div>
            <datalist id="org-city-options">{cityNames.map(city => <option value={city} />)}</datalist>
            <label>Përshkrimi<textarea name="description" rows="4" maxlength="1000" placeholder="Një ose dy fjali: çfarë bën dhe për kë."></textarea></label>
            <p class="orgs-form-section">Lidhjet</p>
            <div class="profile-editor-grid">
              <label class="profile-editor-wide">Faqja e internetit<input name="website" inputmode="url" placeholder="https://…" /></label>
              <label>LinkedIn<input name="linkedin" inputmode="url" placeholder="https://linkedin.com/company/…" /></label>
              <label>Instagram<input name="instagram" inputmode="url" placeholder="https://instagram.com/…" /></label>
            </div>
            <p class="orgs-form-section">Logoja</p>
            <div class="orgs-logo">
              <div class="orgs-logo-box"><img id="logo-preview" alt="" hidden /><span aria-hidden="true">Logo</span></div>
              <div class="orgs-logo-actions">
                <label class="orgs-logo-upload">Ngarko logon<input type="file" accept="image/jpeg,image/png,image/webp" id="logo-input" hidden /></label>
                <button class="profile-editor-text-button" type="button" id="logo-remove" hidden>Hiq logon</button>
                <small>PNG, JPG ose WebP. Ruhet e plotë, pa u prerë.</small>
              </div>
            </div>
            <div class="orgs-form-actions">
              <button class="partner-button" type="submit" id="org-submit">Dërgo për shqyrtim <span aria-hidden="true">→</span></button>
              <button class="profile-editor-text-button" type="button" id="edit-cancel" hidden>Anulo</button>
            </div>
          </form>

          <div class="orgs-list-wrap">
            <div class="orgs-list-head">
              <h2><span id="list-title">Subjektet që menaxhoj</span> <span class="orgs-count" id="org-count"></span></h2>
              <label id="status-filter-wrap" hidden><span class="sr-only">Filtro sipas statusit</span><select id="status-filter"><option value="">Të gjitha</option><option value="pending">Në shqyrtim</option><option value="published">Publikuar</option><option value="hidden">Jo publike</option></select></label>
            </div>
            <div class="orgs-list" id="org-list"></div>
          </div>
          </div>
        </div>

        <section class="profile-editor-card offers-workspace" id="offers-workspace" hidden>
          <div class="offers-heading"><div><p class="eyebrow">Nga subjektet që përfaqëson</p><h2>Ofertat</h2><p>Publiko projekte, thirrje për vullnetarë, përfitime dhe kërkesa bashkëpunimi në një format të vetëm.</p></div></div>
          <form class="offers-form" id="offer-form">
            <label>Subjekti *<select name="organization_id" id="offer-organization" required><option value="">Zgjidh subjektin</option></select></label>
            <label>Lloji *<select name="kind"><option value="job">Vend pune</option><option value="internship">Praktikë</option><option value="event">Event</option><option value="project">Projekt</option><option value="volunteer">Kërkesë për vullnetarë</option><option value="benefit">Përfitim / kupon</option><option value="collaboration">Bashkëpunim</option></select></label>
            <label class="profile-editor-wide">Titulli *<input name="title" required minlength="3" maxlength="160" /></label>
            <label class="profile-editor-wide">Përshkrimi *<textarea name="description" required minlength="10" maxlength="2000" rows="4" placeholder="Çfarë ofrohet, për kë është dhe si mund të përfshihet dikush?"></textarea></label>
            <label>Linku<input name="url" inputmode="url" placeholder="https://…" /></label>
            <label>Afati<input name="expires_at" type="date" /></label>
            <button class="partner-button" type="submit">Publiko ofertën <span aria-hidden="true">→</span></button>
          </form>
          <div class="offers-list" id="offers-list"></div>
        </section>
</AccountPage>
<script src="../../scripts/account-organizations.ts"></script>
