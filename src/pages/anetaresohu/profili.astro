---
// Members sign in with an emailed magic link and edit their own profile;
// admins (the `admins` table) can pick any member. Everything is saved through
// the save_member_profile() database function — see supabase/002-editing.sql.
import AccountPage from '../../components/AccountPage.astro';
import { cities } from '../../data/cities';
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
const cityNames = [...new Set(cities.map(city => city.city))].sort((a, b) => a.localeCompare(b, 'sq'));
---
<AccountPage title="Profili yt · Illyrian Brains" description="Përditëso profilin tënd në drejtorinë e anëtarëve të Illyrian Brains Network." heading="Hyr" intro={'Hyr në llogarinë tënde për të përditësuar profilin në <a href="/anetaret/">drejtorinë e anëtarëve</a>.'} sectionClass="profile-edit-page" containerId="profile-editor" containerAttrs={{ 'data-site': Astro.site?.origin, 'data-supabase-url': supabaseUrl, 'data-supabase-key': supabaseKey }} introId="signin-intro" introHidden={true} statusId="editor-status">

        <form class="profile-editor-card auth-card" id="login-form" hidden>
          <h2>Hyr me email</h2>
          <p>Shkruaj emailin me të cilin je regjistruar në rrjet. Do të të dërgojmë një link për të hyrë — pa fjalëkalim.</p>
          <label>Email<input type="email" name="email" required autocomplete="email" placeholder="emri@shembull.com" /></label>
          <button class="partner-button" type="submit">Më dërgo linkun <span aria-hidden="true">→</span></button>
          <p class="auth-card-foot">Nuk je ende anëtar? <a href="/anetaresohu/regjistrohu/">Regjistrohu →</a></p>
        </form>

        <div class="profile-editor-card auth-card" id="no-profile" hidden>
          <h2>Nuk gjetëm profil</h2>
          <p>Emaili <strong id="no-profile-email"></strong> nuk është i lidhur me asnjë profil në drejtori. Na shkruaj te <a href="mailto:illyrianbrains@gmail.com">illyrianbrains@gmail.com</a> dhe e lidhim.</p>
          <button class="profile-editor-text-button" type="button" data-sign-out>Dil</button>
        </div>

        <form class="profile-layout" id="profile-form" hidden>
          <div class="profile-main">
            <p class="profile-editor-notice" id="pending-notice" hidden>Ky profil pret aprovimin nga ekipi i IB dhe ende nuk shfaqet në drejtori. Mund ta plotësosh ndërkohë.</p>

            <section class="profile-card profile-intro" id="section-intro">
              <div class="profile-intro-cover"></div>
              <div class="profile-intro-top">
                <div class="profile-intro-photo">
                  <img id="photo-preview" class="profile-intro-avatar" alt="" hidden />
                  <span id="photo-fallback" class="profile-intro-avatar member-avatar-fallback"></span>
                  <label class="profile-intro-camera" title="Ngarko foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg><span class="sr-only">Ngarko foto</span><input type="file" accept="image/jpeg,image/png,image/webp" id="photo-input" /></label>
                </div>
                <div class="profile-intro-photo-actions">
                  <label class="profile-editor-text-button" for="photo-input">Ndrysho foton</label>
                  <button class="profile-editor-text-button" type="button" id="photo-remove">Hiq foton</button>
                </div>
              </div>
              <div class="profile-intro-preview" aria-hidden="true">
                <h2 id="preview-name"></h2>
                <p id="preview-headline"></p>
                <p class="profile-intro-meta" id="preview-meta"></p>
              </div>
              <p class="profile-editor-hint">Fotoja pritet automatikisht në katror. Një foto portreti ku duket fytyra funksionon më mirë.</p>
            </section>

            <details class="profile-group" id="group-descriptive" open>
              <summary><span class="profile-group-title">Informacioni i profilit</span><span class="profile-group-hint">Prezantimi, vendndodhja, gjuhët dhe linqet</span></summary>
              <div class="profile-group-body">
                <section class="profile-card" id="section-basics">
                  <div class="profile-card-head"><h2>Të dhënat kryesore</h2></div>
                  <div class="profile-editor-grid profile-card-body">
                    <label class="profile-editor-wide">Emri i plotë *<input name="name" required maxlength="120" /></label>
                    <label class="profile-editor-wide">Titulli<input name="headline" maxlength="160" placeholder="p.sh. Inxhiniere software" /></label>
                    <label class="profile-editor-wide">Kompania / institucioni<input name="company" maxlength="160" /></label>
                    <label class="profile-editor-wide">Niveli i eksperiencës<select name="experience_level"><option value="">— Zgjidh nivelin —</option><option value="junior">Junior (0–2 vite)</option><option value="mid">Mid level (3–5 vite)</option><option value="senior">Senior (5–9 vite)</option><option value="expert">Expert (10+ vite)</option></select></label>
                    <label>Qyteti<input name="city" list="city-list" maxlength="80" /></label>
                    <datalist id="city-list">{cityNames.map(name => <option value={name} />)}</datalist>
                    <label>Shteti<input name="country" maxlength="80" /></label>
                  </div>
                </section>

                <section class="profile-card" id="section-about">
                  <div class="profile-card-head"><h2>Rreth meje</h2></div>
                  <label class="profile-card-body"><span class="sr-only">Rreth meje</span><textarea name="about" rows="6" maxlength="5000" placeholder="Disa fjali për rrugën tënde profesionale, çfarë bën dhe çfarë të intereson."></textarea></label>
                </section>

                <section class="profile-card" id="section-languages">
                  <div class="profile-card-head"><h2>Gjuhët</h2></div>
                  <div class="profile-editor-tags profile-card-body" data-tags="languages"><input placeholder="p.sh. Shqip, Anglisht — shtyp Enter" aria-label="Shto gjuhë" /></div>
                </section>

                <section class="profile-card" id="section-links">
                  <div class="profile-card-head"><h2>Linqe</h2></div>
                  <div class="profile-editor-grid profile-card-body">
                    <label>LinkedIn<input name="linkedin_url" inputmode="url" autocomplete="url" placeholder="https://linkedin.com/in/…" /></label>
                    <label>Faqja personale<input name="website" inputmode="url" autocomplete="url" placeholder="https://…" /></label>
                  </div>
                </section>
              </div>
            </details>

            <details class="profile-group" id="group-current" open>
              <summary><span class="profile-group-title">Ku jam sot</span><span class="profile-group-hint">Eksperienca, arsimimi, ekspertiza dhe aftësitë</span></summary>
              <div class="profile-group-body">
                <section class="profile-card" id="section-experience">
                  <div class="profile-card-head"><h2>Eksperienca</h2><button class="profile-card-add" type="button" id="add-experience" aria-label="Shto eksperiencë" title="Shto eksperiencë">+</button></div>
                  <div class="profile-editor-rows" id="experience-rows"></div>
                  <p class="profile-card-empty">Ende pa eksperiencë. Shtoje me butonin +.</p>
                </section>

                <section class="profile-card" id="section-education">
                  <div class="profile-card-head"><h2>Arsimimi</h2><button class="profile-card-add" type="button" id="add-education" aria-label="Shto arsimim" title="Shto arsimim">+</button></div>
                  <div class="profile-editor-rows" id="education-rows"></div>
                  <p class="profile-card-empty">Ende pa arsimim. Shtoje me butonin +.</p>
                </section>

                <section class="profile-card" id="section-categories">
                  <div class="profile-card-head"><h2>Fushat e ekspertizës</h2></div>
                  <div class="profile-editor-chips profile-card-body" id="categories"></div>
                </section>

                <section class="profile-card" id="section-skills">
                  <div class="profile-card-head"><h2>Aftësitë</h2></div>
                  <div class="profile-editor-tags profile-card-body" data-tags="skills"><input placeholder="Shkruaj një aftësi dhe shtyp Enter" aria-label="Shto aftësi" /></div>
                </section>
              </div>
            </details>

            <details class="profile-group" id="group-future" open>
              <summary><span class="profile-group-title">Ku synoj</span><span class="profile-group-hint">Aspiratat e karrierës, mentorimi, biznesi dhe kthimi</span></summary>
              <div class="profile-group-body">
                <section class="profile-card" id="section-aspirations">
                  <div class="profile-card-head"><h2>Drejtimi</h2></div>
                  <div class="profile-editor-grid profile-card-body">
                    <label>Fusha ku synon të shkosh<select name="aspiration_field"><option value="">—</option></select></label>
                    <label>Nënfusha<input name="aspiration_subfield" maxlength="120" placeholder="p.sh. Data science, kardiologji" /></label>
                  </div>
                </section>

                <section class="profile-card" id="section-looking-for">
                  <div class="profile-card-head"><h2>Çfarë kërkoj</h2></div>
                  <div class="profile-editor-grid profile-card-body">
                    <div class="profile-editor-wide profile-editor-label">Karriera dhe mentorimi<div class="profile-editor-chips">{['Lidhje me një mentor', 'Këshillim për karrierën', 'Mundësi për të mentoruar'].map(value => <label class="profile-editor-chip"><input type="checkbox" name="mentoring_interests" value={value} /> {value}</label>)}</div></div>
                    <div class="profile-editor-wide profile-editor-label">Biznesi dhe bashkëpunimi<div class="profile-editor-chips">{['Prezantim me bashkëthemelues', 'Prezantim me klientë / partnerë', 'Mundësi pune', 'Kandidatë për punësim', 'Financim për projekt / biznes', 'Mundësi investimi'].map(value => <label class="profile-editor-chip"><input type="checkbox" name="business_interests" value={value} /> {value}</label>)}</div></div>
                    <label class="profile-editor-wide">Brief për ekipin e rrjetit<textarea name="aspirations_note" rows="7" maxlength="1000" placeholder={'Rezultati që kërkoj: …\nPersoni / organizata ideale: …\nQyteti ose formati: …\nAfati: …\nÇfarë kam provuar deri tani: …\nSi mund të kontribuoj unë: …'}></textarea></label>
                  </div>
                  <p class="profile-editor-hint">Jep detaje konkrete që ekipi i rrjetit të kuptojë kë duhet të kontaktojë dhe çfarë prezantimi apo mbështetjeje të organizojë. Ky informacion shfaqet edhe në profilin tënd publik.</p>
                </section>

                <section class="profile-card" id="section-return">
                  <div class="profile-card-head"><h2>Kthimi në Shqipëri / Kosovë</h2><span class="profile-card-private">Privat</span></div>
                  <div class="profile-editor-grid profile-card-body">
                    <div class="profile-editor-wide profile-editor-label">A mendon të kthehesh?<div class="profile-editor-chips">{[['po', 'Po'], ['ndoshta', 'Ndoshta, më vonë'], ['jo', 'Jo për momentin'], ['atje', 'Jetoj tashmë atje']].map(([value, label]) => <label class="profile-editor-chip"><input type="radio" name="return_plan" value={value} /> {label}</label>)}</div></div>
                    <div class="profile-editor-wide profile-editor-label" id="return-countries">Ku?<div class="profile-editor-chips">{['Shqipëri', 'Kosovë'].map(value => <label class="profile-editor-chip"><input type="checkbox" name="return_countries" value={value} /> {value}</label>)}</div></div>
                  </div>
                  <p class="profile-editor-hint">Nuk publikohet — e shohin vetëm ti dhe ekipi i IB.</p>
                </section>
              </div>
            </details>

          </div>

          <aside class="profile-aside">
            <div class="profile-card profile-aside-account">
              <span>Je i/e kyçur si <strong id="signed-in-as"></strong></span>
              <label id="admin-picker" hidden>Profili që po editon<select name="member"></select></label>
              <label id="admin-fields" hidden>Statusi<select name="status"><option value="ok">ok — shfaqet në drejtori</option><option value="pending">pending — i fshehur</option></select></label>
              <button class="profile-editor-text-button" type="button" data-sign-out>Dil</button>
            </div>

            <div class="profile-card profile-strength" id="profile-strength">
              <div class="profile-strength-head"><strong>Sa i plotë është profili</strong><span id="strength-percent"></span></div>
              <div class="profile-strength-bar" aria-hidden="true"><span id="strength-fill"></span></div>
              <div class="profile-strength-missing" id="strength-missing"></div>
            </div>

            <div class="profile-card profile-editor-actions">
              <button class="partner-button" type="submit">Ruaj ndryshimet <span aria-hidden="true">✓</span></button>
              <span class="profile-editor-dirty" id="dirty-note" hidden>Ke ndryshime të paruajtura</span>
              <a id="view-profile" href="/anetaret/">Shiko në drejtori →</a>
            </div>

            <div class="profile-card profile-account-tools">
              <strong>Të dhënat e llogarisë</strong>
              <p class="profile-editor-hint">Shkarko një kopje ose fshih profilin publik. Riaktivizimi bëhet nga ekipi i IB.</p>
              <button class="profile-editor-text-button" type="button" id="export-data">Shkarko të dhënat</button>
              <button class="profile-editor-text-button profile-danger" type="button" id="deactivate-account">Çaktivizo profilin</button>
            </div>
          </aside>
        </form>
      </AccountPage>
<script src="../../scripts/account-profile.ts"></script>
