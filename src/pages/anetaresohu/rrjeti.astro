---
// "Rrjeti im": the signed-in member at the centre of their own network — linked to
// their city and fields of expertise, and through them to the members who share
// them — with potential connections to follow, and who they follow / who follows
// them. Following is supabase/007-social.sql (set_follow(), my_network()); members
// come from the public_member_profiles view. Writing posts is on /rrjeti/postimet/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/directory.css';
import '../../styles/account-network.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { cities } from '../../data/cities';
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
---
<BaseLayout title="Rrjeti im · Illyrian Brains" description="Ti në rrjetin e Illyrian Brains: njerëzit nga qyteti dhe fusha jote, dhe lidhjet e mundshme.">
  <Header />
  <main>
    <section class="section tone-white profile-editor-section">
      <div class="container profile-editor my-network" id="network" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} data-cities={JSON.stringify(cities.map(city => city.city).sort((a, b) => a.localeCompare(b, 'sq')))}>
        <header class="profile-editor-intro">
          <h1>Rrjeti im</h1>
          <p>Ti, qyteti yt dhe fushat e tua — dhe njerëzit që i ndani. Ndiq ata që të interesojnë dhe gjej lidhje të reja.</p>
        </header>

        <p class="profile-editor-status" id="network-status" role="status" aria-live="polite"></p>

        <div class="profile-editor-card" id="signed-out" hidden>
          <h2>Hyr për të vazhduar</h2>
          <p>Rrjeti yt është për anëtarët. Hyr me emailin tënd dhe kthehu këtu.</p>
          <a class="partner-button" href="/anetaresohu/profili/">Hyr <span aria-hidden="true">→</span></a>
        </div>

        <div id="signed-in" hidden>
          <section class="network-profile-card" aria-label="Profili im në rrjet">
            <div class="network-profile-cover"></div>
            <div class="network-profile-main">
              <div class="network-profile-avatar" id="network-profile-avatar"></div>
              <div class="network-profile-copy"><p class="eyebrow">Mirë se erdhe në rrjet</p><h1 id="network-profile-name">Profili im</h1><p id="network-profile-headline"></p><p class="network-profile-location" id="network-profile-location"></p></div>
              <div class="network-profile-actions"><a class="partner-button" href="/rrjeti/postimet/#njoftim-i-ri">Krijo njoftim <span aria-hidden="true">＋</span></a><a href="/anetaresohu/profili/">Përditëso profilin</a></div>
            </div>
            <div class="my-network-stats">
            <div><strong id="stat-city">0</strong><span id="stat-city-label">Në qytetin tënd</span></div>
            <div><strong id="stat-fields">0</strong><span>Në fushat e tua</span></div>
            <div><strong id="stat-following">0</strong><span>Ndjek</span></div>
            <div><strong id="stat-followers">0</strong><span>Të ndjekin</span></div>
            <button class="my-network-stat-button" type="button" id="notification-open"><strong id="stat-notifications">0</strong><span>Të palexuara</span></button>
            </div>
          </section>
          <p class="profile-editor-notice" id="incomplete-note" hidden>Shto qytetin dhe fushat e ekspertizës në <a href="/anetaresohu/profili/">profilin tënd</a> që të të lidhim me njerëzit përreth dhe në fushën tënde.</p>

          <section class="profile-editor-card my-network-section my-subscriptions" id="subscriptions-panel" aria-label="Njoftimet dhe abonimet">
            <div class="my-subscriptions-body">
              <div class="my-subscriptions-manager">
                <section class="my-subscriptions-picker" aria-labelledby="subscriptions-add-title">
                  <div class="my-subscriptions-section-head"><span class="my-subscriptions-step">1</span><div><h3 id="subscriptions-add-title">Shto abonim</h3><p>Zgjidh çfarë dëshiron të ndjekësh.</p></div></div>
                  <div class="my-subscriptions-controls">
                    <label><span><i aria-hidden="true">⌖</i> Qytet</span><span class="my-subscriptions-add"><select id="subscription-city"><option value="">Zgjidh një qytet</option></select><button type="button" data-add-kind="city">Shto</button></span></label>
                    <label><span><i aria-hidden="true">◇</i> Fushë profesionale</span><span class="my-subscriptions-add"><select id="subscription-field"><option value="">Zgjidh një fushë</option></select><button type="button" data-add-kind="field">Shto</button></span></label>
                    <label><span><i aria-hidden="true">□</i> Subjekt i përfaqësuar</span><span class="my-subscriptions-add"><select id="subscription-organization"><option value="">Zgjidh një subjekt</option></select><button type="button" data-add-kind="organization">Shto</button></span></label>
                  </div>
                </section>
                <section class="my-subscriptions-active" aria-labelledby="subscriptions-active-title">
                  <div class="my-subscriptions-section-head"><span class="my-subscriptions-step">2</span><div><h3 id="subscriptions-active-title">Abonimet aktive <b id="subscription-total">0</b></h3><p>Kliko × për të ndaluar një abonim.</p></div></div>
                  <div class="my-subscription-chips" id="subscription-chips"></div>
                </section>
              </div>
              <section class="my-subscription-updates" aria-labelledby="subscription-updates-title">
                <div class="my-subscription-feed-head"><div><span class="my-subscriptions-step">●</span><h3 id="subscription-updates-title">Njoftimet e fundit</h3></div><div><button type="button" id="notifications-read" hidden>Shënoji si të lexuara</button></div></div>
                <div class="my-subscription-feed" id="subscription-feed"><p class="network-people-empty">Shto një qytet, fushë profesionale ose subjekt për të marrë përditësime këtu.</p></div>
              </section>
            </div>
          </section>

          <div class="my-network-layout">
            <div class="my-network-main">
              <details class="profile-editor-card my-network-section" id="graph-panel">
                <summary class="my-subscriptions-head"><span><span class="eyebrow">Harta e lidhjeve</span><strong>Grafi i rrjetit tim</strong><small>Shiko si lidheni përmes qytetit, fushave dhe personave që ndjek.</small></span><i aria-hidden="true"></i></summary>
                <div class="my-network-section-body">
                  <div class="my-network-graph-card">
                    <div class="my-network-toolbar">
                      <div class="my-network-legend"><span><i class="me"></i>Ti</span><span><i class="city"></i>Qyteti</span><span><i class="field"></i>Fushë</span><span><i class="following"></i>Ndjek</span><span><i class="person"></i>Lidhje e mundshme</span></div>
                      <button type="button" id="graph-reset">Rivendos pamjen</button>
                    </div>
                    <div id="my-network-graph" role="img" aria-label="Grafi i rrjetit tënd: ti, qyteti yt, fushat e tua dhe anëtarët që i ndani"></div>
                  </div>
                  <div class="profile-editor-card my-network-selected" id="selected" hidden></div>
                  <p class="my-network-hint" id="graph-hint">Zgjidh një person, qytetin ose një fushë në graf për të parë lidhjet.</p>
                </div>
              </details>

              <details class="profile-editor-card my-network-section" id="people-panel">
                <summary class="my-subscriptions-head"><span><span class="eyebrow">Njerëzit</span><strong>Ndjek dhe më ndjekin</strong><small>Menaxho lidhjet e drejtpërdrejta në rrjetin tënd.</small></span><i aria-hidden="true"></i></summary>
                <div class="my-network-section-body">
                  <div class="my-network-follows">
                    <section class="profile-editor-card"><h2 id="following-title">Ndjek</h2><ul class="network-people" id="following"></ul></section>
                    <section class="profile-editor-card"><h2 id="followers-title">Të ndjekin</h2><ul class="network-people" id="followers"></ul></section>
                  </div>
                </div>
              </details>

              <details class="profile-editor-card my-network-section" id="recommended-panel" open>
                <summary class="my-subscriptions-head"><span><span class="eyebrow">Lidhje të reja</span><strong>Sipas qytetit dhe fushës</strong><small>Lidhjet e rekomanduara, nga ato me më shumë të përbashkëta.</small></span><i aria-hidden="true"></i></summary>
                <div class="my-network-section-body">
                  <div class="my-network-recommended-head"><p>Sa më e errët karta, aq më të ngjashëm jeni.</p></div>
                  <div class="my-network-recommended" id="recommended"></div>
                  <button type="button" class="my-network-more" id="recommended-more" hidden>Shfaq më shumë</button>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
<script src="../../scripts/account-network.ts"></script>
