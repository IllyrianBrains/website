import CommunityMap from '../components/CommunityMap.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Illyrian Brains Network" description="Rrjeti i Illyrian Brains që bashkon profesionistët shqiptarë kudo ndodhen — me evente miqësore dhe diskutime të frytshme.">
  <Header />
  <main>
    <Hero />
    <Stats />
    <Organizimet />
    <CommunityMap />
    <WhatWeDo />
  </main>
  <Footer />
</BaseLayout>
