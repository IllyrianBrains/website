---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeafletMapAssets from '../components/LeafletMapAssets.astro';
import { cities } from '../data/cities';
import { cityRegions } from '../data/regions';
import { directoryMembers } from '../data/members';
import { teams } from '../data/teams';
import 'reveal.js/dist/reveal.css';
import '../styles/presentation.css';

const regionBySlug = new Map(cityRegions.flatMap(region => region.citySlugs.map(slug => [slug, region])));
const presentationCities = cities.map(city => ({ city: city.city, country: city.country, lat: city.lat, lng: city.lng, status: city.status, color: regionBySlug.get(city.slug)?.color ?? '#744761', scope: city.country === 'SHBA' ? 'usa' : city.lat >= 34 && city.lat <= 71 && city.lng >= -25 && city.lng <= 45 ? 'europe' : 'other' }));
const membersWithAvatars = directoryMembers.filter(member => member.avatar);
const presentationMemberCount = Math.min(32, membersWithAvatars.length);
const presentationMembers = Array.from({ length: presentationMemberCount }, (_, index) => membersWithAvatars[Math.floor(index * (membersWithAvatars.length - 1) / Math.max(1, presentationMemberCount - 1))]);
const cityMembers = Object.entries(directoryMembers.reduce<Record<string, typeof directoryMembers>>((groups, member) => {
  if (!member.city) return groups;
  (groups[member.city] ??= []).push(member);
  return groups;
}, {})).sort(([, a], [, b]) => b.length - a.length).slice(0, 12).map(([city, members]) => ({ city, members }));
const teamProfiles = teams.map(team => ({
  ...team,
  members: directoryMembers.filter(member => member.teams?.some(item => item.slug === team.slug)),
}));
const boardMembers = directoryMembers.filter(member => member.teams?.some(team => team.slug === 'bordi'));
---
<BaseLayout title="Prezantimi · Illyrian Brains" description="Prezantimi i Illyrian Brains Network për organizatorët dhe pjesëmarrësit e rinj.">
  <main class="presentation-page">
    <div class="presentation-toolbar" aria-label="Kontrollet e prezantimit">
      <a href="/" class="presentation-brand" aria-label="Kthehu në faqen kryesore"><img src="/assets/logo.png" alt="Illyrian Brains" /></a>
      <span class="presentation-hint">← → për të lëvizur · O për pamjen e plotë</span>
      <button class="presentation-fullscreen" type="button" data-fullscreen><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/></svg><span>Ekran i plotë</span></button>
    </div>
    <div class="reveal"><div class="slides">
      <section class="title-slide" data-background-color="#181a1d">
        <div class="title-shell">
          <div class="title-copy">
            <p class="slide-kicker">Illyrian Brains Network</p>
            <h1>Rrjeti shqiptar i<br /><em>profesionistëve.</em></h1>
          </div>
          <figure class="title-visual"><img src="/assets/inst_meetup.png" alt="Anëtarë të Illyrian Brains gjatë një takimi" /></figure>
        </div>
        <p class="slide-lead">Njihu, mëso dhe bashkëpuno me profesionistë shqiptarë kudo në botë.</p>
        <aside class="notes">Mirë se erdhët. Ky prezantim është një hyrje e shkurtër në mënyrën si funksionon rrjeti dhe si mund të bëheni pjesë.</aside>
      </section>
      <section class="chapter-slide chapter-about" data-background-color="#30272e">
        <p class="chapter-index">Kapitulli 01</p><h2>Çfarë është IB?</h2>
        <div class="chapter-topics"><span>Si nisi</span><span>Pse ekziston</span><span>Si ndihmon</span><span>Si zhvillohet</span></div>
        <aside class="notes">Në këtë kapitull tregojmë shkurt historinë e IB, arsyen pse ekziston dhe mënyrën si rrjeti po ndërtohet për të ardhmen.</aside>
      </section>
      <section class="metric-slide" data-background-color="#30272e">
        <p class="slide-number">IB sot</p><h2>Një rrjet ndërkombëtar,<br />i ndërtuar qytet pas qyteti.</h2>
        <div class="metric-grid"><article><strong>50+</strong><span>qytete me evente</span></article><article><strong>500+</strong><span>evente dhe Happy Hours</span></article><article><strong>5,000+</strong><span>pjesëmarrës</span></article><article><strong>100+</strong><span>grupe dhe komunitete tematike</span></article></div>
        <div class="community-photo-strip" aria-label="Komunitete të Illyrian Brains në qytete të ndryshme"><figure><img src="/assets/cities/Berlin.jpg" alt="Komuniteti Illyrian Brains në Berlin" /><figcaption>Berlin</figcaption></figure><figure><img src="/assets/cities/London%20Maj25.jpeg" alt="Komuniteti Illyrian Brains në Londër" /><figcaption>Londër</figcaption></figure><figure><img src="/assets/cities/Milano.jpg" alt="Komuniteti Illyrian Brains në Milano" /><figcaption>Milano</figcaption></figure><figure><img src="/assets/cities/NY.jpg" alt="Komuniteti Illyrian Brains në New York" /><figcaption>New York</figcaption></figure></div>
      </section>
      <section class="history-slide" data-background-color="#202225">
        <p class="slide-number">Historia jonë</p><h2>Nga një ide në 2020,<br />në një organizatë sot.</h2>
        <div class="history-timeline">
          <article><span>2020-2022</span><div><h3>Fillimi</h3><p>Profesionistët shqiptarë krijojnë një hapësirë për t’u njohur dhe për të shkëmbyer njohuri.</p></div></article>
          <article><span>2023-2025</span><div><h3>Rritja</h3><p>Shtohen takimet, qytetet dhe projektet, dhe krijohet një identitet i përbashkët.</p></div></article>
          <article><span>2026-nesër</span><div><h3>OJF e regjistruar</h3><p>Një organizatë shqiptare me rrjet ndërkombëtar profesionistësh.</p></div></article>
        </div>
      </section>
      <section class="governance-slide" data-background-color="#26313d">
        <p class="slide-number">Qeverisja</p><h2>Një rrjet, disa mënyra organizimi.</h2>
        <div class="governance-layout">
          <div class="governance-roles" aria-label="Rolet në rrjet">
            <article><i class="secretariat"></i><div><h3>Sekretariati</h3><p>Koordinon dhe mbështet rrjetin.</p></div></article>
            <article><i class="city"></i><div><h3>Qytetet</h3><p>Organizojnë komunitetin lokal në mënyrë autonome.</p></div></article>
            <article><i class="chapter"></i><div><h3>OJF lokale</h3><p>Degë e formalizuar nga një komunitet qyteti.</p></div></article>
            <article><i class="group"></i><div><h3>Grupet profesionale</h3><p>Lidhin ekspertë nga disa qytete.</p></div></article>
            <article><i class="subgroup"></i><div><h3>Nëngrupet lokale</h3><p>Krijojnë aktivitete brenda një qyteti.</p></div></article>
            <article><i class="project"></i><div><h3>Projektet</h3><p>Nisma të anëtarëve, paralel me qytetet dhe grupet.</p></div></article>
          </div>
          <div id="governance-graph" role="img" aria-label="Harta e lidhjeve mes sekretariatit, qyteteve, degëve formale, grupeve profesionale, nëngrupeve, projekteve dhe anëtarëve"></div>
        </div>
        <div class="governance-examples"><span>Modele të ngjashme:</span><a href="https://meta.wikimedia.org/wiki/Wikimedia_movement_affiliates">Wikimedia</a><a href="https://osmfoundation.org/wiki/Local_Chapters">OpenStreetMap</a><a href="https://creativecommons.org/about/global-affiliate-network/">Creative Commons</a></div>
        <aside class="notes">IB OJF mban infrastrukturën dhe koordinimin, por nuk drejton çdo aktivitet. Prej saj dalin tri degë paralele: qytetet, grupet profesionale dhe projektet. New York, Milano dhe Berlin janë shembuj qytetesh; Milano tregon edhe mundësinë e formalizimit si OJF lokale. IB Tech dhe IB Health lidhin profesionistë nga qytete të ndryshme. Atlas dhe Mentoring janë projekte të anëtarëve.</aside>
      </section>
      <section class="value-slide" data-background-color="#26313d">
        <div class="value-copy"><p class="slide-number">Si të ndihmon rrjeti</p><h2>Gjej lidhjen që të duhet.</h2><div class="value-key"><span><i class="start"></i>Ti</span><span><i class="target"></i>Personi që kërkon</span></div></div>
        <div id="value-graph" role="img" aria-label="Një person që përmes shumë lidhjeve në rrjet gjen personin që i duhet"></div>
      </section>
      <section class="chapter-slide chapter-people" data-background-color="#26313d">
        <p class="chapter-index">Kapitulli 02</p><h2>Qytetet dhe profesionistët</h2>
        <div class="chapter-topics"><span>Anëtarët</span><span>Qytetet</span><span>Eventet</span><span>Ekipet</span></div>
        <aside class="notes">Ky kapitull bashkon njerëzit dhe qytetet: anëtarët, ekipet, komunitetet lokale dhe mënyrën si takimet krijojnë lidhje.</aside>
      </section>
      <section class="city-members-slide" data-background-color="#263433">
        <p class="slide-number">Ku jemi</p><h2>Qytete të ndryshme.</h2>
        <div class="city-member-grid">{cityMembers.map(group => <article><div class="city-avatar-stack">{group.members.filter(member => member.avatar).slice(0, 3).map(member => <img src={member.avatar} alt="" />)}</div><div><h3>{group.city}</h3><p>{group.members.length} anëtarë në direktori</p></div></article>)}</div>
      </section>
      <section class="organizer-slide" data-background-color="#30272e">
        <div class="organizer-copy"><p class="slide-number">Eventet</p><h2>Takimet e kthejnë rrjetin në komunitet.</h2><div class="organizer-actions"><span>Njohje të reja</span><span>Biseda me vlerë</span><span>Përvoja të përbashkëta</span><span>Lidhje që vazhdojnë</span></div></div>
        <div class="organizer-photos" aria-label="Momente nga eventet e komunitetit"><figure><img src="/assets/cities/Berlin.jpg" alt="Pjesëmarrës të buzëqeshur në eventin e Berlinit" /><figcaption>Njerëz që njihen</figcaption></figure><figure><img src="/assets/cities/Milano.jpg" alt="Komuniteti në një event në Milano" /><figcaption>Momente që mbahen mend</figcaption></figure><figure><img src="/assets/cities/NY.jpg" alt="Pjesëmarrës në eventin e New York-ut" /><figcaption>Një ndjesi përkatësie</figcaption></figure></div>
      </section>
      <section class="map-slide" data-background-color="#1e2125">
        <div class="map-slide-copy"><p class="slide-number">Qytetet në hartë</p><h2>Një rrjet pa kufij.</h2><p>Gjej komunitetin më pranë teje.</p><div class="map-scope-controls" aria-label="Zgjidh rajonin"><button type="button" class="is-active" data-map-scope="europe" aria-pressed="true">Evropë</button><button type="button" data-map-scope="usa" aria-pressed="false">SHBA</button></div><div class="map-legend-compact"><span><i class="active"></i>Aktiv</span><span><i></i>Në zhvillim</span></div></div>
        <div id="presentation-map" data-cities={JSON.stringify(presentationCities)} aria-label="Harta e qyteteve të Illyrian Brains"></div>
      </section>
      <section class="city-profile-slide" data-background-color="#26313d">
        <p class="slide-number">Qytetet</p>
        <h2>Si funksionon 1 qytet</h2>
        <div class="city-simple-steps">
          <article><b>1</b><div><h3>Ekipi organizator</h3><p>Koordinon qytetin dhe takimet.</p><span>Happy Hours periodike</span></div></article>
          <article><b>2</b><div><h3>Grupet</h3><p>Krijojnë aktivitete rreth interesave.</p><span>Libër · Volley · Hiking · Profesione</span></div></article>
          <article><b>3</b><div><h3>Pjesëmarrësit</h3><p>Marrin pjesë dhe sjellin ide.</p><span>Pjesëmarrës → Kontribues → Organizator</span></div></article>
        </div>
      </section>
      <section class="members-motion-slide" data-background-color="#181a1d">
        <div class="members-motion-heading"><div><p class="slide-number">Anëtarët</p><h2>Anëtarë në lëvizje.</h2></div><p class="members-motion-intro">Profesionistë që njihen, ndihmojnë dhe krijojnë së bashku.</p></div>
        <div class="member-marquees" aria-label="Anëtarë të Illyrian Brains">
          {[0, 1, 2, 3].map(rowIndex => { const row = presentationMembers.slice(rowIndex * 8, rowIndex * 8 + 8); return <div class:list={["member-marquee", { reverse: rowIndex % 2 === 1 }]}><div class="member-marquee-track">{[...row, ...row].map((member, index) => <article aria-hidden={index >= row.length ? 'true' : undefined}><img src={member.avatar} alt="" /><div><strong>{member.name}</strong><span>{member.city || member.fieldsOfExpertise?.[0] || 'Illyrian Brains'}</span></div></article>)}</div></div> })}
        </div>
      </section>
      <section class="graph-slide" data-background-color="#181a1d">
        <div class="graph-copy"><p class="slide-number">Si lidhemi</p><h2>Një person.<br />Disa komunitete.</h2><p>Qyteti, profesioni, interesat dhe projektet lidhen në një rrjet.</p></div>
        <div id="presentation-graph" role="img" aria-label="Një person që është pjesë e disa komuniteteve të lidhura brenda rrjetit"></div>
      </section>
      <section class="chapter-slide chapter-projects" data-background-color="#2a3036">
        <p class="chapter-index">Kapitulli 05</p><h2>Nga ide në projekte</h2>
        <div class="chapter-topics"><span>Ide</span><span>Ekip</span><span>Mbështetje</span><span>Projekt</span></div>
        <aside class="notes">Në fund tregojmë se rrjeti nuk ndalet te takimet. Anëtarët mund të bashkohen dhe të ndërtojnë projekte që përdoren nga komuniteti.</aside>
      </section>
      <section class="make-project-slide" data-background-color="#2a3036">
        <p class="slide-number">Nga ideja te projekti</p><h2>Ke një ide?<br />Ktheje në projekt me rrjetin.</h2>
        <ol class="project-steps"><li><b>01</b><div><h3>Ndaj idenë</h3><p>Trego problemin që dëshiron të zgjidhësh.</p></div></li><li><b>02</b><div><h3>Krijo ekipin</h3><p>Gjej njerëz me aftësi të ndryshme që duan të ndihmojnë.</p></div></li><li><b>03</b><div><h3>Gjej mbështetje</h3><p>Kërko burime ose financim nga rrjeti dhe partnerët.</p></div></li><li><b>04</b><div><h3>Fillo</h3><p>Provo një version të vogël, mëso dhe përmirësoje.</p></div></li></ol>
      </section>
      <section class="project-slide project-atlas project-slide-strong" data-background-color="#202225">
        <div class="project-copy"><p class="slide-number">Projekt i rrjetit</p><h2><strong>Atlas:</strong> Mbërrit më i përgatitur në një vend të ri.</h2><div class="project-details"><span>Hapa praktikë</span><span>Përvojë nga diaspora</span><span>Integrim më i lehtë</span></div><a href="https://atlas.illyrianbrains.org/">atlas.illyrianbrains.org</a></div>
        <div class="project-gallery gallery-four" aria-label="Pamje nga platforma Atlas"><img src="/assets/presentation/atlas-1.png?v=3" alt="Faqja kryesore e Atlas" /><img src="/assets/presentation/atlas-2.png?v=3" alt="Informacion praktik në Atlas" /><img src="/assets/presentation/atlas-3.png?v=3" alt="Përmbajtje për vendet në Atlas" /><img src="/assets/presentation/atlas-4.png?v=3" alt="Udhëzime të tjera nga platforma Atlas" /></div>
      </section>
      <section class="project-slide project-mentoring project-slide-strong" data-background-color="#30272e">
        <div class="project-copy"><p class="slide-number">Projekt i rrjetit</p><h2><strong>Mentoring:</strong> Merr drejtim nga dikush që e njeh rrugën.</h2><div class="project-details"><span>Qëllim i qartë</span><span>Mentor i përshtatshëm</span><span>Hapi i radhës</span></div><a href="https://mentoring.illyrianbrains.org/">mentoring.illyrianbrains.org</a></div>
        <div class="project-gallery gallery-four" aria-label="Pamje nga platforma e mentorimit"><img src="/assets/presentation/mentoring-1.png?v=3" alt="Faqja kryesore e platformës së mentorimit" /><img src="/assets/presentation/mentoring-2.png?v=3" alt="Fushat e mentorimit" /><img src="/assets/presentation/mentoring-3.png?v=3" alt="Profile mentorësh në platformë" /><img src="/assets/presentation/mentoring-4.png?v=3" alt="Përmbajtje tjetër nga platforma e mentorimit" /></div>
      </section>
      <section class="project-slide project-heritage project-slide-strong" data-background-color="#26313d">
        <div class="project-copy"><p class="slide-number">Projekt i rrjetit</p><h2><strong>Heritage:</strong> Njih trashëgiminë dhe gjej si ta mbrosh.</h2><div class="project-details"><span>Informacion i qartë</span><span>Organizata aktive</span><span>Mënyra për të vepruar</span></div><a href="https://heritage.illyrianbrains.org/">heritage.illyrianbrains.org</a></div>
        <div class="project-gallery gallery-four" aria-label="Pamje nga platforma e trashëgimisë"><img src="/assets/presentation/heritage-1.png?v=3" alt="Harta e trashëgimisë natyrore" /><img src="/assets/presentation/heritage-2.png?v=3" alt="Dosje nga platforma e trashëgimisë" /><img src="/assets/presentation/heritage-3.png?v=3" alt="Dokumentim në platformën e trashëgimisë" /><img src="/assets/presentation/heritage-4.png?v=3" alt="Përmbajtje tjetër nga platforma e trashëgimisë" /></div>
      </section>
      <section class="project-slide project-locals project-slide-strong" data-background-color="#263433">
        <div class="project-copy"><p class="slide-number">Projekt i rrjetit</p><h2><strong>Locals:</strong> Përjeto vendin përmes njerëzve që e njohin.</h2><div class="project-details"><span>Zgjedhje lokale</span><span>Udhëtim me kuptim</span><span>Njohuri nga komuniteti</span></div><a href="https://locals.illyrianbrains.org/">locals.illyrianbrains.org</a></div>
        <div class="project-gallery gallery-four" aria-label="Pamje nga platforma Locals"><img src="/assets/presentation/locals-1.png?v=3" alt="Katalogu i qyteteve në Locals" /><img src="/assets/presentation/locals-2.png?v=3" alt="Profili i një qyteti në Locals" /><img src="/assets/presentation/locals-3.png?v=3" alt="Ide udhëtimi nga vendasit" /><img src="/assets/presentation/locals-4.png?v=3" alt="Përmbajtje lokale për udhëtarët" /></div>
      </section>
      <section class="closing-slide" data-background-color="#181a1d">
        <h2>Eja në një event.<br /><em>Takohu me rrjetin.</em></h2>
        <div class="closing-actions"><a href="/eventet/">illyrianbrains.org/eventet</a><span>@illyrianbrains</span></div><p class="slide-caption">Faleminderit.</p>
      </section>
      <section class="chapter-slide appendix-title" data-background-color="#2a3036">
        <h2>Appendix</h2>
        <p>Informacion mbështetës për pyetje pas prezantimit.</p>
        <div class="chapter-topics"><span>Prioritetet</span><span>Bordi</span><span>Transparenca</span><span>Misioni</span><span>Burimet</span></div>
      </section>
      <section class="board-slide" data-background-color="#202225">
        <p class="slide-number">Shtojcë · Katër prioritete</p><h2>Katër prioritete.</h2>
        <div class="transparency-grid">
          <article><b>01</b><h3>Qytetet</h3><p>Forcojmë komunitetet lokale dhe eventet periodike.</p></article>
          <article><b>02</b><h3>Anëtarët</h3><p>Rrallëzojmë barrën e prezentimit dhe rrisim lidhjet e vërteta.</p></article>
          <article><b>03</b><h3>Projektet</h3><p>Mundësojmë ide që transformohen në iniciativa të përdorshme.</p></article>
          <article><b>04</b><h3>Ndërgjegjësimi</h3><p>Përforcojmë kulturën e ndihmës, transparencës dhe besimit.</p></article>
        </div>
      </section>
      <section class="board-slide" data-background-color="#202225">
        <p class="slide-number">Shtojcë · Bordi</p><h2>Përgjegjësia për drejtimin e organizatës.</h2>
        {boardMembers.length > 0 ? <div class="board-grid">{boardMembers.map(member => {
          const boardRole = member.teams?.find(team => team.slug === 'bordi')?.role;
          return <article>{member.avatar ? <img src={member.avatar} alt="" /> : <span class="board-avatar">{member.name.split(/\s+/).map(part => part[0]).slice(0, 2).join('')}</span>}<div><h3>{member.name}</h3><p>{boardRole || 'Anëtar i Bordit'}</p><small>{member.title || member.city || 'Illyrian Brains'}</small></div></article>;
        })}</div> : <p class="appendix-empty">Përbërja e Bordit publikohet dhe përditësohet te drejtoria e ekipeve.</p>}
        <a class="appendix-link" href="/ekipet/#bordi">Shiko Bordin e përditësuar</a>
        <aside class="notes">Bordi mban përgjegjësinë për drejtimin dhe vendimmarrjen e organizatës. Lista merret nga drejtoria publike e ekipeve.</aside>
      </section>

      <section class="teams-slide" data-background-color="#202225">
        <p class="slide-number">Ekipet</p><h2>Kush e mban rrjetin në lëvizje?</h2>
        <div class="team-card-grid">{teamProfiles.map((team, index) => <article><span>0{index + 1}</span><h3>{team.name}</h3><p>{team.description}</p><small>{team.members.length} kontribues</small></article>)}</div>
        <aside class="notes">Rrjeti nuk drejtohet nga një person i vetëm. Anëtarët marrin role në ekipe sipas interesit dhe aftësive të tyre.</aside>
      </section>
      <section class="transparency-slide" data-background-color="#202225">
        <p class="slide-number">Shtojcë</p><h2>Transparenca</h2>
        <div class="transparency-grid">
          <article><b>01</b><h3>Deri tani</h3><p>Kontribuesit kanë mbuluar vetë kostot.</p></article>
          <article><b>02</b><h3>Financimi</h3><p>Nuk ka financim të përgjithshëm të rrjetit.</p></article>
          <article><b>03</b><h3>Evente të veçanta</h3><p>Mund të kenë financim vetëm për aktivitetin përkatës.</p></article>
          <article><b>04</b><h3>Llogaridhënia</h3><p>Çdo financim dhe shpenzim raportohet sipas aktivitetit.</p></article>
        </div>
        <div class="transparency-links"><a href="/dhuro/#transparenca">Transparenca financiare</a><a href="https://forum.illyrianbrains.org/tag/raport-vjetor">Raportet vjetore</a><a href="/statuti/">Statuti</a></div>
