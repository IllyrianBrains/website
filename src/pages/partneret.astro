---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/directory.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DirectoryNetworkGraph from '../components/DirectoryNetworkGraph.astro';
import NetworkDirectoryHero from '../components/NetworkDirectoryHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { mailto, emailTemplates } from '../data/emails';
import { partners, partnerCategoryLabels, collaborationTypeOptions } from '../data/partners';
import { cities } from '../data/cities';
import { members } from '../data/members';

const categories = Object.entries(partnerCategoryLabels).map(([id, label]) => ({ id, label }));
const memberByUsername = new Map(members.map(member => [member.username, member]));
const graphPartners = partners.map((partner, index) => ({
  id: `partner-${index}`,
  label: partner.name,
  category: partner.category,
  categories: partner.categories,
  cities: [...new Set([partner.city, ...partner.relatedCities].filter((city): city is string => Boolean(city)))],
  people: partner.relatedMembers.map(username => ({ username, name: memberByUsername.get(username)?.name || `@${username}` })),
  url: partner.website || partner.linkedin || partner.instagram,
}));
const partnerCities = [...new Set(partners.flatMap(partner => [partner.city, ...partner.relatedCities]).filter((city): city is string => Boolean(city)))].sort((a, b) => a.localeCompare(b, 'sq'));
// Always show the standard collaboration options, even ones no NGO has yet.
const collaborationTypes = [...new Set([...collaborationTypeOptions, ...partners.flatMap(partner => partner.collaborationTypes)])];

// Partners record city as free text (from hand-entered data), which doesn't always
// match the name used in cities.csv — e.g. an English exonym ("Rome") vs. the local
// spelling ("Roma"). Normalize and alias known cases so they land on the right marker
// instead of being silently dropped. (Mirrors the matching in harta.astro.)
const normalize = (value: string) => value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
const cityAliases: Record<string, string> = {
  florence: 'firenze', genoa: 'genova', milan: 'milano', rome: 'roma',
  nuremberg: 'nurnberg', 'city of london': 'london', 'greater london': 'london', tirane: 'tirana',
};
const additionalNgoLocations: Record<string, { city: string; country: string; lat: number; lng: number }> = {
  kutine: { city: 'Kutinë', country: 'Kroaci', lat: 45.4750, lng: 16.7819 },
  zagreb: { city: 'Zagreb', country: 'Kroaci', lat: 45.8150, lng: 15.9819 },
  librazhd: { city: 'Librazhd', country: 'Shqipëri', lat: 41.1790, lng: 20.3158 },
};
const cityByKey = new Map<string, (typeof cities)[number]>();
for (const city of cities) {
  const keys = new Set([normalize(city.slug), ...city.city.split('/').map(part => normalize(part))]);
  keys.forEach(key => cityByKey.set(key, city));
}
function matchCity(name?: string) {
  if (!name) return undefined;
  const key = normalize(name);
  return cityByKey.get(cityAliases[key] ?? key);
}

const partnersByCity = new Map<string, { name: string; website?: string }[]>();
const additionalPartnersByCity = new Map<string, { name: string; website?: string }[]>();
let unmappedPartners = 0;
for (const partner of partners) {
  const relatedCityNames = [...new Set([partner.city, ...partner.relatedCities].filter((name): name is string => Boolean(name)))];
  let mapped = false;
  for (const cityName of relatedCityNames) {
    const city = matchCity(cityName);
    if (city) {
      mapped = true;
      const list = partnersByCity.get(city.slug) ?? [];
      if (!list.some(item => item.name === partner.name)) list.push({ name: partner.name, website: partner.website || partner.linkedin || partner.instagram });
      partnersByCity.set(city.slug, list);
      continue;
    }
    const locationKey = normalize(cityName);
    if (!additionalNgoLocations[locationKey]) continue;
    mapped = true;
    const list = additionalPartnersByCity.get(locationKey) ?? [];
    if (!list.some(item => item.name === partner.name)) list.push({ name: partner.name, website: partner.website || partner.linkedin || partner.instagram });
    additionalPartnersByCity.set(locationKey, list);
  }
  if (!mapped) unmappedPartners++;
}
const partnerMapCities = cities
  .map(city => ({ city: city.city, country: city.country, lat: city.lat, lng: city.lng, slug: city.slug, partners: partnersByCity.get(city.slug) ?? [] }))
  .filter(city => city.partners.length > 0)
  .concat([...additionalPartnersByCity.entries()].map(([key, partners]) => ({ ...additionalNgoLocations[key], slug: '', partners })));
---
<BaseLayout title="OJF Partnere · Illyrian Brains" description="Organizatat partnere që bashkëpunojnë me rrjetin Illyrian Brains.">
  <Header />
  <main class="network-page">
    <NetworkDirectoryHero kind="partners" eyebrow="Rrjeti i partnerëve" title="OJF Partnere." description="Organizatat që sjellin ekspertizë, përvojë në terren dhe mundësi të reja bashkëpunimi në komunitetin Illyrian Brains." showVisual={false} />

    <section class="section tone-white"><div class="container">
      <div class="catalog-heading">
        <div><h2>Gjej organizatën e duhur.</h2></div>
        <p><strong>Përdor kërkimin dhe filtrat më poshtë</strong> për të parë OJF-të sipas emrit, kategorisë, qytetit ose bashkëpunimit me IB.</p>
      </div>
      <div class="directory-filters member-filters" aria-label="Filtro katalogun e OJF-ve">
        <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="partner-search" type="search" placeholder="Kërko OJF…" aria-label="Kërko OJF"/></div>
        <select id="partner-category" aria-label="Filtro sipas kategorisë"><option value="">Të gjitha kategoritë</option>{categories.map(category => <option value={category.id}>{category.label}</option>)}</select>
        <select id="partner-city" aria-label="Filtro sipas qytetit"><option value="">Të gjithë qytetet</option>{partnerCities.map(city => <option value={city}>{city}</option>)}</select>
      </div>
      {collaborationTypes.length > 0 && (
        <div class="contribution-filter" aria-label="Filtro sipas bashkëpunimit me IB">
          <span class="eyebrow">Bashkëpunimi me IB</span>
          <div class="contribution-filter-options">
            {collaborationTypes.map(type => <button type="button" class="contribution-chip" data-collaboration-type={type} aria-pressed="false">{type}</button>)}
          </div>
        </div>
      )}
      <p class="directory-result-count" id="partner-result-count"></p>
      <div class="partner-directory-grid">
        {partners.map(partner => (
          <article class="partner-directory-card" data-categories={partner.categories.join('|')} data-cities={[partner.city, ...partner.relatedCities].filter(Boolean).join('|')} data-collaboration-types={partner.collaborationTypes.join('|')} data-search={`${partner.name} ${partner.description} ${partner.city || ''} ${partner.relatedCities.join(' ')} ${partner.relatedMembers.join(' ')} ${partner.collaborationTypes.join(' ')}`.toLocaleLowerCase('sq')}>
            {(partner.city || partner.logo) && (
              <div class="partner-card-top">
                {partner.city && <span class="partner-city">{partner.city}</span>}
                {partner.logo && <img class="partner-logo" src={partner.logo} alt={`Logoja e ${partner.name}`} loading="lazy" />}
              </div>
            )}
            <h3>{partner.name}</h3>
            <p>{partner.description}</p>
            {partner.collaborationTypes.length > 0 && (
              <div class="partner-projects">{partner.collaborationTypes.map(type => <span class="partner-project-tag">{type}</span>)}</div>
            )}
            <div class="partner-links">
              {partner.website && <a href={partner.website} target="_blank" rel="noreferrer">Faqja zyrtare <span aria-hidden="true">↗</span></a>}
              {partner.linkedin && <a href={partner.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
              {partner.instagram && <a href={partner.instagram} target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>}
            </div>
            {partner.sponsor && <span class="sponsor-star" role="img" aria-label="Sponsor" title="Sponsor">★</span>}
          </article>
        ))}
      </div>
      <p class="directory-empty" id="partner-empty" hidden>Asnjë OJF nuk përputhet me filtrat.</p>
    </div></section>

    <section class="section tone-grey"><div class="container">
      <div class="partner-network">
        <DirectoryNetworkGraph kind="partner" title="Organizatat që na lidhin." description="Eksploro si organizatat partnere lidhen me Illyrian Brains, përmes fushave të bashkëpunimit dhe anëtarëve." categories={categories} items={graphPartners} />
      </div>
    </div></section>

    <section class="section tone-white"><div class="container">
      <div class="community-map-heading">
        <div><p class="eyebrow">Ku ndodhen</p><h2>OJF-të në hartë.</h2></div>
        <p>Organizatat partnere të rrjetit, sipas qytetit ku janë të vendosura.</p>
      </div>
      <div class="community-map-layout">
        <div id="community-map" data-cities={JSON.stringify(partnerMapCities)} aria-label="Harta e organizatave partnere të Illyrian Brains, sipas qytetit"></div>
      </div>
      {unmappedPartners > 0 && (
        <p class="map-footnote">{unmappedPartners} OJF nuk k{unmappedPartners === 1 ? 'a' : 'anë'} qytet të specifikuar dhe nuk shfaqet në hartë.</p>
      )}
    </div></section>
    <section class="section tone-grey" id="bashkepuno"><div class="container">
      <SectionTitle kicker="Bashkëpuno si OJF" title="Bashkëpuno me rrjetin." text="Krijo me ne evente, projekte ose shkëmbime ekspertize. Na prezanto organizatën dhe idenë, dhe e përcaktojmë së bashku bashkëpunimin." />
      <div class="focus-card collab-note">
        <h3>Bashkëpunime të mundshme</h3>
        <ul>
          <li><strong>Rrjetëzim</strong> — prezantime të ndërsjella me anëtarët dhe qytetet tona.</li>
          <li><strong>Event i përbashkët</strong> — takime, panele ose workshop-e në një nga qytetet e rrjetit.</li>
          <li><strong>Projekt i përbashkët</strong> — nisma afatgjata me qëllime të përbashkëta.</li>
          <li><strong>Projektet e rrjetit</strong> — bashkëpunim në Atlas, Mentorim ose Heritage.</li>
          <li><strong>Donacione</strong> — mbështetje për fondet dhe projektet e rrjetit.</li>
        </ul>
      </div>
      <a class="partner-button" href={mailto(emailTemplates.partnerNgo)}>Prezanto OJF-në <span aria-hidden="true">→</span></a>
    </div></section>
  </main>
  <Footer />
</BaseLayout>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  const partnerMapElement = document.querySelector('#community-map');
  if (partnerMapElement && window.L) {
    const cityData = JSON.parse(partnerMapElement.dataset.cities || '[]');
    const map = L.map(partnerMapElement, { scrollWheelZoom: true, doubleClickZoom: true, touchZoom: true, zoomControl: true }).setView([44, 8], 3);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    const popupHtml = (city) => {
      const orgList = `<ul class="map-popup-orgs">${city.partners.map((p) => `<li>${p.website ? `<a href="${p.website}" target="_blank" rel="noreferrer">${p.name}</a>` : p.name}</li>`).join('')}</ul>`;
      return `<div class="map-popup"><strong>${city.city}</strong><span>${city.country}</span><small>${city.partners.length} OJF</small>${orgList}${city.slug ? `<a class="map-popup-link" href="/qytetet/${city.slug}/">Shiko qytetin ↗</a>` : ''}</div>`;
    };
    const markers = cityData.map((city) => L.circleMarker([city.lat, city.lng], {
      radius: Math.min(22, 8 + Math.sqrt(city.partners.length) * 4), color: '#fff', weight: 2, opacity: .9, fillColor: '#b98545', fillOpacity: .85
    })
      .bindTooltip(`<div class="map-city-tooltip"><strong>${city.city}</strong><span>${city.partners.length} OJF</span></div>`, { direction: 'top', offset: [0, -10], opacity: .96 })
      .bindPopup(popupHtml(city))
      .addTo(map));
    if (markers.length) map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [40, 40] });
  }
</script>
<style>
  .collab-note{max-width:760px;margin-top:28px}.collab-note strong{color:var(--ink);font-weight:700}
  .community-map-heading h2 { font-size: clamp(38px, 5vw, 58px); }
  .map-footnote { max-width: 68ch; margin-top: 18px; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .map-popup-orgs { display: flex; flex-direction: column; gap: 4px; margin: 8px 0 0; padding: 8px 0 0; border-top: 1px solid var(--line); list-style: none; }
  .map-popup-orgs li { font-size: 12px; }
  .map-popup-orgs a { color: var(--accent-dark); font-weight: 700; }
</style>
<script>
  const search=document.querySelector<HTMLInputElement>('#partner-search'),category=document.querySelector<HTMLSelectElement>('#partner-category'),city=document.querySelector<HTMLSelectElement>('#partner-city'),collaborationChips=[...document.querySelectorAll<HTMLButtonElement>('.contribution-chip')],count=document.querySelector<HTMLElement>('#partner-result-count'),empty=document.querySelector<HTMLElement>('#partner-empty'),cards=[...document.querySelectorAll<HTMLElement>('.partner-directory-card')];
  const selectedCollaborations=new Set<string>();
  const filterPartners=()=>{const query=(search?.value||'').trim().toLocaleLowerCase('sq'),selectedCategory=category?.value||'',selectedCity=city?.value||'';let visible=0;cards.forEach(card=>{const cardCollaborations=(card.dataset.collaborationTypes||'').split('|').filter(Boolean),cardCities=(card.dataset.cities||'').split('|').filter(Boolean);const show=(!query||(card.dataset.search||'').includes(query))&&(!selectedCategory||(card.dataset.categories||'').split('|').includes(selectedCategory))&&(!selectedCity||cardCities.includes(selectedCity))&&(selectedCollaborations.size===0||cardCollaborations.some(type=>selectedCollaborations.has(type)));card.hidden=!show;if(show)visible++});if(count)count.textContent=`${visible} ${visible===1?'OJF u gjet':'OJF u gjetën'}`;if(empty)empty.hidden=visible>0};
  search?.addEventListener('input',filterPartners);category?.addEventListener('change',filterPartners);city?.addEventListener('change',filterPartners);
  collaborationChips.forEach(chip=>chip.addEventListener('click',()=>{const type=chip.dataset.collaborationType||'';if(selectedCollaborations.has(type))selectedCollaborations.delete(type);else selectedCollaborations.add(type);chip.classList.toggle('is-active',selectedCollaborations.has(type));chip.setAttribute('aria-pressed',String(selectedCollaborations.has(type)));filterPartners()}));
  filterPartners();
</script>
