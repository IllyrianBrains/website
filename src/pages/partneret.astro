  .directory-filters{display:grid;grid-template-columns:minmax(240px,1fr) repeat(2,minmax(180px,240px));margin-bottom:14px;padding:18px;border:1px solid rgba(116,71,97,.2);border-radius:14px;background:var(--soft)}.directory-filters>*{min-width:0}.directory-filters select{width:100%}.directory-result-count{margin:0 0 34px;color:var(--muted);font-size:13px}.directory-empty{margin:35px 0;color:var(--muted)}.partner-directory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.partner-directory-card{position:relative;display:flex;min-height:174px;flex-direction:column;padding:26px 28px;border:1px solid var(--line);border-left:4px solid var(--card-accent,#744761);border-radius:8px;background:var(--card-bg,#fff);box-shadow:0 8px 24px rgba(23,24,29,.04)}.partner-directory-card[hidden]{display:none}.partner-city{align-self:flex-start;padding:5px 8px;border-radius:4px;color:var(--ink);background:rgba(255,255,255,.72);font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.partner-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.partner-logo{height:48px;max-width:120px;margin-left:auto;padding:4px;border-radius:6px;background:#fff;object-fit:contain}.partner-directory-card h3{margin:14px 0 7px;font-size:20px;font-weight:400;line-height:1.15}.partner-directory-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.partner-links{display:flex;flex-wrap:wrap;gap:15px;margin-top:auto;padding:14px 34px 0 0}.partner-links a{color:var(--accent-dark);font-size:12px;font-weight:700}.partner-links a:hover{text-decoration:underline;text-underline-offset:3px}.sponsor-star{position:absolute;right:18px;bottom:16px;color:#b67a16;font-size:21px;line-height:1;text-shadow:0 1px 0 #fff}@media(max-width:980px){.partner-directory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.catalog-heading{grid-template-columns:1fr;gap:18px}.directory-filters{grid-template-columns:1fr}}@media(max-width:700px){.partner-directory-grid{grid-template-columns:1fr}.partner-directory-card{min-height:160px}}
  .partner-projects{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
  .partner-project-tag{padding:4px 9px;border-radius:999px;color:var(--card-accent,#744761);background:rgba(116,71,97,.09);font-size:10px;font-weight:700}
  .contribution-filter{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-bottom:18px;padding:14px 18px;border:1px solid var(--line);border-radius:14px;background:#fff}.contribution-filter>.eyebrow{margin:0}.contribution-filter-options{display:flex;flex-wrap:wrap;gap:8px}.contribution-chip{padding:8px 14px;border:1px solid var(--line);border-radius:999px;color:var(--muted);background:#fff;font:700 12px var(--font-body);cursor:pointer;transition:.18s ease}.contribution-chip.is-active{color:#fff;border-color:var(--ink);background:var(--ink)}
</style>
