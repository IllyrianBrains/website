---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Guidelines from '../components/Guidelines.astro';
import { members } from '../data/members';

const forumGroups = [
  { forum: 'Bordi', label: 'Bordi', description: 'Anëtarët që mbajnë përgjegjësinë për drejtimin dhe vendimmarrjen e organizatës.' },
  { forum: 'Qytetet', label: 'Staff Qytetet', description: 'Organizatorët që ndërtojnë komunitetet lokale dhe kujdesen për aktivitetet në qytetet e rrjetit.' },
  { forum: 'Nismat', label: 'Staff Nismat', description: 'Kontribuesit që zhvillojnë dhe mbështesin nismat e përbashkëta të komunitetit.' },
  { forum: 'Ekipet', label: 'Staff Ekipet', description: 'Njerëzit që mbështesin punën e brendshme dhe bashkëpunimin mes ekipeve.' },
];
const names = forumGroups.map(group => group.forum);
const team = members.filter(member => member.groups.some(group => names.includes(group))).map(member => ({ ...member, groups: member.groups.filter(group => names.includes(group)) }));
const teamCities = [...new Set(team.map(member => member.city).filter((city): city is string => Boolean(city)))].sort((a,b) => a.localeCompare(b,'sq'));

// Staff Qytetet is one organizer per city across the whole network — a flat
// grid buries who covers which city, so it groups by city instead of the flat
// name-sorted grid the other, smaller groups use.
const NO_CITY = 'Qytet i paspecifikuar';
const groupByCity = (list: typeof team) => {
  const buckets = new Map<string, typeof team>();
  list.forEach(member => {
    const key = member.city || NO_CITY;
    if (!buckets.has(key)) buckets.set(key, []);
    buckets.get(key)!.push(member);
  });
  return [...buckets.entries()]
    .map(([city, cityMembers]) => ({ city, members: cityMembers.sort((a,b) => a.name.localeCompare(b.name,'sq')) }))
    .sort((a,b) => a.city === NO_CITY ? 1 : b.city === NO_CITY ? -1 : a.city.localeCompare(b.city,'sq'));
};
---
<BaseLayout title="Ekipet · Illyrian Brains" description="Njih Bordin dhe stafet aktive të Illyrian Brains, sipas grupeve publike të forumit.">
  <Header />
  <main class="about-page team-directory-page">
    <section class="section tone-dark team-hero"><div class="container team-hero-layout">
      <div><p class="eyebrow">Njerëzit pas rrjetit</p><h1>Ekipet</h1><p class="about-body">Këtu gjenden anëtarët e Bordit dhe stafet që kujdesen për qytetet, nismat dhe ekipet e Illyrian Brains.</p></div>
      <div class="team-summary" aria-label="Grupet e ekipeve">{forumGroups.map(group => <div><strong>{members.filter(member => member.groups.includes(group.forum)).length}</strong><span>{group.label}</span></div>)}</div>
    </div></section>

    <section class="section tone-white team-directory-intro" id="drejtoria-e-ekipeve"><div class="container">
      <header class="team-directory-heading"><div><p class="eyebrow">Katalogu i ekipeve</p><h2>Njerëzit që e bëjnë punën të mundur.</h2></div><p>Çdo grup paraqitet më poshtë me të gjithë anëtarët e tij, sipas të dhënave publike të forumit.</p></header>
      <div class="member-filters team-filters">
        <div class="member-search team-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="team-search" type="search" placeholder="Kërko një person…" aria-label="Kërko në ekipe"/></div>
        <select id="team-group" aria-label="Filtro sipas grupit"><option value="">Të gjitha grupet</option>{forumGroups.map(group => <option value={group.forum}>{group.label}</option>)}</select>
        <select id="team-city" aria-label="Filtro sipas qytetit"><option value="">Të gjithë qytetet</option>{teamCities.map(city => <option value={city}>{city}</option>)}</select>
      </div>
      <p class="result-count" id="team-result-count">{team.length} anëtarë të veçantë</p>
    </div></section>
    <div id="team-sections" data-team={JSON.stringify(team)} data-labels={JSON.stringify(Object.fromEntries(forumGroups.map(group => [group.forum, group.label])))}>
      {forumGroups.map((group, index) => {
        const groupMembers = members.filter(member => member.groups.includes(group.forum)).sort((a,b) => a.name.localeCompare(b.name,'sq'));
        const renderCard = (member: typeof groupMembers[number]) => <button class="member-card team-member-card" type="button" data-username={member.username} data-city={member.city || ''} data-search={(member.name + ' ' + member.username).toLocaleLowerCase('sq')}><div class="member-card-top">{member.avatar ? <img class="member-avatar" src={member.avatar} alt="" loading="lazy"/> : <span class="member-avatar member-avatar-fallback">{member.name.split(' ').map(part=>part[0]).join('').slice(0,2).toUpperCase()}</span>}<div><p class="member-card-name">{member.name}</p><p class="member-card-role">{member.title || member.fieldsOfExpertise?.join(' · ') || `@${member.username}`}</p></div></div><div class="member-card-meta"><span class="member-pill member-pill-accent">{group.label}</span>{member.city && <span class="member-pill">{member.city}</span>}</div><span class="member-card-action">Shiko profilin <span aria-hidden="true">→</span></span></button>;
        return <section class:list={['section','team-group-section',index % 2 === 0 ? 'tone-grey' : 'tone-white']} data-group-section data-group={group.forum}><div class="container">
          <header class="team-group-heading"><div><p class="eyebrow">{String(index + 1).padStart(2,'0')} · Ekipi</p><h2>{group.label}</h2></div><div><strong data-group-count>{groupMembers.length}</strong><p>{group.description}</p></div></header>
          {group.forum === 'Qytetet' ? (
            <div class="team-city-groups">{groupByCity(groupMembers).map(cityGroup => (
              <div class="team-city-group" data-city-group>
                <h3 class="team-city-heading">{cityGroup.city}<span>{cityGroup.members.length}</span></h3>
                <div class="member-grid team-member-grid">{cityGroup.members.map(renderCard)}</div>
              </div>
            ))}</div>
          ) : (
            <div class="member-grid team-member-grid">{groupMembers.map(renderCard)}</div>
          )}
          <p class="member-empty team-group-empty" hidden>Asnjë anëtar i këtij grupi nuk përputhet me kërkimin.</p>
        </div></section>;
      })}
    </div>
    <section class="section tone-grey team-principles"><div class="container city-page"><Guidelines /></div></section>
  </main>
  <Footer />
  <div class="member-drawer-overlay" id="team-overlay"></div><aside class="member-drawer" id="team-drawer" aria-hidden="true"><div class="member-drawer-inner" id="team-drawer-content"></div></aside>
</BaseLayout>

<script>
  const sections=document.querySelector<HTMLElement>('#team-sections'),search=document.querySelector<HTMLInputElement>('#team-search'),groupFilter=document.querySelector<HTMLSelectElement>('#team-group'),cityFilter=document.querySelector<HTMLSelectElement>('#team-city'),count=document.querySelector<HTMLElement>('#team-result-count'),overlay=document.querySelector<HTMLElement>('#team-overlay'),drawer=document.querySelector<HTMLElement>('#team-drawer'),content=document.querySelector<HTMLElement>('#team-drawer-content');
  if(sections){const team=JSON.parse(sections.dataset.team||'[]'),labels=JSON.parse(sections.dataset.labels||'{}');const initials=(name:string)=>name.split(' ').map((part:string)=>part[0]).join('').slice(0,2).toUpperCase();const render=()=>{const query=(search?.value||'').trim().toLocaleLowerCase('sq'),selectedGroup=groupFilter?.value||'',selectedCity=cityFilter?.value||'',visibleUsers=new Set<string>();sections.querySelectorAll<HTMLElement>('[data-group-section]').forEach(section=>{const sectionSelected=!selectedGroup||section.dataset.group===selectedGroup;section.hidden=!sectionSelected;if(!sectionSelected)return;let groupVisible=0;section.querySelectorAll<HTMLElement>('.team-member-card').forEach(card=>{const show=(!query||(card.dataset.search||'').includes(query))&&(!selectedCity||card.dataset.city===selectedCity);card.hidden=!show;if(show){groupVisible++;if(card.dataset.username)visibleUsers.add(card.dataset.username)}});section.querySelectorAll<HTMLElement>('[data-city-group]').forEach(cityGroup=>{cityGroup.hidden=!cityGroup.querySelector('.team-member-card:not([hidden])')});const groupCount=section.querySelector<HTMLElement>('[data-group-count]');if(groupCount)groupCount.textContent=String(groupVisible);const empty=section.querySelector<HTMLElement>('.team-group-empty');if(empty)empty.hidden=groupVisible>0});const active=Boolean(query||selectedGroup||selectedCity);if(count)count.textContent=active?`${visibleUsers.size} anëtar${visibleUsers.size===1?'':'ë'} u gjet${visibleUsers.size===1?'':'ën'}`:`${team.length} anëtarë të veçantë`};const close=()=>{drawer?.classList.remove('open');overlay?.classList.remove('open');drawer?.setAttribute('aria-hidden','true');document.body.style.overflow=''};sections.addEventListener('click',event=>{const username=(event.target as HTMLElement).closest<HTMLElement>('.team-member-card')?.dataset.username,member=team.find((item:any)=>item.username===username);if(!member||!drawer||!overlay||!content)return;content.innerHTML=`<button class="member-drawer-close" type="button" aria-label="Mbyll profilin">✕</button>${member.avatar?`<img class="member-drawer-avatar" src="${member.avatar}" alt="">`:`<span class="member-drawer-avatar member-avatar-fallback">${initials(member.name)}</span>`}<p class="team-profile-group">${member.groups.map((value:string)=>labels[value]||value).join(' · ')}</p><h2>${member.name}</h2><p class="member-drawer-role">@${member.username}</p>${member.bio?`<p class="member-drawer-bio">${member.bio}</p>`:''}<div class="member-tags">${member.city?`<span class="member-pill">${member.city}</span>`:''}<span class="member-pill">Anëtar që nga ${member.since}</span></div><div class="member-drawer-actions">${member.website?`<a class="partner-button" href="${member.website}" target="_blank" rel="noreferrer">Faqja personale <span aria-hidden="true">↗</span></a>`:''}${member.linkedin?`<a class="partner-button" href="${member.linkedin}" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>`:''}${member.profileUrl?`<a class="partner-button" href="${member.profileUrl}" target="_blank" rel="noreferrer">Shiko profilin në forum <span aria-hidden="true">↗</span></a>`:''}</div>`;drawer.classList.add('open');overlay.classList.add('open');drawer.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';content.querySelector('.member-drawer-close')?.addEventListener('click',close)});search?.addEventListener('input',render);groupFilter?.addEventListener('change',render);cityFilter?.addEventListener('change',render);overlay?.addEventListener('click',close);document.addEventListener('keydown',event=>{if(event.key==='Escape')close()});render()}
</script>

<style>
  .team-directory-intro{padding-bottom:72px}.team-filters{grid-template-columns:minmax(250px,1fr) minmax(180px,240px) minmax(180px,240px)}.team-group-section{border-top:1px solid var(--line)}.team-group-section[hidden]{display:none}.team-group-heading{display:grid;grid-template-columns:1fr minmax(320px,520px);gap:55px;align-items:end;margin-bottom:44px}.team-group-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.08}.team-group-heading>div:last-child{display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:start}.team-group-heading strong{font-family:var(--font-display);font-size:44px;font-weight:400;line-height:1}.team-group-heading p{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.team-member-card[hidden]{display:none}.team-group-empty{margin-top:24px}
  .team-city-groups{display:flex;flex-direction:column;gap:36px}.team-city-group[hidden]{display:none}.team-city-heading{display:flex;align-items:baseline;gap:10px;margin:0 0 18px;font-size:15px;font-weight:700;letter-spacing:.02em}.team-city-heading span{color:var(--muted);font-weight:600;font-size:13px}
  .team-hero-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(50px,8vw,110px);align-items:end}.team-hero h1{margin:0 0 24px;font-size:clamp(52px,7vw,82px);font-weight:300}.team-summary{display:grid;grid-template-columns:repeat(2,1fr);border:1px solid #ffffff24}.team-summary div{padding:24px}.team-summary div:nth-child(even){border-left:1px solid #ffffff24}.team-summary div:nth-child(n+3){border-top:1px solid #ffffff24}.team-summary strong,.team-summary span{display:block}.team-summary strong{font-family:var(--font-display);font-size:38px;font-weight:400}.team-summary span{margin-top:7px;color:#ffffffb0;font-size:13px;line-height:1.4}.team-directory-heading{display:grid;grid-template-columns:1fr minmax(300px,470px);gap:55px;align-items:end;margin-bottom:42px}.team-directory-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.08}.team-directory-heading>p{margin:0;color:var(--muted);font-size:18px;line-height:1.75}.team-member-grid{grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:16px;margin-top:0}.team-member-card{min-height:180px;padding:20px;border-radius:14px;background:#fff;box-shadow:0 10px 28px rgba(23,24,29,.04)}.team-member-card .member-card-top{gap:13px}.team-member-card .member-avatar{width:52px;height:52px;font-size:14px}.team-member-card .member-card-name{font-size:16px}.team-profile-group{margin:0 0 6px;color:var(--accent);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.team-principles .info-section{margin-top:0}@media(max-width:850px){.team-hero-layout,.team-directory-heading,.team-group-heading{grid-template-columns:1fr}.team-summary{margin-top:15px}.team-filters{grid-template-columns:1fr 1fr}.team-search{grid-column:1/-1}}@media(max-width:560px){.team-filters{grid-template-columns:1fr}.team-search{grid-column:auto}.team-member-grid{grid-template-columns:1fr}.team-member-card{min-height:0;gap:12px;padding:16px}.team-member-card .member-avatar{width:46px;height:46px}.team-member-card .member-card-meta{gap:6px}.team-member-card .member-card-action{padding-top:12px}}@media(max-width:420px){.team-summary{grid-template-columns:1fr}.team-summary div:nth-child(even){border-left:0}.team-summary div+div{border-top:1px solid #ffffff24}.team-group-heading>div:last-child{grid-template-columns:1fr}}
</style>
