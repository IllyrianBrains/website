---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/directory.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { members, cityAliases } from '../data/members';
import { teams } from '../data/teams';

// One section per team (Supabase `teams`, in their sort order — Bordi first),
// then the city organizers (membership type "Organizator"). The sections are
// drawn in the browser: first from the build-time snapshot, then from live
// Supabase data, so team changes made on /anetaresohu/profili/ show without a redeploy.
// Publishable key: meant to be public, it can only read public data (supabase/002-editing.sql).
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
const snapshot = members.filter(member => member.teams?.length || member.membershipType === 'Organizator');
---
<BaseLayout title="Ekipet · Illyrian Brains" description="Njih Bordin, ekipet dhe organizatorët e qyteteve të Illyrian Brains.">
  <Header />
  <main class="about-page team-directory-page">
    <section class="section tone-dark team-hero"><div class="container team-hero-layout">
      <div><p class="eyebrow">Njerëzit pas rrjetit</p><h1>Ekipet</h1><p class="about-body">Këtu gjenden anëtarët e Bordit, kontribuesit e çdo ekipi dhe organizatorët që kujdesen për qytetet e Illyrian Brains.</p></div>
      <div class="team-summary" id="team-summary" aria-label="Grupet e ekipeve"></div>
    </div></section>

    <section class="section tone-white team-directory-intro" id="drejtoria-e-ekipeve"><div class="container">
      <header class="team-directory-heading"><div><p class="eyebrow">Katalogu i ekipeve</p><h2>Njerëzit që e bëjnë punën të mundur.</h2></div><p>Çdo ekip paraqitet më poshtë me të gjithë kontribuesit e tij; drejtuesit e ekipit shfaqen të parët.</p></header>
      <div class="member-filters team-filters">
        <div class="member-search team-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="team-search" type="search" placeholder="Kërko një person…" aria-label="Kërko në ekipe"/></div>
        <select id="team-group" aria-label="Filtro sipas grupit"><option value="">Të gjitha grupet</option></select>
        <select id="team-city" aria-label="Filtro sipas qytetit"><option value="">Të gjithë qytetet</option></select>
      </div>
      <p class="result-count" id="team-result-count"></p>
    </div></section>
    <div id="team-sections" data-teams={JSON.stringify(teams)} data-members={JSON.stringify(snapshot)} data-city-aliases={JSON.stringify(cityAliases)} data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}></div>
  </main>
  <Footer />
  <div class="member-drawer-overlay" id="team-overlay"></div><aside class="member-drawer" id="team-drawer" aria-hidden="true"><div class="member-drawer-inner" id="team-drawer-content"></div></aside>
</BaseLayout>

<script>
  const sections=document.querySelector<HTMLElement>('#team-sections'),summary=document.querySelector<HTMLElement>('#team-summary'),search=document.querySelector<HTMLInputElement>('#team-search'),groupFilter=document.querySelector<HTMLSelectElement>('#team-group'),cityFilter=document.querySelector<HTMLSelectElement>('#team-city'),count=document.querySelector<HTMLElement>('#team-result-count'),overlay=document.querySelector<HTMLElement>('#team-overlay'),drawer=document.querySelector<HTMLElement>('#team-drawer'),content=document.querySelector<HTMLElement>('#team-drawer-content');
  if(sections){
  const ORGANIZERS='organizatore';
  let team:any[]=[],labels:Record<string,string>={};
  const initials=(name:string)=>name.split(' ').map((part:string)=>part[0]).join('').slice(0,2).toUpperCase();const escapeHtml=(value:string)=>String(value).replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]||character));const safeUrl=(value:string)=>/^https?:\/\//i.test(value)?encodeURI(value):'#';
  const isLead=(member:any,key:string)=>Boolean(member.teams?.some((t:any)=>t.slug===key&&t.role==='Drejtues'));
  const teamLabel=(member:any,value:string)=>`${labels[value]||value}${isLead(member,value)?' (Drejtues)':''}`;
  const refreshFilter=(select:HTMLSelectElement|null,options:[string,string][])=>{if(!select)return;const current=select.value;select.replaceChildren(select.options[0],...options.map(([value,label])=>new Option(label,value)));select.value=options.some(([value])=>value===current)?current:''};
  // Draws every section from a list of teams + member profiles (snapshot or live).
  const build=(teams:any[],members:any[])=>{
    const pageGroups=[...teams.map((t:any)=>({key:t.slug,label:t.name,description:t.description||''})),{key:ORGANIZERS,label:'Organizatorët e qyteteve',description:'Organizatorët që ndërtojnë komunitetet lokale dhe kujdesen për aktivitetet në qytetet e rrjetit.'}];
    labels=Object.fromEntries(pageGroups.map(group=>[group.key,group.label]));
    // `groups` here = the page sections a person appears in.
    team=members.map((member:any)=>({...member,groups:[...(member.teams||[]).map((t:any)=>t.slug).filter((slug:string)=>labels[slug]),...(member.membershipType==='Organizator'?[ORGANIZERS]:[])]})).filter((member:any)=>member.groups.length);
    const renderCard=(member:any,group:any)=>`<button class="member-card team-member-card" type="button" data-username="${escapeHtml(member.username)}" data-city="${escapeHtml(member.city||'')}" data-search="${escapeHtml((member.name+' '+member.username+' '+(member.specialty||[]).join(' ')).toLocaleLowerCase('sq'))}"><div class="member-card-top">${member.avatar?`<img class="member-avatar" src="${escapeHtml(member.avatar)}" alt="" loading="lazy"/>`:`<span class="member-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<div><p class="member-card-name">${escapeHtml(member.name)}</p><p class="member-card-role">${escapeHtml(member.title||member.fieldsOfExpertise?.join(' · ')||`@${member.username}`)}</p></div></div><div class="member-card-meta"><span class="member-pill member-pill-accent">${escapeHtml(group.label)}</span>${isLead(member,group.key)?'<span class="member-pill member-pill-gold">Drejtues</span>':''}${(member.specialty||[]).map((value:string)=>`<span class="member-pill member-pill-specialty">${escapeHtml(value)}</span>`).join('')}${member.city?`<span class="member-pill member-pill-location">${escapeHtml(member.city)}</span>`:''}</div><span class="member-card-action">Shiko profilin <span aria-hidden="true">→</span></span></button>`;
    sections.innerHTML=pageGroups.map((group,index)=>{
      const groupMembers=team.filter(member=>member.groups.includes(group.key)).sort((a,b)=>Number(isLead(b,group.key))-Number(isLead(a,group.key))||a.name.localeCompare(b.name,'sq'));
      const organizers=group.key===ORGANIZERS;
      return `<section class="section team-group-section ${index%2===0?'tone-grey':'tone-white'}" data-group-section data-group="${escapeHtml(group.key)}" id="${escapeHtml(group.key)}"><div class="container"><header class="team-group-heading"><div><p class="eyebrow">${String(index+1).padStart(2,'0')} · ${organizers?'Qytetet':'Ekipi'}</p><h2>${escapeHtml(group.label)}</h2></div><div><strong data-group-count>${groupMembers.length}</strong><p>${escapeHtml(group.description)}</p></div></header><div class="member-grid team-member-grid"${organizers?' data-row-collapsible="true"':''}>${groupMembers.map(member=>renderCard(member,group)).join('')}</div>${organizers?'<button type="button" class="team-more-toggle" data-more-toggle hidden>Shfaq të gjithë stafin <span aria-hidden="true">↓</span></button>':''}<p class="member-empty team-group-empty" hidden>Asnjë anëtar i këtij grupi nuk përputhet me kërkimin.</p></div></section>`;
    }).join('');
    if(summary)summary.innerHTML=pageGroups.map(group=>`<div><strong>${team.filter(member=>member.groups.includes(group.key)).length}</strong><span>${escapeHtml(group.label)}</span></div>`).join('');
    refreshFilter(groupFilter,pageGroups.map(group=>[group.key,group.label]));
    refreshFilter(cityFilter,[...new Set<string>(team.map(member=>member.city).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'sq')).map(city=>[city,city]));
    sections.querySelectorAll<HTMLButtonElement>('[data-more-toggle]').forEach(toggle=>toggle.addEventListener('click',()=>{const grid=toggle.previousElementSibling as HTMLElement|null;if(grid)grid.dataset.expanded='true';toggle.hidden=true;render()}));
    measureRowLimits();render();
    // Keep #tech-style links working once the sections exist.
    if(location.hash&&!sections.dataset.scrolled){sections.dataset.scrolled='true';document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView()}
  };
  const measureRowLimits=()=>{sections.querySelectorAll<HTMLElement>('[data-row-collapsible]').forEach(grid=>{const cards=[...grid.querySelectorAll<HTMLElement>('.team-member-card')];const columns=getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length||1;const limit=columns*2;cards.forEach((card,i)=>{card.dataset.beyondLimit=i>=limit?'true':'false'});const toggle=grid.nextElementSibling as HTMLButtonElement|null;const hiddenCount=Math.max(cards.length-limit,0);if(toggle?.hasAttribute('data-more-toggle'))toggle.textContent=`Shfaq të gjithë stafin (${hiddenCount} më shumë)`})};const render=()=>{const query=(search?.value||'').trim().toLocaleLowerCase('sq'),selectedGroup=groupFilter?.value||'',selectedCity=cityFilter?.value||'',filtering=Boolean(query||selectedCity),visibleUsers=new Set<string>();sections.querySelectorAll<HTMLElement>('[data-group-section]').forEach(section=>{const sectionSelected=!selectedGroup||section.dataset.group===selectedGroup;section.hidden=!sectionSelected;if(!sectionSelected)return;let groupVisible=0;section.querySelectorAll<HTMLElement>('.team-member-card').forEach(card=>{const show=(!query||(card.dataset.search||'').includes(query))&&(!selectedCity||card.dataset.city===selectedCity);const grid=card.closest<HTMLElement>('[data-row-collapsible]');const beyondLimit=!!grid&&card.dataset.beyondLimit==='true'&&grid.dataset.expanded!=='true'&&!filtering;card.hidden=!show||beyondLimit;if(show){groupVisible++;if(card.dataset.username)visibleUsers.add(card.dataset.username)}});const groupCount=section.querySelector<HTMLElement>('[data-group-count]');if(groupCount)groupCount.textContent=String(groupVisible);const empty=section.querySelector<HTMLElement>('.team-group-empty');if(empty)empty.hidden=groupVisible>0});sections.querySelectorAll<HTMLButtonElement>('[data-more-toggle]').forEach(toggle=>{const grid=toggle.previousElementSibling as HTMLElement|null;const beyondCount=grid?[...grid.querySelectorAll<HTMLElement>('.team-member-card')].filter(card=>card.dataset.beyondLimit==='true').length:0;toggle.hidden=filtering||beyondCount===0||grid?.dataset.expanded==='true'});const active=Boolean(query||selectedGroup||selectedCity);if(count)count.textContent=active?`${visibleUsers.size} anëtar${visibleUsers.size===1?'':'ë'} u gjet${visibleUsers.size===1?'':'ën'}`:`${team.length} anëtarë të veçantë`};const close=()=>{drawer?.classList.remove('open');overlay?.classList.remove('open');drawer?.setAttribute('aria-hidden','true');document.body.style.overflow=''};sections.addEventListener('click',event=>{const target=event.target as HTMLElement;if(target.closest('[data-more-toggle]'))return;const username=target.closest<HTMLElement>('.team-member-card')?.dataset.username,member=team.find((item:any)=>item.username===username);if(!member||!drawer||!overlay||!content)return;content.innerHTML=`<button class="member-drawer-close" type="button" aria-label="Mbyll profilin">✕</button>${member.avatar?`<img class="member-drawer-avatar" src="${escapeHtml(member.avatar)}" alt="">`:`<span class="member-drawer-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<p class="team-profile-group">${member.groups.map((value:string)=>escapeHtml(teamLabel(member,value))).join(' · ')}</p><h2>${escapeHtml(member.name)}</h2><p class="member-drawer-role">${escapeHtml(member.title||`@${member.username}`)}</p>${member.bio?`<p class="member-drawer-bio">${escapeHtml(member.bio)}</p>`:''}<div class="member-tags">${member.membershipType?`<span class="member-pill member-pill-gold">${escapeHtml(member.membershipType)}</span>`:''}${(member.specialty||[]).map((value:string)=>`<span class="member-pill member-pill-specialty">${escapeHtml(value)}</span>`).join('')}${member.city?`<span class="member-pill member-pill-location">${escapeHtml(member.city)}</span>`:''}</div><div class="member-drawer-actions"><a class="partner-button" href="/anetaret/?search=${encodeURIComponent(member.username)}">Profili i plotë <span aria-hidden="true">→</span></a>${member.linkedinUrl?`<a class="partner-button" href="${safeUrl(member.linkedinUrl)}" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>`:''}${member.website?`<a class="partner-button" href="${safeUrl(member.website)}" target="_blank" rel="noreferrer">Faqja personale <span aria-hidden="true">↗</span></a>`:''}</div>`;drawer.classList.add('open');overlay.classList.add('open');drawer.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';content.querySelector('.member-drawer-close')?.addEventListener('click',close)});let resizeTimer:number;window.addEventListener('resize',()=>{window.clearTimeout(resizeTimer);resizeTimer=window.setTimeout(()=>{measureRowLimits();render()},120)});search?.addEventListener('input',render);groupFilter?.addEventListener('change',render);cityFilter?.addEventListener('change',render);overlay?.addEventListener('click',close);document.addEventListener('keydown',event=>{if(event.key==='Escape')close()});
  build(JSON.parse(sections.dataset.teams||'[]'),JSON.parse(sections.dataset.members||'[]'));
  // Swap the build-time snapshot for live data, so team changes show without a redeploy.
  const supabaseUrl=sections.dataset.supabaseUrl,supabaseKey=sections.dataset.supabaseKey;
  if(supabaseUrl&&supabaseKey){
    const aliases=JSON.parse(sections.dataset.cityAliases||'{}');
    const get=(path:string)=>fetch(`${supabaseUrl}/rest/v1/${path}`,{headers:{apikey:supabaseKey,...(supabaseKey.startsWith('eyJ')&&{Authorization:`Bearer ${supabaseKey}`})}}).then(response=>response.ok?response.json():Promise.reject(response.status));
    Promise.all([get('teams?select=slug,name,description&order=sort_order,name'),get('public_member_profiles?select=profile&order=name')])
      .then(([teams,rows]:[any[],any[]])=>build(teams,rows.map(row=>({...row.profile,city:(row.profile.city&&aliases[row.profile.city.toLowerCase()])||row.profile.city}))))
      .catch(error=>console.warn('Live team data unavailable, showing the build snapshot.',error));
  }
  }
</script>

<!-- Global: the sections are drawn in the browser, which scoped styles can’t reach. -->
<style is:global>
  .team-directory-intro{padding-bottom:72px}.team-filters{grid-template-columns:minmax(250px,1fr) minmax(180px,240px) minmax(180px,240px)}.team-filters select{width:100%}.team-group-section{border-top:1px solid var(--line)}.team-group-section[hidden]{display:none}.team-group-heading{display:grid;grid-template-columns:1fr minmax(320px,520px);gap:55px;align-items:end;margin-bottom:44px}.team-group-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.08}.team-group-heading>div:last-child{display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:start}.team-group-heading strong{font-family:var(--font-display);font-size:44px;font-weight:400;line-height:1}.team-group-heading p{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.team-member-card[hidden]{display:none}.team-group-empty{margin-top:24px}
  .team-more-toggle{display:flex;width:100%;align-items:center;justify-content:center;gap:10px;margin-top:32px;padding:17px 24px;border:none;border-radius:8px;color:#fff;background:var(--accent);font-size:14px;font-weight:700;cursor:pointer;transition:transform .2s ease,background-color .2s ease}.team-more-toggle span{font-size:17px;font-weight:400}.team-more-toggle:hover{transform:translateY(-2px);background:var(--accent-dark)}.team-more-toggle[hidden]{display:none}
  .team-hero-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(50px,8vw,110px);align-items:end}.team-hero h1{margin:0 0 24px;font-size:clamp(52px,7vw,82px);font-weight:300}.team-summary{display:grid;grid-template-columns:repeat(2,1fr);border:1px solid #ffffff24}.team-summary div{padding:24px}.team-summary div:nth-child(even){border-left:1px solid #ffffff24}.team-summary div:nth-child(n+3){border-top:1px solid #ffffff24}.team-summary strong,.team-summary span{display:block}.team-summary strong{font-family:var(--font-display);font-size:38px;font-weight:400}.team-summary span{margin-top:7px;color:#ffffffb0;font-size:13px;line-height:1.4}.team-directory-heading{display:grid;grid-template-columns:1fr minmax(300px,470px);gap:55px;align-items:end;margin-bottom:42px}.team-directory-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.08}.team-directory-heading>p{margin:0;color:var(--muted);font-size:18px;line-height:1.75}.team-member-grid{grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:16px;margin-top:0}.team-member-card{min-height:180px;padding:20px;border-radius:14px;background:#fff;box-shadow:0 10px 28px rgba(23,24,29,.04)}.team-member-card .member-card-top{gap:13px}.team-member-card .member-avatar{width:52px;height:52px;font-size:14px}.team-member-card .member-card-name{font-size:16px}.team-profile-group{margin:0 0 6px;color:var(--accent);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}@media(max-width:850px){.team-hero-layout,.team-directory-heading,.team-group-heading{grid-template-columns:1fr}.team-summary{margin-top:15px}.team-filters{grid-template-columns:1fr 1fr}.team-search{grid-column:1/-1}}@media(max-width:560px){.team-filters{grid-template-columns:1fr}.team-search{grid-column:auto}.team-member-grid{grid-template-columns:1fr}.team-member-card{min-height:0;gap:12px;padding:16px}.team-member-card .member-avatar{width:46px;height:46px}.team-member-card .member-card-meta{gap:6px}.team-member-card .member-card-action{padding-top:12px}}@media(max-width:420px){.team-summary div{padding:16px}.team-summary strong{font-size:30px}.team-group-heading>div:last-child{grid-template-columns:1fr}}
</style>
