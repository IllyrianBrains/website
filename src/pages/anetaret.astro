---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MemberNetworkGraph from '../components/MemberNetworkGraph.astro';
import { directoryMembers as members } from '../data/members';
const memberCities = [...new Set(members.map(member => member.city).filter((city):city is string => Boolean(city)))].sort();
const expertiseAreas = [...new Set(members.flatMap(member => member.fieldsOfExpertise || []))].sort((a,b) => a.localeCompare(b,'sq'));
const contributions = [...new Set(members.flatMap(member => member.groups))].sort((a,b) => a.localeCompare(b,'sq'));
---
<BaseLayout title="Anëtarët · Illyrian Brains" description="Njih profesionistët e komunitetit Illyrian Brains Network.">
  <Header />
  <main class="network-page">
    <section class="section tone-dark member-hero"><div class="container city-page">
      <p class="eyebrow">Illyrian Brains Network</p><h1>Anëtarët e rrjetit.</h1><p class="about-body">Njih profesionistët e komunitetit dhe zbulo fushat që na lidhin.</p>
    </div></section>

    <section class="section tone-white" id="anetaret"><div class="container">
      <div class="catalog-heading">
        <div><p class="eyebrow">Katalogu i anëtarëve</p><h2>Gjej personin e duhur.</h2></div>
        <p><strong>Përdor kërkimin dhe filtrat më poshtë</strong> për të parë anëtarët sipas emrit, ekspertizës, kontributit ose qytetit. Pa filtra shfaqen vetëm 5 rreshtat e parë.</p>
      </div>
      <div class="member-filters member-catalog-filters" aria-label="Filtro katalogun e anëtarëve">
        <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="member-search" type="search" placeholder="Kërko sipas emrit…" aria-label="Kërko anëtarë"/></div>
        <select id="filter-expertise" aria-label="Filtro sipas fushës së ekspertizës"><option value="">Të gjitha fushat</option>{expertiseAreas.map(area => <option value={area}>{area}</option>)}</select>
        <select id="filter-contribution" aria-label="Filtro sipas kontributit në IB"><option value="">Të gjitha kontributet</option>{contributions.map(value => <option value={value}>{value}</option>)}</select>
        <select id="filter-city" aria-label="Filtro sipas qytetit"><option value="">Të gjitha qytetet</option>{memberCities.map(city => <option value={city}>{city}</option>)}</select>
      </div>
      <div class="member-stats"><div><strong id="stat-total">{members.length}</strong><span>Anëtarë të listuar</span></div><div><strong>{memberCities.length}</strong><span>Qytete</span></div><div><strong>5000+</strong><span>Madhësia e rrjetit</span></div></div>
      <p class="result-count" id="result-count"></p><div class="member-grid" id="member-grid" data-members={JSON.stringify(members)}></div>
    </div></section>

    <section class="tone-grey"><div class="container"><MemberNetworkGraph members={members} /></div></section>
  </main>
  <Footer />
  <div class="member-drawer-overlay" id="member-overlay"></div><aside class="member-drawer" id="member-drawer" aria-hidden="true"><div class="member-drawer-inner" id="member-drawer-content"></div></aside>
</BaseLayout>
<script>
  const grid=document.querySelector<HTMLElement>('#member-grid'),search=document.querySelector<HTMLInputElement>('#member-search'),expertise=document.querySelector<HTMLSelectElement>('#filter-expertise'),contribution=document.querySelector<HTMLSelectElement>('#filter-contribution'),city=document.querySelector<HTMLSelectElement>('#filter-city'),count=document.querySelector<HTMLElement>('#result-count'),total=document.querySelector<HTMLElement>('#stat-total'),overlay=document.querySelector<HTMLElement>('#member-overlay'),drawer=document.querySelector<HTMLElement>('#member-drawer'),content=document.querySelector<HTMLElement>('#member-drawer-content');
  if(grid){const members=JSON.parse(grid.dataset.members||'[]');const escapeHtml=(value:string)=>value.replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]||character));const initials=(name:string)=>name.split(' ').map((part:string)=>part[0]).join('').slice(0,2).toUpperCase();const fields=(member:any)=>member.fieldsOfExpertise||[];const expertisePills=(member:any)=>fields(member).map((value:string)=>`<span class="member-pill member-pill-accent">${escapeHtml(value)}</span>`).join('');const contributionPills=(member:any)=>(member.groups||[]).map((value:string)=>`<span class="member-pill">Kontribut: ${escapeHtml(value)}</span>`).join('');const render=()=>{const query=(search?.value||'').trim().toLowerCase();const filtered=members.filter((member:any)=>(!query||`${member.name} ${member.username} ${member.title||''} ${member.bio||''} ${fields(member).join(' ')} ${(member.groups||[]).join(' ')}`.toLowerCase().includes(query))&&(!expertise?.value||fields(member).includes(expertise.value))&&(!contribution?.value||(member.groups||[]).includes(contribution.value))&&(!city?.value||member.city===city.value)).sort((a:any,b:any)=>a.name.localeCompare(b.name));const filterUsed=Boolean(query||expertise?.value||contribution?.value||city?.value);const columns=getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length||1;const list=filterUsed?filtered:filtered.slice(0,columns*5);if(total)total.textContent=String(filterUsed?filtered.length:members.length);if(count)count.textContent=filterUsed?`${filtered.length} anëtar${filtered.length===1?'':'ë'} u gjet${filtered.length===1?'':'ën'}`:`Po shfaqen ${list.length} nga ${members.length} anëtarë · përdor filtrat për të parë të tjerët`;grid.innerHTML=list.length?list.map((member:any)=>`<button class="member-card" type="button" data-username="${escapeHtml(member.username)}"><div class="member-card-top">${member.avatar?`<img class="member-avatar" src="${escapeHtml(member.avatar)}" alt="" loading="lazy">`:`<span class="member-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<div><p class="member-card-name">${escapeHtml(member.name)}</p><p class="member-card-role">${escapeHtml(member.title||fields(member).join(' · ')||'Ekspertiza TBD')}</p></div></div><div class="member-card-meta">${expertisePills(member)}${contributionPills(member)}${member.city?`<span class="member-pill">${escapeHtml(member.city)}</span>`:''}</div><span class="member-card-action">Shiko profilin <span aria-hidden="true">→</span></span></button>`).join(''):'<p class="member-empty">Asnjë anëtar nuk përputhet me filtrat.</p>'};const close=()=>{drawer?.classList.remove('open');overlay?.classList.remove('open');drawer?.setAttribute('aria-hidden','true');document.body.style.overflow=''};grid.addEventListener('click',event=>{const username=(event.target as HTMLElement).closest<HTMLElement>('.member-card')?.dataset.username,member=members.find((item:any)=>item.username===username);if(!member||!drawer||!overlay||!content)return;content.innerHTML=`<button class="member-drawer-close" type="button" aria-label="Mbyll profilin">✕</button>${member.avatar?`<img class="member-drawer-avatar" src="${escapeHtml(member.avatar)}" alt="">`:`<span class="member-drawer-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<h2>${escapeHtml(member.name)}</h2><p class="member-drawer-role">${escapeHtml(member.title||fields(member).join(' · ')||'Ekspertiza TBD')}</p>${member.bio?`<p class="member-drawer-bio">${escapeHtml(member.bio)}</p>`:''}<div class="member-tags">${expertisePills(member)}${contributionPills(member)}${member.city?`<span class="member-pill">${escapeHtml(member.city)}</span>`:''}<span class="member-pill">Anëtar që nga ${member.since}</span></div><div class="member-drawer-actions">${member.website?`<a class="partner-button" href="${encodeURI(member.website)}" target="_blank" rel="noreferrer">Faqja personale <span>↗</span></a>`:''}<a class="partner-button" href="${encodeURI(member.profileUrl)}" target="_blank" rel="noreferrer">Profili në forum <span>↗</span></a></div>`;drawer.classList.add('open');overlay.classList.add('open');drawer.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';content.querySelector('.member-drawer-close')?.addEventListener('click',close)});[search,expertise,contribution,city].forEach(control=>control?.addEventListener(control===search?'input':'change',render));let resizeTimer:number;window.addEventListener('resize',()=>{window.clearTimeout(resizeTimer);resizeTimer=window.setTimeout(render,120)});overlay?.addEventListener('click',close);document.addEventListener('keydown',event=>{if(event.key==='Escape')close()});render()}
</script>
<style>
  .member-hero .about-body{max-width:640px;margin-top:18px;color:#ffffffb8;font-size:19px;line-height:1.75}.catalog-heading{display:grid;grid-template-columns:1fr minmax(300px,480px);gap:55px;align-items:end}.catalog-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.05}.catalog-heading>p{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.catalog-heading strong{color:var(--accent-dark)}.member-catalog-filters{display:grid;grid-template-columns:minmax(230px,1fr) repeat(3,minmax(165px,220px));margin-top:34px;padding:20px;border:1px solid rgba(116,71,97,.2);border-radius:14px;background:var(--soft)}.member-catalog-filters>*{min-width:0}.member-catalog-filters select{width:100%}#anetaret .member-stats{margin:28px 0 40px;padding-block:24px;border-block:1px solid var(--line)}#anetaret .member-grid{margin-top:32px;margin-bottom:12px}@media(max-width:1000px){.member-catalog-filters{grid-template-columns:1fr 1fr}.member-catalog-filters .member-search{grid-column:1/-1}}@media(max-width:760px){.catalog-heading{grid-template-columns:1fr;gap:18px}}@media(max-width:560px){.member-hero .about-body{font-size:17px}.member-catalog-filters{grid-template-columns:1fr;margin-top:24px;padding:14px}.member-catalog-filters .member-search{grid-column:auto}#anetaret .member-stats{gap:20px;margin:22px 0 28px;padding-block:18px}#anetaret .member-stats>div{flex:1 1 90px}#anetaret .member-grid{margin-top:24px}.result-count{line-height:1.55}}
</style>
