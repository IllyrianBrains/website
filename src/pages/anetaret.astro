---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/directory.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MemberNetworkGraph from '../components/MemberNetworkGraph.astro';
import NetworkDirectoryHero from '../components/NetworkDirectoryHero.astro';
import { directoryMembers as members } from '../data/members';
import { cities } from '../data/cities';
const memberCities = [...new Set(members.map(member => member.city).filter((city):city is string => Boolean(city)))].sort();
const expertiseAreas = [...new Set(members.flatMap(member => member.fieldsOfExpertise || []))].sort((a,b) => a.localeCompare(b,'sq'));
const cityLinks = Object.fromEntries(cities.flatMap(city => [city.slug, ...city.city.split('/').map(name => name.trim())].map(name => [name.toLocaleLowerCase('sq'), `/qytetet/${city.slug}/`])));
---
<BaseLayout title="Anëtarët · Illyrian Brains" description="Njih profesionistët e komunitetit Illyrian Brains Network.">
  <Header />
  <main class="network-page">
    <NetworkDirectoryHero kind="members" title="Anëtarët e rrjetit." description="Njih profesionistët e komunitetit dhe zbulo ekspertizën, përvojën dhe fushat që na lidhin." showVisual={false} />

    <section class="section tone-white" id="anetaret"><div class="container">
      <div class="catalog-heading">
        <div><h2>Gjej personin e duhur.</h2></div>
        <p><strong>Përdor kërkimin dhe filtrat më poshtë</strong> për të parë anëtarët sipas emrit, ekspertizës ose qytetit. Pa filtra shfaqen vetëm 5 rreshtat e parë.</p>
      </div>
      <div class="member-filters member-catalog-filters" aria-label="Filtro katalogun e anëtarëve">
        <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="member-search" type="search" placeholder="Kërko sipas emrit…" aria-label="Kërko anëtarë"/></div>
        <select id="filter-expertise" aria-label="Filtro sipas fushës së ekspertizës"><option value="">Të gjitha fushat</option>{expertiseAreas.map(area => <option value={area}>{area}</option>)}</select>
        <select id="filter-city" aria-label="Filtro sipas qytetit"><option value="">Të gjithë qytetet</option>{memberCities.map(city => <option value={city}>{city}</option>)}</select>
      </div>
      <div class="member-stats"><div><strong id="stat-total">{members.length}</strong><span>Anëtarë të listuar</span></div><div><strong>{memberCities.length}</strong><span>Qytete</span></div><div><strong>5000+</strong><span>Madhësia e rrjetit</span></div></div>
      <p class="result-count" id="result-count"></p><div class="member-grid" id="member-grid" data-members={JSON.stringify(members)} data-city-links={JSON.stringify(cityLinks)}></div>
    </div></section>

    <section class="section tone-grey"><div class="container"><MemberNetworkGraph members={members} /></div></section>
  </main>
  <Footer />
  <div class="member-drawer-overlay" id="member-overlay"></div><aside class="member-drawer" id="member-drawer" aria-hidden="true"><div class="member-drawer-inner" id="member-drawer-content"></div></aside>
</BaseLayout>
<script>
  const grid=document.querySelector<HTMLElement>('#member-grid'),search=document.querySelector<HTMLInputElement>('#member-search'),expertise=document.querySelector<HTMLSelectElement>('#filter-expertise'),city=document.querySelector<HTMLSelectElement>('#filter-city'),count=document.querySelector<HTMLElement>('#result-count'),total=document.querySelector<HTMLElement>('#stat-total'),overlay=document.querySelector<HTMLElement>('#member-overlay'),drawer=document.querySelector<HTMLElement>('#member-drawer'),content=document.querySelector<HTMLElement>('#member-drawer-content');
  if(grid){const members=JSON.parse(grid.dataset.members||'[]');const escapeHtml=(value:string)=>value.replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]||character));const initials=(name:string)=>name.split(' ').map((part:string)=>part[0]).join('').slice(0,2).toUpperCase();const fields=(member:any)=>member.fieldsOfExpertise||[];const expertisePills=(member:any)=>fields(member).map((value:string)=>`<span class="member-pill member-pill-accent">${escapeHtml(value)}</span>`).join('');const render=()=>{const query=(search?.value||'').trim().toLowerCase();const filtered=members.filter((member:any)=>(!query||`${member.name} ${member.username} ${member.title||''} ${(member.specialty||[]).join(' ')} ${member.bio||''} ${fields(member).join(' ')}`.toLowerCase().includes(query))&&(!expertise?.value||fields(member).includes(expertise.value))&&(!city?.value||member.city===city.value)).sort((a:any,b:any)=>a.name.localeCompare(b.name));const filterUsed=Boolean(query||expertise?.value||city?.value);const columns=getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length||1;const list=filterUsed?filtered:filtered.slice(0,columns*5);if(total)total.textContent=String(filterUsed?filtered.length:members.length);if(count)count.textContent=filterUsed?`${filtered.length} anëtar${filtered.length===1?'':'ë'} u gjet${filtered.length===1?'':'ën'}`:`Po shfaqen ${list.length} nga ${members.length} anëtarë · përdor filtrat për të parë të tjerët`;grid.innerHTML=list.length?list.map((member:any)=>`<button class="member-card" type="button" data-username="${escapeHtml(member.username)}"><div class="member-card-top">${member.avatar?`<img class="member-avatar" src="${escapeHtml(member.avatar)}" alt="" loading="lazy">`:`<span class="member-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<div><p class="member-card-name">${escapeHtml(member.name)}</p><p class="member-card-role">${escapeHtml(member.title||fields(member).join(' · ')||'Ekspertiza TBD')}</p></div></div><div class="member-card-meta">${expertisePills(member)}${(member.specialty||[]).map((value:string)=>`<span class="member-pill member-pill-specialty">${escapeHtml(value)}</span>`).join('')}${member.city?`<span class="member-pill member-pill-location">${escapeHtml(member.city)}</span>`:''}</div><span class="member-card-action">Shiko profilin <span aria-hidden="true">→</span></span></button>`).join(''):'<p class="member-empty">Asnjë anëtar nuk përputhet me filtrat.</p>'};const close=()=>{drawer?.classList.remove('open');overlay?.classList.remove('open');drawer?.setAttribute('aria-hidden','true');document.body.style.overflow=''};grid.addEventListener('click',event=>{const username=(event.target as HTMLElement).closest<HTMLElement>('.member-card')?.dataset.username,member=members.find((item:any)=>item.username===username);if(!member||!drawer||!overlay||!content)return;content.innerHTML=`<button class="member-drawer-close" type="button" aria-label="Mbyll profilin">✕</button>${member.avatar?`<img class="member-drawer-avatar" src="${escapeHtml(member.avatar)}" alt="">`:`<span class="member-drawer-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<h2>${escapeHtml(member.name)}</h2><p class="member-drawer-role">${escapeHtml(member.title||fields(member).join(' · ')||'Ekspertiza TBD')}</p>${member.bio?`<p class="member-drawer-bio">${escapeHtml(member.bio)}</p>`:''}<div class="member-tags">${expertisePills(member)}${(member.specialty||[]).map((value:string)=>`<span class="member-pill member-pill-specialty">${escapeHtml(value)}</span>`).join('')}${member.city?`<span class="member-pill member-pill-location">${escapeHtml(member.city)}</span>`:''}</div><div class="member-drawer-actions">${member.website?`<a class="partner-button" href="${encodeURI(member.website)}" target="_blank" rel="noreferrer">Faqja personale <span>↗</span></a>`:''}${member.linkedinUrl?`<a class="partner-button" href="${encodeURI(member.linkedinUrl)}" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a>`:''}${member.profileUrl?`<a class="partner-button" href="${encodeURI(member.profileUrl)}" target="_blank" rel="noreferrer">Profili në forum <span>↗</span></a>`:''}</div>`;drawer.classList.add('open');overlay.classList.add('open');drawer.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';content.querySelector('.member-drawer-close')?.addEventListener('click',close)});[search,expertise,city].forEach(control=>control?.addEventListener(control===search?'input':'change',render));let resizeTimer:number;window.addEventListener('resize',()=>{window.clearTimeout(resizeTimer);resizeTimer=window.setTimeout(render,120)});overlay?.addEventListener('click',close);document.addEventListener('keydown',event=>{if(event.key==='Escape')close()});const searchParam=new URLSearchParams(location.search).get('search');if(searchParam&&search)search.value=searchParam;render()}
</script>
<script>
  const companyGrid = document.querySelector<HTMLElement>('#member-grid');
  const companyMembers = JSON.parse(companyGrid?.dataset.members || '[]');
  const companyByUsername = new Map(companyMembers.map((member:any) => [member.username, member]));
  const cityLinks = JSON.parse(companyGrid?.dataset.cityLinks || '{}');
  const showCompanies = () => companyGrid?.querySelectorAll<HTMLElement>('.member-card').forEach(card => {
    const member:any = companyByUsername.get(card.dataset.username || '');
    const role = card.querySelector('.member-card-role');
    if (!member?.company || !role || role.nextElementSibling?.classList.contains('member-card-company')) return;
    const company = document.createElement('p');
    company.className = 'member-card-company';
    company.textContent = member.company;
    role.insertAdjacentElement('afterend', company);
  });
  if (companyGrid) {
    new MutationObserver(showCompanies).observe(companyGrid, { childList: true });
    showCompanies();
  }
  companyGrid?.addEventListener('click', event => {
    const username = (event.target as HTMLElement).closest<HTMLElement>('.member-card')?.dataset.username;
    if (!username) return;
    const member:any = companyByUsername.get(username);
    if (!member) return;
    requestAnimationFrame(() => {
      const role = document.querySelector<HTMLElement>('#member-drawer-content .member-drawer-role');
      if (member.company && role && !role.nextElementSibling?.classList.contains('member-drawer-company')) {
        const company = document.createElement('p');
        company.className = 'member-drawer-company';
        company.textContent = member.company;
        role.insertAdjacentElement('afterend', company);
      }
      const location = document.querySelector<HTMLElement>('#member-drawer-content .member-pill-location');
      const cityUrl = member.city && cityLinks[member.city.toLocaleLowerCase('sq')];
      if (location && cityUrl) {
        const link = document.createElement('a');
        link.className = location.className;
        link.href = cityUrl;
        link.innerHTML = `${location.textContent || member.city} <span aria-hidden="true">→</span>`;
        location.replaceWith(link);
      }
    });
  });
</script>
<style>
  .member-card-company{margin:3px 0 0;color:var(--accent-dark);font-size:12px;font-weight:800}.member-drawer-company{margin:-10px 0 22px;color:var(--accent-dark);font-size:16px;font-weight:800}.member-tags a.member-pill-location{text-decoration:none;transition:border-color .18s ease,color .18s ease}.member-tags a.member-pill-location:hover{border-color:var(--accent-dark);color:var(--accent-dark)}
  .member-collaboration-card{border:1px solid rgba(255,255,255,.1)!important;background:linear-gradient(145deg,var(--member-card-start),var(--member-card-end))!important}.member-card-plum{--member-card-start:#80566f;--member-card-end:#5a394d}.member-card-blue{--member-card-start:#486f7e;--member-card-end:#294b5a}.member-card-ochre{--member-card-start:#b06f58;--member-card-end:#854938}.member-collaboration-card::after{border-color:rgba(255,255,255,.2)!important;box-shadow:0 0 70px rgba(255,255,255,.06)!important}
  .member-collaboration{padding:96px 0 104px;border-bottom:1px solid var(--line);background:#f7f6f4}.member-collaboration-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,430px);column-gap:70px;align-items:end;margin-bottom:44px}.member-collaboration-heading .eyebrow{grid-column:1/-1;margin-bottom:15px}.member-collaboration-heading h2{max-width:650px;margin:0;font-size:clamp(42px,5.3vw,66px);font-weight:400;line-height:.98;letter-spacing:-.045em}.member-collaboration-heading>p:last-child{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.member-collaboration-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.member-collaboration-card{--member-collaboration-color:#744761;position:relative;display:flex;min-height:330px;flex-direction:column;justify-content:space-between;overflow:hidden;padding:27px 29px 30px;border-radius:12px;color:#fff;background:var(--member-collaboration-color);box-shadow:0 14px 35px rgba(23,24,29,.12);transition:transform .22s ease,box-shadow .22s ease}.member-collaboration-card::after{content:'';position:absolute;right:-52px;top:-62px;width:180px;height:180px;border:1px solid rgba(255,255,255,.16);border-radius:50%}.member-collaboration-card:hover{transform:translateY(-5px);box-shadow:0 20px 42px rgba(23,24,29,.18)}.member-card-plum{--member-collaboration-color:#744761}.member-card-blue{--member-collaboration-color:#365d70}.member-card-ochre{--member-collaboration-color:#a56f32}.member-collaboration-number{position:relative;z-index:1;display:grid;width:36px;height:36px;place-items:center;border:1px solid rgba(255,255,255,.45);border-radius:50%;font-size:10px;font-weight:800;letter-spacing:.08em}.member-collaboration-card>div{position:relative;z-index:1}.member-collaboration-card h3{max-width:290px;margin:0 0 13px;font-size:clamp(25px,2.2vw,31px);font-weight:400;line-height:1.05;letter-spacing:-.025em}.member-collaboration-card p{max-width:310px;margin:0;color:rgba(255,255,255,.78);font-size:14px;line-height:1.65}@media(max-width:900px){.member-collaboration-heading{grid-template-columns:1fr;gap:20px}.member-collaboration-grid{grid-template-columns:1fr}.member-collaboration-card{min-height:250px}}@media(max-width:600px){.member-collaboration{padding:72px 0 78px}.member-collaboration-heading{margin-bottom:30px}.member-collaboration-heading h2{font-size:clamp(38px,11vw,48px)}.member-collaboration-heading>p:last-child{font-size:15px}.member-collaboration-card{min-height:235px;padding:24px}.member-collaboration-card h3{font-size:27px}}
  .member-hero .about-body{max-width:640px;margin-top:18px;color:#ffffffb8;font-size:19px;line-height:1.75}.catalog-heading{display:grid;grid-template-columns:1fr minmax(300px,480px);gap:55px;align-items:end}.catalog-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.05}.catalog-heading>p{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.catalog-heading strong{color:var(--accent-dark)}.member-catalog-filters{display:grid;grid-template-columns:minmax(230px,1fr) repeat(2,minmax(165px,220px));margin-top:34px;padding:20px;border:1px solid rgba(116,71,97,.2);border-radius:14px;background:var(--soft)}.member-catalog-filters>*{min-width:0}.member-catalog-filters select{width:100%}#anetaret .member-stats{margin:28px 0 40px;padding-block:24px;border-block:1px solid var(--line)}#anetaret .member-grid{margin-top:32px;margin-bottom:12px}@media(max-width:1000px){.member-catalog-filters{grid-template-columns:1fr 1fr}.member-catalog-filters .member-search{grid-column:1/-1}}@media(max-width:760px){.catalog-heading{grid-template-columns:1fr;gap:18px}}@media(max-width:560px){.member-hero .about-body{font-size:17px}.member-catalog-filters{grid-template-columns:1fr;margin-top:24px;padding:14px}.member-catalog-filters .member-search{grid-column:auto}#anetaret .member-stats{gap:20px;margin:22px 0 28px;padding-block:18px}#anetaret .member-stats>div{flex:1 1 90px}#anetaret .member-grid{margin-top:24px}.result-count{line-height:1.55}}
</style>
