  .notification-create-section{margin-top:72px;padding-block:34px;border-top:1px solid var(--line)}.notification-create-panel>summary{display:grid;grid-template-columns:1fr auto;align-items:center;gap:28px;padding:22px 24px;border:1px solid var(--line);border-radius:16px;background:#fff;cursor:pointer;list-style:none;box-shadow:0 8px 24px rgba(23,24,29,.05)}.notification-create-panel>summary::-webkit-details-marker{display:none}.notification-create-panel[open]>summary{border-radius:16px 16px 0 0}.notification-create-toggle{display:flex;align-items:center;gap:12px;color:var(--accent-dark);font-size:12px}.notification-create-toggle i{font-size:18px;font-style:normal;transition:transform .2s ease}.notification-create-panel[open] .notification-create-toggle i{transform:rotate(180deg)}.notification-create-panel[open] .notification-create-toggle b{font-size:0}.notification-create-panel[open] .notification-create-toggle b::after{content:"Mbyll formularin";font-size:12px}.notification-create-heading,.notification-map-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,440px);align-items:end;gap:64px}.notification-create-heading h2,.notification-map-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.05;letter-spacing:-.035em}.notification-create-heading>p,.notification-map-heading>p{margin:0;color:var(--muted);font-size:15px;line-height:1.7}.notification-create-card{max-width:none;margin:0;padding-top:28px;padding:28px;border:1px solid var(--line);border-radius:16px;background:var(--soft)}.notification-auth-prompt{text-align:center}.notification-auth-prompt p{margin:8px 0 18px;color:var(--muted)}#notification-form{display:grid;gap:18px}#notification-form[hidden],.notification-auth-prompt[hidden]{display:none}#notification-form label{display:grid;gap:7px;color:var(--ink);font-size:12px;font-weight:800}#notification-form input,#notification-form select,#notification-form textarea{width:100%;padding:12px 14px;border:1px solid var(