---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RrjetiSection from '../../components/RrjetiSection.astro';
import ideas from '../../data/ideas.json';
import { cities } from '../../data/cities';
import { directoryMembers as members } from '../../data/members';
import { excerpt, formatDate, plainText, type Idea } from '../../scripts/ideas';
import { memberUrl } from '../../scripts/members';
import '../../styles/directory.css';

const normalizePerson = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('sq').replace(/[^a-z0-9]/g, '');
const notifications = (ideas as Idea[])
  .map(idea => {
    const tags = idea.tags || [];
    const searchable = `${idea.title} ${plainText(idea.description)} ${tags.join(' ')}`.toLocaleLowerCase('sq');
    const city = cities.find(item => searchable.includes(item.city.toLocaleLowerCase('sq')));
    const authorName = idea.name || 'Anëtar i rrjetit';
    const author = idea.author_username
      ? members.find(member => member.username === idea.author_username)
      : members.find(member => normalizePerson(member.name) === normalizePerson(authorName) || normalizePerson(member.username) === normalizePerson(authorName));
    return { ...idea, tags, city, searchable, authorName, authorUrl: author ? memberUrl(author.username) : `/anetaret/?search=${encodeURIComponent(authorName)}` };
  })
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const categories = [...new Set(notifications.flatMap(item => item.tags))].sort((a, b) => a.localeCompare(b, 'sq'));
const referencedCities = [...new Map(notifications.filter(item => item.city).map(item => [item.city!.slug, item.city!])).values()].sort((a, b) => a.city.localeCompare(b.city, 'sq'));
const notificationCities = referencedCities.map(city => ({ ...city, count: notifications.filter(item => item.city?.slug === city.slug).length }));
const openNotifications = notifications.filter(item => !item.resolved).length;
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
---
<BaseLayout title="Njoftimet · Illyrian Brains" description="Njoftime, kërkesa, evente dhe mundësi bashkëpunimi nga rrjeti Illyrian Brains.">
  <Header />
  <main>
    <RrjetiSection eyebrow="Nga komuniteti" title="Njoftimet e rrjetit." description="Njoftime, kërkesa, evente dhe mundësi bashkëpunimi nga komunitetet tona. Filtro sipas qytetit ose kategorisë për të gjetur atë që të intereson." stats={[{ value: notifications.length, label: 'Njoftime' }, { value: openNotifications, label: 'Aktive' }, { value: categories.length, label: 'Kategori' }]} filtersLabel="Filtro njoftimet">
      <a slot="actions" href="#njoftim-i-ri" data-open-notification>Krijo njoftim <span aria-hidden="true">→</span></a>
      <div slot="filters" class="member-filters notification-filters">
        <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="notification-search" type="search" placeholder="Kërko njoftim…" aria-label="Kërko njoftime" /></div>
        <select id="notification-city" aria-label="Filtro sipas qytetit"><option value="">Të gjitha qytetet</option><option value="__global">Rrjeti global</option>{referencedCities.map(city => <option value={city.slug}>{city.city}</option>)}</select>
        <select id="notification-category" aria-label="Filtro sipas kategorisë"><option value="">Të gjitha kategoritë</option>{categories.map(category => <option value={category.toLocaleLowerCase('sq')}>{category}</option>)}</select>
        <select id="notification-status" aria-label="Filtro sipas statusit"><option value="">Çdo status</option><option value="active">Aktive</option><option value="resolved">Të përfunduara</option></select>
      </div>
      <Fragment slot="results">
        <p class="result-count" id="notification-result-count"></p>
        <div class="notification-grid" id="notification-grid">
          {notifications.map(item => (
            <article class="notification-card" data-city={item.city?.slug || '__global'} data-categories={item.tags.map(tag => tag.toLocaleLowerCase('sq')).join('|')} data-status={item.resolved ? 'resolved' : 'active'} data-search={item.searchable}>
              <div class="notification-card-meta">{item.city ? <a class="notification-location" href={`/qytetet/${item.city.slug}/`}><span aria-hidden="true">⌖</span>{item.city.city}</a> : <span class="notification-location"><span aria-hidden="true">◎</span>Rrjeti global</span>}<span>{formatDate(item.date)}</span></div>
              <div class="notification-card-tags">{item.tags.map(tag => <span>{tag}</span>)}<span class:list={['notification-status', item.resolved ? 'is-resolved' : 'is-active']}>{item.resolved ? 'Përfunduar' : 'Aktive'}</span></div>
              <h2><a href={`/projektet/ide/${encodeURIComponent(item.slug)}/`}>{item.title}</a></h2>
              <p>{excerpt(plainText(item.description), 180)}</p>
              <footer><a class="notification-author" href={item.authorUrl}><span aria-hidden="true">●</span>{item.authorName}</a><a href={`/projektet/ide/${encodeURIComponent(item.slug)}/`}>Lexo njoftimin <span aria-hidden="true">→</span></a></footer>
            </article>
          ))}
        </div>
        <p class="notification-empty" id="notification-empty" hidden>Asnjë njoftim nuk përputhet me filtrat.</p>
        <div class="notification-more-wrap"><button type="button" class="partner-button" id="notification-more" hidden>Shfaq më shumë njoftime <span aria-hidden="true">↓</span></button></div>
      </Fragment>

      <section class="section tone-grey notification-create-section"><div class="container">
        <details class="notification-create-panel" id="njoftim-i-ri">
          <summary><div class="notification-create-heading"><div><p class="eyebrow">Nga anëtarët</p><h2>Krijo një njoftim.</h2></div><p>Ndaj një event, kërkesë, mundësi ose lajm me rrjetin. Emri dhe profili yt do të shfaqen me njoftimin.</p></div><span class="notification-create-toggle"><b>Hap formularin</b><i aria-hidden="true">↓</i></span></summary>
        <div class="notification-create-card" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}>
          <div class="notification-auth-prompt" id="notification-auth-prompt"><strong>Hyr për të publikuar</strong><p>Vetëm anëtarët e aprovuar mund të krijojnë njoftime.</p><a class="partner-button" href="/anetaresohu/profili/">Hyr në llogari <span aria-hidden="true">→</span></a></div>
          <form id="notification-form" hidden>
            <label>Titulli *<input name="title" required minlength="3" maxlength="160" placeholder="Titulli i njoftimit" /></label>
            <div class="notification-form-row">
              <label>Qyteti *<select name="city" required><option value="">Zgjidh qytetin</option>{cities.slice().sort((a,b) => a.city.localeCompare(b.city, 'sq')).map(city => <option value={city.city}>{city.city}, {city.country}</option>)}</select></label>
              <label>Kategoritë *<input name="categories" required maxlength="120" placeholder="p.sh. Evente, Karriera" /></label>
            </div>
            <label>Përshkrimi *<textarea name="description" required maxlength="20000" rows="7" placeholder="Shkruaj informacionin e plotë për komunitetin…"></textarea></label>
            <label class="notification-email-option"><input type="checkbox" name="show_email" /> Lejo anëtarët të më kontaktojnë me email</label>
            <div class="notification-form-foot"><p id="notification-form-status" role="status" aria-live="polite"></p><button class="partner-button" type="submit">Publiko njoftimin <span aria-hidden="true">→</span></button></div>
          </form>
        </div>
        </details>
      </div></section>

      <section class="section tone-white notification-map-section"><div class="container">
        <p class="eyebrow">Sipas vendndodhjes</p><div class="notification-map-heading"><h2>Njoftimet në hartë.</h2><p>Shiko qytetet që përmenden në njoftimet e rrjetit. Zgjidh një pikë në hartë për të filtruar kartat sipas qytetit.</p></div>
        <div class="notification-map-layout"><div id="notification-map" data-cities={JSON.stringify(notificationCities)} aria-label="Harta e qyteteve të përmendura në njoftime"></div></div>
      </div></section>
    </RrjetiSection>
  </main>
  <Footer />
</BaseLayout>

<script>
  const grid=document.querySelector<HTMLElement>('#notification-grid'),search=document.querySelector<HTMLInputElement>('#notification-search'),city=document.querySelector<HTMLSelectElement>('#notification-city'),category=document.querySelector<HTMLSelectElement>('#notification-category'),status=document.querySelector<HTMLSelectElement>('#notification-status'),count=document.querySelector<HTMLElement>('#notification-result-count'),empty=document.querySelector<HTMLElement>('#notification-empty'),more=document.querySelector<HTMLButtonElement>('#notification-more');
  const cards=grid?[...grid.querySelectorAll<HTMLElement>('.notification-card')]:[];let expanded=false;
  const columnCount=()=>grid?Math.max(1,getComputedStyle(grid).gridTemplateColumns.split(' ').length):1;
  const renderNotifications=()=>{const query=(search?.value||'').trim().toLocaleLowerCase('sq');const matched=cards.filter(card=>(!query||(card.dataset.search||'').includes(query))&&(!city?.value||card.dataset.city===city.value)&&(!category?.value||(card.dataset.categories||'').split('|').includes(category.value))&&(!status?.value||card.dataset.status===status.value));const limit=columnCount()*3,shown=new Set(expanded?matched:matched.slice(0,limit));cards.forEach(card=>card.hidden=!shown.has(card));if(count)count.textContent=`${matched.length} ${matched.length===1?'njoftim u gjet':'njoftime u gjetën'}`;if(empty)empty.hidden=matched.length>0;if(more)more.hidden=expanded||matched.length<=limit};
  const reset=()=>{expanded=false;renderNotifications()};search?.addEventListener('input',reset);[city,category,status].forEach(control=>control?.addEventListener('change',reset));more?.addEventListener('click',()=>{expanded=true;renderNotifications()});window.addEventListener('resize',renderNotifications);renderNotifications();
  const createPanel=document.querySelector<HTMLDetailsElement>('#njoftim-i-ri');document.querySelector<HTMLAnchorElement>('[data-open-notification]')?.addEventListener('click',()=>{if(createPanel)createPanel.open=true});

  const createCard=document.querySelector<HTMLElement>('.notification-create-card'),form=document.querySelector<HTMLFormElement>('#notification-form'),prompt=document.querySelector<HTMLElement>('#notification-auth-prompt'),formStatus=document.querySelector<HTMLElement>('#notification-form-status');
  if(createCard&&form&&prompt){const {supabaseUrl,supabaseKey}=createCard.dataset;const stored=(()=>{try{return Object.keys(localStorage).some(key=>/^sb-.+-auth-token$/.test(key))}catch{return false}})();if(stored&&supabaseUrl&&supabaseKey){prompt.hidden=true;form.hidden=false;const submit=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;submit.disabled=true;Promise.all([import('@supabase/supabase-js'),import('../../scripts/member-session')]).then(async([{createClient},{memberSession}])=>{const client=createClient(supabaseUrl,supabaseKey);const {session}=await memberSession(client,false);if(!session){prompt.hidden=false;form.hidden=true;return}submit.disabled=false;form.addEventListener('submit',async event=>{event.preventDefault();submit.disabled=true;if(formStatus)formStatus.textContent='Duke publikuar…';const data=new FormData(form);const cityValue=String(data.get('city')||'').trim();const categories=String(data.get('categories')||'').split(',').map(value=>value.trim().replace(/^#+/,'')).filter(Boolean);const tags=[cityValue,...categories].slice(0,5);const {data:slug,error}=await client.rpc('submit_idea',{p:{title:String(data.get('title')||''),description:String(data.get('description')||''),tags,wants_public:true,show_name:true,show_email:data.get('show_email')==='on'}});submit.disabled=false;if(error){if(formStatus)formStatus.textContent=`Nuk u publikua: ${error.message}`;return}form.reset();if(formStatus)formStatus.textContent=`U publikua me sukses. Njoftimi do të shfaqet në listë pas rifreskimit të të dhënave.`})}).catch(()=>{prompt.hidden=false;form.hidden=true})}}
</script>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  const mapElement=document.querySelector('#notification-map');if(mapElement&&window.L){const mapped=JSON.parse(mapElement.dataset.cities||'[]'),map=L.map(mapElement,{scrollWheelZoom:false}).setView([44,8],3);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);const markers=mapped.map(city=>L.circleMarker([city.lat,city.lng],{radius:Math.min(16,8+city.count),color:'#fff',weight:2,fillColor:'#744761',fillOpacity:.86}).bindTooltip(`${city.city} · ${city.count} ${city.count===1?'njoftim':'njoftime'}`,{direction:'top',offset:[0,-8]}).bindPopup(`<div class="map-popup"><strong>${city.city}</strong><span>${city.country}</span><small>${city.count} ${city.count===1?'njoftim':'njoftime'}</small><button class="map-popup-link notification-map-filter" type="button" data-city="${city.slug}">Shfaq njoftimet →</button></div>`).addTo(map));if(markers.length)map.fitBounds(L.featureGroup(markers).getBounds(),{padding:[38,38],maxZoom:6});mapElement.addEventListener('click',event=>{const button=event.target.closest('.notification-map-filter'),filter=document.querySelector('#notification-city');if(!button||!filter)return;filter.value=button.dataset.city||'';filter.dispatchEvent(new Event('change'));document.querySelector('#notification-grid')?.scrollIntoView({behavior:'smooth',block:'start'});map.closePopup()})}
</script>

<style>
  .notification-filters{display:grid;grid-template-columns:minmax(230px,1.35fr) repeat(3,minmax(155px,.75fr));gap:12px}.notification-filters>*{min-width:0}.notification-filters select{width:100%}.notification-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.notification-card{display:flex;min-height:330px;flex-direction:column;padding:20px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:0 1px 2px rgba(23,24,29,.04);transition:.18s ease}.notification-card:hover{transform:translateY(-2px);border-color:rgba(116,71,97,.32);box-shadow:0 12px 28px rgba(23,24,29,.08)}.notification-card[hidden]{display:none}.notification-card-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px}.notification-location{display:inline-flex;align-items:center;gap:5px;color:var(--accent-dark);font-weight:800;text-decoration:none}.notification-card-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}.notification-card-tags>span{padding:4px 8px;border-radius:999px;background:var(--soft);color:var(--accent-dark);font-size:10px;font-weight:800}.notification-card-tags .is-active{color:#2b5a92;background:rgba(45,100,170,.1)}.notification-card-tags .is-resolved{color:#246247;background:rgba(42,112,82,.1)}.notification-card h2{margin:18px 0 9px;font-size:20px;line-height:1.3}.notification-card h2 a{color:var(--ink);text-decoration:none}.notification-card>p{display:-webkit-box;margin:0;overflow:hidden;color:#4d4e53;font-size:14px;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:4}.notification-card footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;padding-top:18px;border-top:1px solid var(--line);font-size:11px}.notification-card footer>a{color:var(--accent-dark);font-weight:800;text-decoration:none}.notification-author{display:inline-flex;align-items:center;gap:6px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.notification-author>span{font-size:7px}.notification-more-wrap{display:flex;justify-content:center;margin-top:28px}.notification-empty{padding:48px 20px;color:var(--muted);text-align:center}
  .notification-create-section{margin-top:72px;padding-block:34px;border-top:1px solid var(--line)}.notification-create-panel>summary{display:grid;grid-template-columns:1fr auto;align-items:center;gap:28px;padding:22px 24px;border:1px solid var(--line);border-radius:16px;background:#fff;cursor:pointer;list-style:none;box-shadow:0 8px 24px rgba(23,24,29,.05)}.notification-create-panel>summary::-webkit-details-marker{display:none}.notification-create-panel[open]>summary{border-radius:16px 16px 0 0}.notification-create-toggle{display:flex;align-items:center;gap:12px;color:var(--accent-dark);font-size:12px}.notification-create-toggle i{font-size:18px;font-style:normal;transition:transform .2s ease}.notification-create-panel[open] .notification-create-toggle i{transform:rotate(180deg)}.notification-create-panel[open] .notification-create-toggle b{font-size:0}.notification-create-panel[open] .notification-create-toggle b::after{content:"Mbyll formularin";font-size:12px}.notification-create-heading,.notification-map-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,440px);align-items:end;gap:64px}.notification-create-heading h2,.notification-map-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.05;letter-spacing:-.035em}.notification-create-heading>p,.notification-map-heading>p{margin:0;color:var(--muted);font-size:15px;line-height:1.7}.notification-create-card{max-width:none;margin:0;padding-top:28px;padding:28px;border:1px solid var(--line);border-radius:16px;background:var(--soft)}.notification-auth-prompt{text-align:center}.notification-auth-prompt p{margin:8px 0 18px;color:var(--muted)}#notification-form{display:grid;gap:18px}#notification-form[hidden],.notification-auth-prompt[hidden]{display:none}#notification-form label{display:grid;gap:7px;color:var(--ink);font-size:12px;font-weight:800}#notification-form input,#notification-form select,#notification-form textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);font:14px var(--font-body)}#notification-form textarea{resize:vertical}.notification-form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}#notification-form .notification-email-option{display:flex;align-items:center;gap:9px;font-weight:600}#notification-form .notification-email-option input{width:17px;height:17px}.notification-form-foot{display:flex;align-items:center;justify-content:space-between;gap:16px}.notification-form-foot p{margin:0;color:var(--muted);font-size:13px}.notification-form-foot p a{color:var(--accent-dark);font-weight:800}
  .notification-map-section{border-top:1px solid var(--line)}.notification-map-layout{height:560px;margin-top:36px;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:#f1f3f4;box-shadow:0 20px 55px rgba(23,24,29,.06)}#notification-map{z-index:1;min-height:560px}.notification-map-section :global(.notification-map-filter){padding:0;border:0;background:none;cursor:pointer}
  @media(max-width:1050px){.notification-filters{grid-template-columns:repeat(3,1fr)}.notification-filters .member-search{grid-column:1/-1}.notification-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){.notification-filters,.notification-grid,.notification-create-heading,.notification-map-heading,.notification-form-row{grid-template-columns:1fr}.notification-filters .member-search{grid-column:auto}.notification-card{min-height:285px}.notification-create-heading,.notification-map-heading{gap:16px}.notification-create-card{padding:20px}.notification-form-foot{align-items:stretch;flex-direction:column}.notification-map-layout{height:380px}#notification-map{min-height:380px}}
</style>
