---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ideas from '../../data/ideas.json';
import { cities } from '../../data/cities';
import { directoryMembers as members } from '../../data/members';
import { formatDate, ideaContentType, ideaReadingMinutes, ideaSummary, ideaTypeLabels, plainText, type Idea } from '../../scripts/ideas';
import { memberUrl } from '../../scripts/members';
import '../../styles/directory.css';

const normalizePerson = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('sq').replace(/[^a-z0-9]/g, '');
const notifications = (ideas as Idea[])
  .map(idea => {
    const tags = idea.tags || [];
    const searchable = `${idea.title} ${plainText(idea.description)} ${tags.join(' ')}`.toLocaleLowerCase('sq');
    const city = cities.find(item => searchable.includes(item.city.toLocaleLowerCase('sq')));
    const authorName = idea.name || 'Anëtar i rrjetit';
    const author = idea.author_username
      ? members.find(member => member.username === idea.author_username)
      : members.find(member => normalizePerson(member.name) === normalizePerson(authorName) || normalizePerson(member.username) === normalizePerson(authorName));
    const type = ideaContentType(idea);
    return { ...idea, tags, city, type, searchable, authorName, authorUrl: author ? memberUrl(author.username) : `/anetaret/?search=${encodeURIComponent(authorName)}`, summary: ideaSummary(idea), readingMinutes: ideaReadingMinutes(idea) };
  })
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const categories = [...new Set(notifications.flatMap(item => item.tags))].sort((a, b) => a.localeCompare(b, 'sq'));
const referencedCities = [...new Map(notifications.filter(item => item.city).map(item => [item.city!.slug, item.city!])).values()].sort((a, b) => a.city.localeCompare(b.city, 'sq'));
const notificationCities = referencedCities.map(city => ({ ...city, count: notifications.filter(item => item.city?.slug === city.slug).length }));
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
---
<BaseLayout title="Postimet · Illyrian Brains" description="Udhëzues, mundësi, evente dhe histori nga komuniteti Illyrian Brains.">
  <Header />
  <main class="publication-page">
    <header class="publication-masthead"><div class="container publication-masthead-inner">
      <div><p class="eyebrow">Illyrian Brains</p><h1>Postimet</h1><p>Dije, përvoja dhe mundësi nga komuniteti shqiptar në botë.</p></div>
      <a class="publication-write" href="#njoftim-i-ri" data-open-notification>Shkruaj <span aria-hidden="true">→</span></a>
    </div></header>
    <div class="publication-nav"><div class="container">
        <div class="publication-sections" aria-label="Llojet e postimeve">
          <button type="button" data-type-value="" aria-pressed="true">Për ty</button>
          {Object.entries(ideaTypeLabels).map(([value, label]) => <button type="button" data-type-value={value} aria-pressed="false">{label}</button>)}
        </div>
    </div></div>
    <section class="publication-content"><div class="container publication-layout">
      <div class="publication-main">
        <div class="publication-feed-heading"><h2>Postimet e fundit</h2><p class="result-count" id="notification-result-count"></p></div>
        <div class="notification-grid" id="notification-grid" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}>
          {notifications.map((item, index) => (
            <article class:list={['notification-card', { 'is-featured': index === 0 }]} data-city={item.city?.slug || '__global'} data-type={item.type} data-categories={item.tags.map(tag => tag.toLocaleLowerCase('sq')).join('|')} data-search={item.searchable}>
              <div class="notification-card-info"><a class="notification-author" href={item.authorUrl}><span aria-hidden="true">●</span>{item.authorName}</a><span>{formatDate(item.date)}</span></div>
              <div class="notification-card-kicker"><strong>{ideaTypeLabels[item.type]}</strong><span aria-hidden="true">·</span>{item.city ? <a class="notification-location" href={`/qytetet/${item.city.slug}/`}>{item.city.city}</a> : <span>Rrjeti global</span>}</div>
              <h2><a href={`/projektet/ide/${encodeURIComponent(item.slug)}/`}>{item.title}</a></h2>
              <p>{item.summary}</p>
              <a class={`notification-card-visual type-${item.type}`} href={`/projektet/ide/${encodeURIComponent(item.slug)}/`} tabindex="-1" aria-hidden="true"><span>{ideaTypeLabels[item.type].slice(0, 1)}</span><small>{ideaTypeLabels[item.type]}</small></a>
              <footer><div class="notification-card-tags">{item.tags.slice(0, 2).map(tag => <span>{tag}</span>)}</div><span>{item.readingMinutes} min lexim</span></footer>
            </article>
          ))}
        </div>
        <p class="notification-empty" id="notification-empty" hidden>Asnjë postim nuk përputhet me kërkimin.</p>
        <div class="notification-more-wrap"><button type="button" class="partner-button" id="notification-more" hidden>Shfaq më shumë postime <span aria-hidden="true">↓</span></button></div>
      </div>
      <aside class="publication-sidebar" aria-label="Zbulo postime">
        <div class="publication-sidebar-block">
          <h2>Kërko</h2>
          <div class="member-filters notification-filters">
          <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="notification-search" type="search" placeholder="Kërko titull, temë ose fjalë kyçe…" aria-label="Kërko në postime" /></div>
          <select id="notification-type" aria-label="Filtro sipas llojit"><option value="">Të gjitha llojet</option>{Object.entries(ideaTypeLabels).map(([value, label]) => <option value={value}>{label}</option>)}</select>
          <select id="notification-city" aria-label="Filtro sipas qytetit"><option value="">Të gjitha qytetet</option><option value="__global">Rrjeti global</option>{referencedCities.map(city => <option value={city.slug}>{city.city}</option>)}</select>
          <select id="notification-category" aria-label="Filtro sipas temës"><option value="">Të gjitha temat</option>{categories.map(category => <option value={category.toLocaleLowerCase('sq')}>{category}</option>)}</select>
          </div>
        </div>
        <div class="publication-sidebar-block"><h2>Tema të njohura</h2><div class="publication-topic-list">{categories.slice(0, 10).map(category => <button type="button" data-topic-value={category.toLocaleLowerCase('sq')}>{category}</button>)}</div></div>
        <div class="publication-sidebar-cta"><strong>Ke diçka të dobishme për të ndarë?</strong><p>Shkruaj një udhëzues, histori ose mundësi për komunitetin.</p><a href="#njoftim-i-ri" data-open-notification>Shkruaj postim →</a></div>
      </aside>
    </div></section>

      <section class="section tone-grey notification-create-section"><div class="container">
        <details class="notification-create-panel" id="njoftim-i-ri">
          <summary><div class="notification-create-heading"><div><p class="eyebrow">Nga anëtarët</p><h2>Shkruaj një postim.</h2></div><p>Ndaj një udhëzues, histori, event, kërkesë ose mundësi. Jepi lexuesit një përmbledhje të qartë dhe temat e duhura.</p></div><span class="notification-create-toggle"><b>Hap formularin</b><i aria-hidden="true">↓</i></span></summary>
        <div class="notification-create-card" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}>
          <div class="notification-auth-prompt" id="notification-auth-prompt"><strong>Hyr për të publikuar</strong><p>Vetëm anëtarët e aprovuar mund të krijojnë njoftime.</p><a class="partner-button" href="/anetaresohu/profili/">Hyr në llogari <span aria-hidden="true">→</span></a></div>
          <form id="notification-form" hidden>
            <label>Titulli *<input name="title" required minlength="3" maxlength="160" placeholder="Një titull i qartë dhe konkret" /></label>
            <div class="notification-form-row">
              <label>Lloji *<select name="content_type" required><option value="">Zgjidh llojin</option>{Object.entries(ideaTypeLabels).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
              <label>Qyteti *<select name="city" required><option value="">Zgjidh qytetin</option>{cities.slice().sort((a,b) => a.city.localeCompare(b.city, 'sq')).map(city => <option value={city.city}>{city.city}, {city.country}</option>)}</select></label>
            </div>
            <label>Përmbledhja *<textarea name="summary" required maxlength="280" rows="3" placeholder="Në 1–2 fjali: çfarë do të gjejë lexuesi këtu?"></textarea></label>
            <label>Temat *<input name="categories" required maxlength="120" placeholder="p.sh. Punë, Arsim, Dokumente" /></label>
            <label>Përshkrimi *<textarea name="description" required maxlength="20000" rows="7" placeholder="Shkruaj informacionin e plotë për komunitetin…"></textarea></label>
            <label class="notification-email-option"><input type="checkbox" name="show_email" /> Lejo anëtarët të më kontaktojnë me email</label>
            <div class="notification-form-foot"><p id="notification-form-status" role="status" aria-live="polite"></p><button class="partner-button" type="submit">Publiko njoftimin <span aria-hidden="true">→</span></button></div>
          </form>
        </div>
        </details>
      </div></section>

      <section class="section tone-white notification-map-section"><div class="container">
        <p class="eyebrow">Sipas vendndodhjes</p><div class="notification-map-heading"><h2>Postimet në hartë.</h2><p>Shiko qytetet që përmenden në postimet e rrjetit. Zgjidh një pikë për të filtruar feed-in sipas qytetit.</p></div>
        <div class="notification-map-layout"><div id="notification-map" data-cities={JSON.stringify(notificationCities)} aria-label="Harta e qyteteve të përmendura në postime"></div></div>
      </div></section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const grid=document.querySelector<HTMLElement>('#notification-grid'),search=document.querySelector<HTMLInputElement>('#notification-search'),type=document.querySelector<HTMLSelectElement>('#notification-type'),city=document.querySelector<HTMLSelectElement>('#notification-city'),category=document.querySelector<HTMLSelectElement>('#notification-category'),count=document.querySelector<HTMLElement>('#notification-result-count'),empty=document.querySelector<HTMLElement>('#notification-empty'),more=document.querySelector<HTMLButtonElement>('#notification-more');
  const requestedType=new URLSearchParams(location.search).get('type');if(type&&requestedType&&[...type.options].some(option=>option.value===requestedType))type.value=requestedType;
  const sectionButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-type-value]')];
  const topicButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-topic-value]')];
  let cards=grid?[...grid.querySelectorAll<HTMLElement>('.notification-card')]:[];let expanded=false;
  const defaultFeedSize=10;
  const renderNotifications=()=>{const query=(search?.value||'').trim().toLocaleLowerCase('sq');const matched=cards.filter(card=>(!query||(card.dataset.search||'').includes(query))&&(!type?.value||card.dataset.type===type.value)&&(!city?.value||card.dataset.city===city.value)&&(!category?.value||(card.dataset.categories||'').split('|').includes(category.value)));const shown=new Set(expanded?matched:matched.slice(0,defaultFeedSize));cards.forEach(card=>card.hidden=!shown.has(card));if(count)count.textContent=`${matched.length} ${matched.length===1?'postim u gjet':'postime u gjetën'}`;if(empty)empty.hidden=matched.length>0;if(more)more.hidden=expanded||matched.length<=defaultFeedSize};
  const reset=()=>{expanded=false;renderNotifications()};search?.addEventListener('input',reset);[type,city,category].forEach(control=>control?.addEventListener('change',reset));more?.addEventListener('click',()=>{expanded=true;renderNotifications()});window.addEventListener('resize',renderNotifications);renderNotifications();
  const syncSections=()=>sectionButtons.forEach(button=>button.setAttribute('aria-pressed',String((type?.value||'')===(button.dataset.typeValue||''))));syncSections();type?.addEventListener('change',syncSections);sectionButtons.forEach(button=>button.addEventListener('click',()=>{if(!type)return;type.value=button.dataset.typeValue||'';type.dispatchEvent(new Event('change'))}));
  topicButtons.forEach(button=>button.addEventListener('click',()=>{if(!category)return;category.value=button.dataset.topicValue||'';category.dispatchEvent(new Event('change'));document.querySelector('.publication-main')?.scrollIntoView({behavior:'smooth',block:'start'})}));
  const offerLabels: Record<string,string> = { job: "Vend pune", internship: "Praktikë", event: "Event", project: "Projekt", volunteer: "Vullnetarë", benefit: "Përfitim / kupon", collaboration: "Bashkëpunim" };
  if (grid?.dataset.supabaseUrl && grid.dataset.supabaseKey) {
    const api = grid.dataset.supabaseUrl, key = grid.dataset.supabaseKey;
    fetch(api + "/rest/v1/public_organization_offers?select=*&order=created_at.desc", { headers: { apikey: key, ...(key.startsWith("eyJ") && { Authorization: "Bearer " + key }) } }).then(response => response.ok ? response.json() : Promise.reject(response.status)).then((offers: any[]) => {
      offers.forEach(offer => {
        if (document.getElementById("offer-" + offer.id)) return;
        const label = offerLabels[offer.kind] || "Ofertë", article = document.createElement("article");
        article.id = "offer-" + offer.id; article.className = "notification-card"; article.dataset.city = "__global"; article.dataset.type = "opportunity"; article.dataset.categories = label.toLocaleLowerCase("sq"); article.dataset.search = (offer.title + " " + offer.description + " " + offer.organization_name + " " + label).toLocaleLowerCase("sq");
        const meta = document.createElement("div"), place = document.createElement("span"), date = document.createElement("span"); meta.className = "notification-card-meta"; place.className = "notification-location"; place.textContent = "◎ Rrjeti global"; date.textContent = new Date(offer.created_at).toLocaleDateString("sq-AL"); meta.append(place, date);
        const tags = document.createElement("div"), tag = document.createElement("span"), active = document.createElement("span"); tags.className = "notification-card-tags"; tag.textContent = label; active.className = "notification-status is-active"; active.textContent = "Aktive"; tags.append(tag, active);
        const heading = document.createElement("h2"), title = document.createElement(offer.url ? "a" : "span"), description = document.createElement("p"); title.textContent = offer.title; if (offer.url) { title.setAttribute("href", offer.url); title.setAttribute("target", "_blank"); title.setAttribute("rel", "noreferrer"); } heading.append(title); description.textContent = offer.description;
        const footer = document.createElement("footer"), organization = document.createElement("span"), link = document.createElement("a"); organization.className = "notification-author"; organization.textContent = offer.organization_name; link.href = offer.url || "/organizatat/"; if (offer.url) { link.target = "_blank"; link.rel = "noreferrer"; } link.textContent = offer.url ? "Hap ofertën →" : "Shiko organizatat →"; footer.append(organization, link); article.append(meta, tags, heading, description, footer); grid.append(article);
        if (category && ![...category.options].some(option => option.value === article.dataset.categories)) category.add(new Option(label, article.dataset.categories));
      });
      cards = [...grid.querySelectorAll<HTMLElement>(".notification-card")]; renderNotifications();
    }).catch(() => {});
  }

  const createPanel=document.querySelector<HTMLDetailsElement>('#njoftim-i-ri');document.querySelector<HTMLAnchorElement>('[data-open-notification]')?.addEventListener('click',()=>{if(createPanel)createPanel.open=true});

  const createCard=document.querySelector<HTMLElement>('.notification-create-card'),form=document.querySelector<HTMLFormElement>('#notification-form'),prompt=document.querySelector<HTMLElement>('#notification-auth-prompt'),formStatus=document.querySelector<HTMLElement>('#notification-form-status');
  if(createCard&&form&&prompt){const {supabaseUrl,supabaseKey}=createCard.dataset;const stored=(()=>{try{return Object.keys(localStorage).some(key=>/^sb-.+-auth-token$/.test(key))}catch{return false}})();if(stored&&supabaseUrl&&supabaseKey){prompt.hidden=true;form.hidden=false;const submit=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;submit.disabled=true;Promise.all([import('@supabase/supabase-js'),import('../../scripts/member-session')]).then(async([{createClient},{memberSession}])=>{const client=createClient(supabaseUrl,supabaseKey);const {session}=await memberSession(client,false);if(!session){prompt.hidden=false;form.hidden=true;return}submit.disabled=false;form.addEventListener('submit',async event=>{event.preventDefault();submit.disabled=true;if(formStatus)formStatus.textContent='Duke publikuar…';const data=new FormData(form);const cityValue=String(data.get('city')||'').trim();const categories=String(data.get('categories')||'').split(',').map(value=>value.trim().replace(/^#+/,'')).filter(Boolean);const tags=[cityValue,...categories].slice(0,5);const {data:slug,error}=await client.rpc('submit_idea',{p:{title:String(data.get('title')||''),summary:String(data.get('summary')||''),content_type:String(data.get('content_type')||''),location:cityValue,description:String(data.get('description')||''),tags,wants_public:true,show_name:true,show_email:data.get('show_email')==='on'}});submit.disabled=false;if(error){if(formStatus)formStatus.textContent=`Nuk u publikua: ${error.message}`;return}form.reset();if(formStatus)formStatus.innerHTML=`U publikua me sukses. <a href="/projektet/ide/${encodeURIComponent(String(slug))}/">Hap postimin →</a>`})}).catch(()=>{prompt.hidden=false;form.hidden=true})}}
</script>

<script>
  import L from 'leaflet';

  const mapElement=document.querySelector<HTMLElement>('#notification-map');if(mapElement&&window.L){const mapped=JSON.parse(mapElement.dataset.cities||'[]'),map=L.map(mapElement,{scrollWheelZoom:false}).setView([44,8],3);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);const markers=mapped.map((mappedCity:any)=>L.circleMarker([mappedCity.lat,mappedCity.lng],{radius:Math.min(16,8+mappedCity.count),color:'#fff',weight:2,fillColor:'#744761',fillOpacity:.86}).bindTooltip(`${mappedCity.city} · ${mappedCity.count} ${mappedCity.count===1?'postim':'postime'}`,{direction:'top',offset:[0,-8]}).bindPopup(`<div class="map-popup"><strong>${mappedCity.city}</strong><span>${mappedCity.country}</span><small>${mappedCity.count} ${mappedCity.count===1?'postim':'postime'}</small><button class="map-popup-link notification-map-filter" type="button" data-city="${mappedCity.slug}">Shfaq postimet →</button></div>`).addTo(map));if(markers.length)map.fitBounds(L.featureGroup(markers).getBounds(),{padding:[38,38],maxZoom:6});mapElement.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('.notification-map-filter'),filter=document.querySelector<HTMLSelectElement>('#notification-city');if(!button||!filter)return;filter.value=button.dataset.city||'';filter.dispatchEvent(new Event('change'));document.querySelector('.publication-main')?.scrollIntoView({behavior:'smooth',block:'start'});map.closePopup()})}
</script>

<style>
  .publication-tools{display:grid;gap:16px}.publication-sections{display:flex;gap:24px;overflow-x:auto;border-bottom:1px solid var(--line);scrollbar-width:none}.publication-sections button{flex:none;padding:3px 0 12px;border:0;border-bottom:2px solid transparent;background:none;color:var(--muted);cursor:pointer;font:600 13px var(--font-body)}.publication-sections button[aria-pressed="true"]{border-bottom-color:var(--ink);color:var(--ink)}.notification-filters{display:grid;grid-template-columns:minmax(260px,1.5fr) repeat(3,minmax(150px,.7fr));gap:10px}.notification-filters>*{min-width:0}.notification-filters select{width:100%}.publication-feed-heading{display:flex;align-items:baseline;justify-content:space-between;max-width:900px;margin:44px auto 4px;border-bottom:1px solid var(--ink)}.publication-feed-heading h2{margin:0;padding-bottom:12px;font-size:17px}.publication-feed-heading .result-count{margin:0;padding-bottom:12px}.notification-grid{display:grid;max-width:900px;margin-inline:auto}.notification-card{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:28px;padding:28px 0;border-bottom:1px solid var(--line);background:#fff}.notification-card[hidden]{display:none}.notification-card-info,.notification-card-kicker,.notification-card h2,.notification-card>p{grid-column:1}.notification-card-info{display:flex;flex-wrap:wrap;gap:7px 12px;margin-bottom:11px;color:var(--muted);font-size:11px}.notification-card-info a{color:var(--ink);font-weight:750;text-decoration:none}.notification-author{display:inline-flex;align-items:center;gap:7px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.notification-author span{color:var(--accent);font-size:7px}.notification-card-kicker{display:flex;align-items:center;gap:7px;margin-bottom:8px;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.07em}.notification-card-kicker strong{color:var(--accent-dark)}.notification-card-kicker a{color:inherit;text-decoration:none}.notificatio