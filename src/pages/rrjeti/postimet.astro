---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RrjetiSection from '../../components/RrjetiSection.astro';
import ideas from '../../data/ideas.json';
import '../../styles/directory.css';
import { ideaRowHtml, type Idea } from '../../scripts/ideas';
const openIdeas=(ideas as Idea[]).filter(idea=>!idea.resolved).length;
const feedHtml=(ideas as Idea[]).slice(0,30).map((idea,index)=>ideaRowHtml(idea,idea.id??ideas.length-index,true)).reverse().join('');
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
// Writing is switched off for now: member posts (create_post) and ideas/requests
// (submit_idea). With both off the composer is hidden; existing posts and ideas are
// still shown and reload live. Set either to true to bring that kind back.
const postsEnabled = false;
const ideasEnabled = false;
const writingEnabled = postsEnabled || ideasEnabled;
---
<BaseLayout title="Postimet · Illyrian Brains" description="Lajme, kërkesa, vende pune dhe mundësi bashkëpunimi nga rrjeti Illyrian Brains.">
  <Header />
  <main>
    <RrjetiSection eyebrow="Nga komuniteti" title="Postime." description="Lajme, kërkesa, vende pune dhe mundësi bashkëpunimi nga rrjeti." stats={[{ value: ideas.length, label: 'Publikime' }, { value: openIdeas, label: 'Ende aktive' }, { value: ideas.length - openIdeas, label: 'Të zgjidhura' }]}>
      {postsEnabled
        ? <a slot="actions" href="#post-body" data-compose="post">Shkruaj postim <span aria-hidden="true">→</span></a>
        : ideasEnabled && <a slot="actions" href="#shkruaj-ide" data-compose="idea">Shto një mundësi <span aria-hidden="true">→</span></a>}
      <div slot="results" class="chat" id="chat" data-view="list">
        <aside class="chat-channels" aria-label="Kanalet">
          <div class="chat-channels-head"><p class="chat-channels-title">Kanalet</p><button type="button" class="chat-collapse" id="chat-collapse" aria-expanded="true" aria-controls="chat-channels" title="Mbyll kanalet">«</button></div>
          <label class="chat-search"><span aria-hidden="true">⌕</span><input id="activity-search" type="search" placeholder="Kërko kanal ose mesazh…" aria-label="Kërko kanale, postime dhe mundësi" /></label>
          <ul class="chat-channel-list" id="chat-channels"></ul>
        </aside>
        <div class="chat-pane">
          <header class="chat-pane-head">
            <button type="button" class="chat-back" id="chat-back" aria-label="Kthehu te kanalet">←</button>
            <span class="chat-channel-avatar" id="chat-pane-avatar" aria-hidden="true">#</span>
            <div><strong id="chat-pane-title">Të gjitha</strong><small id="chat-pane-meta"></small></div>
          </header>
          <div class="chat-messages" id="chat-messages"><ul class="idea-list unified-feed" id="unified-feed" set:html={feedHtml}></ul><p class="activity-empty" id="activity-empty" hidden>Asnjë mesazh në këtë kanal.</p></div>
      <section class="activity-composer" id="composer" aria-label="Shkruaj në rrjet" hidden={!writingEnabled} data-writing-enabled={String(writingEnabled)} data-posts-enabled={String(postsEnabled)} data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} data-built-slugs={JSON.stringify((ideas as Idea[]).map(idea => idea.slug))}>
        <button type="button" class="composer-toggle" id="composer-toggle" aria-expanded="true" aria-controls="composer" title="Mbyll"><span class="composer-toggle-label">✎ Shkruaj në rrjet</span><span class="composer-toggle-icon" aria-hidden="true">⌄</span></button>
        <div class="activity-composer-signed-out" id="composer-signed-out">
          <p><strong>Ke diçka për rrjetin?</strong> Hyr si anëtar për të {postsEnabled ? 'shkruar një postim ose për të ' : ''}publikuar një mundësi a kërkesë.</p>
          <div><a class="partner-button" href="/anetaresohu/profili/">Hyr <span aria-hidden="true">→</span></a><a class="activity-composer-alt" href="/anetaresohu/regjistrohu/">Regjistrohu</a></div>
        </div>
        <form class="activity-composer-form" id="composer-form" data-kind={postsEnabled ? 'post' : 'idea'} hidden>
          <fieldset class="activity-composer-kind" aria-label="Çfarë po shkruan?" hidden={!postsEnabled}>
            {postsEnabled && <label><input type="radio" name="kind" value="post" checked /> Postim</label>}
            <label><input type="radio" name="kind" value="idea" checked={!postsEnabled} /> Mundësi / kërkesë</label>
          </fieldset>
          <div class="activity-composer-idea">
            <label>Titulli *<input name="title" minlength="3" maxlength="160" placeholder="p.sh. Kërkoj bashkëpunëtor për një projekt në Mynih" /></label>
          </div>
          <label class="activity-composer-body"><span id="composer-body-label">Ndaj diçka me rrjetin</span><textarea id="post-body" name="body" rows="2" maxlength="3000" required placeholder="Një projekt i ri, një event, një pyetje për komunitetin…"></textarea></label>
          <label>Etiketat<input name="tags" maxlength="200" placeholder="p.sh. Berlin, punë, IT — deri në 5, të ndara me presje" /></label>
          <div class="activity-composer-idea activity-composer-options">
            <label class="profile-editor-check"><input type="radio" name="visibility" value="public" checked /> Publike te Postimet</label>
            <label class="profile-editor-check"><input type="radio" name="visibility" value="team" /> Vetëm ekipi i IB</label>
            <label class="profile-editor-check" data-public-only><input type="checkbox" name="show_name" checked /> Shfaq emrin tim</label>
            <label class="profile-editor-check" data-public-only><input type="checkbox" name="show_email" /> Shfaq emailin tim, që të tjerët të më shkruajnë direkt</label>
          </div>
          <div class="activity-composer-foot">
            <small id="composer-hint">Postimet janë publike dhe dalin edhe në profilin tënd.</small>
            <button class="partner-button" type="submit">Posto <span aria-hidden="true">→</span></button>
          </div>
        </form>
        <p class="profile-editor-status" id="composer-status" role="status" aria-live="polite"></p>
      </section>
        </div>
      </div>
    </RrjetiSection>
  </main>
  <Footer />
</BaseLayout>
<script>
  // WhatsApp-style: each tag (supabase/009-tags.sql) is a channel on the left, newest
  // activity first; "Të gjitha" shows everything and "Të përgjithshme" the untagged items.
  // An item with several tags shows in each of their channels. Messages run oldest → newest.
  const ALL = '', GENERAL = '__general';
  const chat = document.querySelector<HTMLElement>('#chat')!;
  const channelList = document.querySelector<HTMLElement>('#chat-channels')!;
  const messages = document.querySelector<HTMLElement>('#chat-messages')!;
  const activitySearch = document.querySelector<HTMLInputElement>('#activity-search')!;
  const activityEmpty = document.querySelector<HTMLElement>('#activity-empty')!;
  const feedItems = () => [...document.querySelectorAll<HTMLElement>('#unified-feed>li')];
  const keyOf = (tag: string) => tag.toLocaleLowerCase('sq');
  const tagsOf = (item: HTMLElement): string[] => { try { return JSON.parse(item.dataset.tags || '[]'); } catch { return []; } };
  const previewOf = (item: HTMLElement) => {
    const author = item.querySelector('.post-card-author strong')?.textContent || '';
    const text = (item.querySelector('.idea-row-title, .offer-card-title, .post-card-body')?.textContent || '').trim();
    return author ? `${author}: ${text}` : text;
  };
  const shortDate = (date?: string) => {
    if (!date || isNaN(Date.parse(date))) return '';
    const day = new Date(date);
    return day.toDateString() === new Date().toDateString()
      ? day.toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' })
      : day.toLocaleDateString('sq-AL', { day: 'numeric', month: 'short' });
  };
  let channel = ALL;
  let channelLabel = 'Të gjitha';
  let prefilledTag = '';

  const render = () => {
    const query = activitySearch.value.trim().toLocaleLowerCase('sq');
    const matches = (item: HTMLElement) => !query || (item.dataset.search || item.textContent || '').toLocaleLowerCase('sq').includes(query);
    const channels = new Map<string, { label: string; items: HTMLElement[] }>([[ALL, { label: 'Të gjitha', items: [] }]]);
    feedItems().forEach(item => {
      const tags = tagsOf(item);
      const own = tags.length ? tags.map(tag => [keyOf(tag), tag]) : [[GENERAL, 'Të përgjithshme']];
      new Map([[ALL, 'Të gjitha'], ...own] as [string, string][]).forEach((label, key) => {
        if (!channels.has(key)) channels.set(key, { label, items: [] });
        channels.get(key)!.items.push(item);
      });
    });
    // A channel whose name matches the search shows all its messages, otherwise only the matching ones.
    const shown = new Map([...channels].map(([key, { label, items }]) => [key, { label, items: label.toLocaleLowerCase('sq').includes(query) ? items : items.filter(matches) }]));
    const latest = (items: HTMLElement[]) => items.reduce((max, item) => (item.dataset.date || '') > max ? item.dataset.date || '' : max, '');
    const visible = [...shown].filter(([key, { items }]) => key === ALL || items.length)
      .sort(([a, x], [b, y]) => a === ALL ? -1 : b === ALL ? 1 : latest(y.items).localeCompare(latest(x.items)));
    if (!shown.has(channel) || (channel !== ALL && !shown.get(channel)!.items.length)) channel = ALL;
    channelList.replaceChildren(...visible.map(([key, { label, items }]) => {
      const last = items[items.length - 1];
      const row = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'chat-channel';
      button.setAttribute('aria-current', String(key === channel));
      button.title = `${label} — ${last ? `${shortDate(last.dataset.date)} · ${previewOf(last)}` : 'Asnjë mesazh ende'}`;
      const icon = document.createElement('span');
      icon.className = 'chat-channel-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = key === ALL ? '★' : key === GENERAL ? '💬' : '#';
      const name = document.createElement('span');
      name.className = 'chat-channel-name';
      name.textContent = label;
      const count = document.createElement('span');
      count.className = 'chat-channel-count';
      count.textContent = String(items.length);
      button.append(icon, name, count);
      button.addEventListener('click', () => { selectChannel(key, label); chat.dataset.view = 'pane'; });
      row.append(button);
      return row;
    }));
    const current = shown.get(channel)!;
    channelLabel = current.label;
    const inPane = new Set(current.items);
    feedItems().forEach(item => item.hidden = !inPane.has(item));
    activityEmpty.hidden = inPane.size > 0;
    document.querySelector('#chat-pane-title')!.textContent = channel === ALL || channel === GENERAL ? current.label : `#${current.label}`;
    document.querySelector('#chat-pane-avatar')!.textContent = channel === ALL ? '★' : channel === GENERAL ? '💬' : '#';
    document.querySelector('#chat-pane-meta')!.textContent = `${inPane.size} ${inPane.size === 1 ? 'mesazh' : 'mesazhe'}`;
  };

  // Opening a channel jumps to its newest message and puts its tag in the composer
  // (unless the member already typed their own tags).
  function selectChannel(key: string, label: string) {
    channel = key;
    render();
    messages.scrollTop = messages.scrollHeight;
    const tagsInput = document.querySelector<HTMLInputElement>('#composer-form input[name="tags"]');
    if (tagsInput && (!tagsInput.value.trim() || tagsInput.value === prefilledTag)) {
      prefilledTag = key === ALL || key === GENERAL ? '' : label;
      tagsInput.value = prefilledTag;
    }
  }
  document.querySelector('#chat-back')!.addEventListener('click', () => chat.dataset.view = 'list');
  // Desktop: the sidebar folds down to a strip of channel icons; the choice is remembered per browser.
  const collapse = document.querySelector<HTMLButtonElement>('#chat-collapse')!;
  const setCollapsed = (collapsed: boolean) => {
    chat.dataset.collapsed = String(collapsed);
    collapse.setAttribute('aria-expanded', String(!collapsed));
    collapse.textContent = collapsed ? '»' : '«';
    collapse.title = collapsed ? 'Hap kanalet' : 'Mbyll kanalet';
  };
  try { setCollapsed(localStorage.getItem('postimet-channels-collapsed') === '1'); } catch {}
  collapse.addEventListener('click', () => {
    const collapsed = chat.dataset.collapsed !== 'true';
    setCollapsed(collapsed);
    try { localStorage.setItem('postimet-channels-collapsed', collapsed ? '1' : '0'); } catch {}
  });
  activitySearch.addEventListener('input', render);
  render();
  messages.scrollTop = messages.scrollHeight;

  // Writing lives here (it used to be on /anetaresohu/rrjeti/ and /anetaresohu/kerkesat/):
  // a post (create_post, supabase/007-social.sql) or an idea/request (submit_idea,
  // 005-ideas.sql). The board above was built at the last deploy with ideas only; it is
  // reloaded live with the published ideas and the members' posts, oldest first like a chat.
  // supabase-js is loaded only for signed-in visitors.
  import { ideaFromRow, ideaRowHtml, type Idea } from '../../scripts/ideas';
  import { postElement, type MemberPost } from '../../scripts/members';

  const composer = document.querySelector<HTMLElement>('#composer')!;
  const form = document.querySelector<HTMLFormElement>('#composer-form')!;
  const feed = document.querySelector<HTMLElement>('#unified-feed')!;
  const statusLine = document.querySelector<HTMLElement>('#composer-status')!;
  const body = form.querySelector<HTMLTextAreaElement>('#post-body')!;
  const say = (text: string, kind = '') => { statusLine.textContent = text; statusLine.dataset.kind = kind; };
  const { supabaseUrl, supabaseKey } = composer.dataset;
  const builtSlugs = new Set<string>(JSON.parse(composer.dataset.builtSlugs || '[]'));
  const headers = { apikey: supabaseKey || '', ...(supabaseKey?.startsWith('eyJ') && { Authorization: `Bearer ${supabaseKey}` }) };
  const read = (path: string) => fetch(`${supabaseUrl}/rest/v1/${path}`, { headers }).then(response => response.ok ? response.json() : Promise.reject(response.status));
  let me: { username: string | null; isAdmin: boolean } | null = null;
  let supabase: any = null;

  const postsEnabled = composer.dataset.postsEnabled === 'true';
  const kindValue = () => postsEnabled ? form.querySelector<HTMLInputElement>('input[name="kind"]:checked')!.value : 'idea';
  const syncKind = () => {
    const isIdea = kindValue() === 'idea';
    form.dataset.kind = isIdea ? 'idea' : 'post';
    form.querySelector<HTMLInputElement>('input[name="title"]')!.required = isIdea;
    body.required = !isIdea;
    body.maxLength = isIdea ? 20000 : 3000;
    body.placeholder = isIdea ? 'Çfarë kërkon ose çfarë ofron? Mund të përdorësh Markdown: **i theksuar**, - lista, [link](https://…)' : 'Një projekt i ri, një event, një pyetje për komunitetin…';
    document.querySelector('#composer-body-label')!.textContent = isIdea ? 'Përshkrimi' : 'Ndaj diçka me rrjetin';
    const isPublic = form.querySelector<HTMLInputElement>('input[name="visibility"]:checked')!.value === 'public';
    form.querySelectorAll<HTMLElement>('[data-public-only]').forEach(label => label.hidden = !isPublic);
    document.querySelector('#composer-hint')!.textContent = !isIdea ? 'Postimet janë publike dhe dalin edhe në profilin tënd.'
      : isPublic ? 'Del menjëherë te Postimet si mundësi.' : 'E sheh vetëm ekipi i IB, nuk del publikisht.';
  };
  form.querySelectorAll<HTMLInputElement>('input[name="kind"], input[name="visibility"]').forEach(input => input.addEventListener('change', syncKind));

  // "Shkruaj postim" (and links from elsewhere: #post-body, #shkruaj-ide)
  // open the chat pane, pick the kind and put the cursor in the form, or show the sign-in prompt.
  // The writing bar folds like the sidebar (one line, "Shkruaj në rrjet"); remembered per browser.
  const composerToggle = document.querySelector<HTMLButtonElement>('#composer-toggle')!;
  const setComposerCollapsed = (collapsed: boolean) => {
    chat.dataset.composerCollapsed = String(collapsed);
    composerToggle.setAttribute('aria-expanded', String(!collapsed));
    composerToggle.title = collapsed ? 'Hap' : 'Mbyll';
    try { localStorage.setItem('postimet-composer-collapsed', collapsed ? '1' : '0'); } catch {}
  };
  try { if (localStorage.getItem('postimet-composer-collapsed') === '1') setComposerCollapsed(true); } catch {}
  composerToggle.addEventListener('click', () => {
    const collapsed = chat.dataset.composerCollapsed !== 'true';
    setComposerCollapsed(collapsed);
    if (!collapsed && !form.hidden) body.focus();
  });

  const openComposer = (kind: string) => {
    if (!postsEnabled) kind = 'idea';
    chat.dataset.view = 'pane';
    if (chat.dataset.composerCollapsed === 'true') setComposerCollapsed(false);
    if (form.hidden) return composer.scrollIntoView({ behavior: 'smooth', block: 'center' });
    form.querySelector<HTMLInputElement>(`input[name="kind"][value="${kind}"]`)!.checked = true;
    syncKind();
    composer.scrollIntoView({ behavior: 'smooth', block: 'center' });
    (kind === 'idea' ? form.querySelector<HTMLInputElement>('input[name="title"]')! : body).focus({ preventScroll: true });
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-compose]').forEach(link => link.addEventListener('click', event => {
    event.preventDefault();
    openComposer(link.dataset.compose!);
  }));

  // One post as a note on the board; its author or an admin can delete it.
  const postNote = (post: MemberPost) => {
    const item = document.createElement('li');
    item.className = me && me.username === post.username ? 'post-note is-mine' : 'post-note';
    item.dataset.date = post.created_at;
    item.dataset.search = `${post.name} ${post.body} ${(post.tags || []).join(' ')}`.toLocaleLowerCase('sq');
    item.dataset.tags = JSON.stringify(post.tags || []);
    const canDelete = me && (me.isAdmin || me.username === post.username);
    item.append(postElement(post, canDelete ? async () => {
      if (!confirm('Të fshihet ky postim?')) return;
      const { error } = await supabase.rpc('delete_post', { p_id: post.id });
      if (error) say(`Nuk u fshi: ${error.message}`, 'error');
      else loadFeed();
    } : undefined));
    return item;
  };

  interface OrganizationOffer {
    id: string;
    kind: 'project' | 'volunteer' | 'benefit' | 'collaboration';
    title: string;
    description: string;
    url: string | null;
    expires_at: string | null;
    created_at: string;
    organization_name: string;
    organization_kind: string;
    organization_logo: string | null;
  }
  const offerLabels: Record<OrganizationOffer['kind'], string> = {
    project: 'Projekt',
    volunteer: 'Vullnetarizëm',
    benefit: 'Përfitim',
    collaboration: 'Bashkëpunim',
  };
  const offerNote = (offer: OrganizationOffer) => {
    const item = document.createElement('li');
    item.id = `offer-${offer.id}`;
    item.className = 'offer-note';
    item.dataset.date = offer.created_at;
    const kindLabel = offerLabels[offer.kind] || 'Ofertë';
    item.dataset.tags = JSON.stringify(['Oferta', kindLabel, offer.organization_name]);
    item.dataset.search = `${offer.organization_name} ${kindLabel} ${offer.title} ${offer.description}`.toLocaleLowerCase('sq');

    const card = document.createElement('article');
    card.className = 'offer-card';
    const header = document.createElement('header');
    header.className = 'offer-card-head';
    const identity = document.createElement('div');
    identity.className = 'offer-card-identity';
    if (offer.organization_logo) {
      const logo = document.createElement('img');
      logo.src = offer.organization_logo;
      logo.alt = '';
      logo.loading = 'lazy';
      identity.append(logo);
    } else {
      const fallback = document.createElement('span');
      fallback.textContent = offer.organization_name.slice(0, 1).toUpperCase();
      fallback.setAttribute('aria-hidden', 'true');
      identity.append(fallback);
    }
    const meta = document.createElement('div');
    const organization = document.createElement('strong');
    organization.textContent = offer.organization_name;
    const date = document.createElement('small');
    date.textContent = new Date(offer.created_at).toLocaleDateString('sq-AL', { day: 'numeric', month: 'short', year: 'numeric' });
    meta.append(organization, date);
    identity.append(meta);
    const badge = document.createElement('span');
    badge.className = 'offer-card-kind';
    badge.textContent = kindLabel;
    header.append(identity, badge);

    const title = document.createElement('h3');
    title.className = 'offer-card-title';
    title.textContent = offer.title;
    const description = document.createElement('p');
    description.className = 'post-card-body';
    description.textContent = offer.description;
    card.append(header, title, description);

    const footer = document.createElement('footer');
    if (offer.expires_at) {
      const expiry = document.createElement('small');
      expiry.textContent = `Afati: ${new Date(offer.expires_at).toLocaleDateString('sq-AL', { day: 'numeric', month: 'long', year: 'numeric' })}`;
      footer.append(expiry);
    }
    if (offer.url) {
      const link = document.createElement('a');
      link.href = offer.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = 'Hap ofertën →';
      footer.append(link);
    }
    if (footer.childNodes.length) card.append(footer);
    item.append(card);
    return item;
  };

  async function loadFeed() {
    if (!supabaseUrl || !supabaseKey) return;
    const [ideaRows, posts, offers] = await Promise.all([
      read('public_ideas?select=*&order=created_at.desc&limit=30').catch(() => null),
      read('public_member_posts?select=*&order=created_at.desc&limit=30').catch(() => []),
      read('public_organization_offers?select=*&order=created_at.desc&limit=30').catch(() => []),
    ]);
    if (!ideaRows) return;   // keep the board as built
    const ideas: Idea[] = ideaRows.map(ideaFromRow);
    const items = [
      ...ideas.map(idea => ({ date: idea.date || '', html: ideaRowHtml(idea, idea.id!, builtSlugs.has(idea.slug)) })),
      ...(posts as MemberPost[]).map(post => ({ date: post.created_at, post })),
      ...(offers as OrganizationOffer[]).map(offer => ({ date: offer.created_at, offer })),
    ].sort((a, b) => a.date.localeCompare(b.date));
    feed.replaceChildren(...items.map(item => {
      if ('post' in item) return postNote(item.post!);
      if ('offer' in item) return offerNote(item.offer!);
      const template = document.createElement('template');
      template.innerHTML = item.html!;
      return template.content.firstElementChild!;
    }));
    const atBottom = messages.scrollHeight - messages.scrollTop - messages.clientHeight < 40;
    render();
    const linkedOffer = location.hash.startsWith('#offer-') ? document.querySelector<HTMLElement>(location.hash) : null;
    if (linkedOffer) linkedOffer.scrollIntoView({ behavior: 'smooth', block: 'center' });
    else if (atBottom) messages.scrollTop = messages.scrollHeight;
  }

  form.addEventListener('submit', async event => {
    event.preventDefault();
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value.trim();
    const checked = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).checked;
    const isIdea = kindValue() === 'idea';
    const postTags = value('tags').split(',').map(tag => tag.trim().replace(/^#+/, '')).filter(Boolean);
    const wantsPublic = form.querySelector<HTMLInputElement>('input[name="visibility"]:checked')!.value === 'public';
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submit.disabled = true;
    say('Duke dërguar…');
    const { error } = isIdea
      ? await supabase.rpc('submit_idea', { p: {
        title: value('title'), tags: postTags, description: value('body'),
        wants_public: wantsPublic, show_name: wantsPublic && checked('show_name'), show_email: wantsPublic && checked('show_email'),
      } })
      : await supabase.rpc('create_post', { p_body: body.value, p_tags: postTags });
    submit.disabled = false;
    if (error) return say(`Nuk u dërgua: ${error.message}`, 'error');
    form.reset();
    form.querySelector<HTMLInputElement>('input[name="tags"]')!.value = prefilledTag;
    syncKind();
    say(!isIdea ? 'U postua.' : wantsPublic ? 'Faleminderit! U publikua te Postimet.' : 'Faleminderit! U dërgua te ekipi i IB.', 'ok');
    await loadFeed();
    messages.scrollTop = messages.scrollHeight;
  });

  async function start() {
    const signedIn = (() => { try { return Object.keys(localStorage).some(key => /^sb-.+-auth-token$/.test(key)); } catch { return false; } })();
    if (composer.dataset.writingEnabled === 'true' && signedIn && supabaseUrl && supabaseKey) {
      // Show the form straight away for a stored session, so a signed-in member never sees
      // the "Hyr" prompt while supabase-js loads; Posto waits until the session is checked.
      const signedOut = document.querySelector<HTMLElement>('#composer-signed-out')!;
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      signedOut.hidden = true;
      form.hidden = false;
      submit.disabled = true;
      syncKind();
      if (location.hash === '#post-body') openComposer('post');
      if (location.hash === '#shkruaj-ide') openComposer('idea');
      const [{ createClient }, { memberSession }] = await Promise.all([import('@supabase/supabase-js'), import('../../scripts/member-session')]);
      supabase = createClient(supabaseUrl, supabaseKey);
      const { session } = await memberSession(supabase, false);
      if (session) {
        const [{ data: network }, { data: isAdmin }] = await Promise.all([supabase.rpc('my_network'), supabase.rpc('is_admin')]);
        me = { username: network?.username || null, isAdmin: Boolean(isAdmin) };
        submit.disabled = false;
        if (!network) say('Profili yt pret aprovimin nga ekipi i IB. Sapo të aprovohet, mund të postosh këtu.');
      } else {
        signedOut.hidden = false;
        form.hidden = true;
      }
    }
    loadFeed();
  }
  start();
</script>
