---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NetworkGraphic from '../components/NetworkGraphic.astro';
import { cities, defaultCityImage } from '../data/cities';
import { cityRegions } from '../data/regions';
import { members } from '../data/members';
const bySlug = (slug:string) => cities.find(city => city.slug === slug);
const directoryCities = cityRegions.flatMap(region => region.citySlugs.map(bySlug).filter(Boolean).map(city => ({ ...city!, region: region.name }))).sort((a,b) => a.city.localeCompare(b.city,'sq'));
const countries = [...new Set(cities.map(city => city.country))].sort((a,b) => a.localeCompare(b,'sq'));
const groups = [...new Set(members.flatMap(member => member.groups))].sort();
const memberCities = [...new Set(members.map(member => member.city).filter((city):city is string => Boolean(city)))].sort();
---
<BaseLayout title="Rrjeti · Illyrian Brains" description="Eksploro qytetet, anëtarët dhe lidhjet profesionale të rrjetit Illyrian Brains.">
  <Header />
  <main class="network-page">
    <section class="section tone-dark network-overview"><div class="container network-overview-grid">
      <div class="network-overview-copy"><p class="eyebrow">Illyrian Brains Network</p><h1>Një rrjet profesionistësh.</h1><p>Shih ku jemi, njih profesionistët e komunitetit dhe zbulo fushat që na lidhin.</p><nav class="network-jump" aria-label="Seksionet e rrjetit"><a href="#qytetet"><span>01</span> Qytetet</a><a href="#anetaret"><span>02</span> Anëtarët</a></nav></div>
      <NetworkGraphic />
    </div></section>

    <section class="section tone-white" id="qytetet"><div class="container">
      <header class="network-section-heading"><div><p class="eyebrow">01 · Komunitetet lokale</p><h2>Gjej komunitetin pranë teje.</h2></div><p>Qytetet janë pika e nisjes së rrjetit: aty lindin njohjet, aktivitetet dhe bashkëpunimet lokale.</p></header>
      <div class="city-directory-stats"><strong id="city-stat-total">{directoryCities.length}</strong><span>qytete në rrjet</span></div>
      <div class="member-filters city-filters">
        <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="city-search" type="search" placeholder="Kërko qytet ose shtet…" aria-label="Kërko qytete"/></div>
        <select id="city-region-filter" aria-label="Filtro sipas rajonit"><option value="">Të gjitha rajonet</option>{cityRegions.map(region=><option value={region.name}>{region.name}</option>)}</select>
        <select id="city-country-filter" aria-label="Filtro sipas shtetit"><option value="">Të gjitha shtetet</option>{countries.map(country=><option value={country}>{country}</option>)}</select>
        <select id="city-sort" aria-label="Rendit qytetet"><option value="city">Qyteti (A–Z)</option><option value="country">Shteti (A–Z)</option></select>
      </div>
      <p class="result-count" id="city-result-count"></p>
      <div class="member-grid city-directory-grid" id="city-directory-grid" data-cities={JSON.stringify(directoryCities)} data-fallback={defaultCityImage}>
        {directoryCities.map(city => <a class="member-card city-directory-card" href={`/qytetet/${city.slug}/`}><div class="member-card-top"><img class="member-avatar city-directory-image" src={encodeURI(city.image || defaultCityImage)} alt="" loading="lazy"/><div><p class="member-card-name">{city.city}</p><p class="member-card-role">{city.country}</p></div><span class="city-directory-arrow" aria-hidden="true">↗</span></div></a>)}
      </div>
      <p class="grid-hint" id="city-grid-hint"></p>
    </div></section>

    <section class="section tone-grey" id="anetaret"><div class="container">
      <header class="network-section-heading"><div><p class="eyebrow">02 · Drejtoria</p><h2>Njih profesionistët e rrjetit.</h2></div><p>Profilet vijnë nga grupet publike të forumit: Bordi, Ekipet, Nismat, Qytetet dhe Teknologji.</p></header>
      <div class="member-stats"><div><strong id="stat-total">{members.length}</strong><span>Anëtarë të listuar</span></div><div><strong>{memberCities.length}</strong><span>Qytete</span></div><div><strong>5000+</strong><span>Madhësia e rrjetit</span></div></div>
      <div class="member-filters"><div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="member-search" type="search" placeholder="Kërko sipas emrit…" aria-label="Kërko anëtarë"/></div><select id="filter-group"><option value="">Të gjitha grupet</option>{groups.map(group=><option value={group}>{group}</option>)}</select><select id="filter-city"><option value="">Të gjitha qytetet</option>{memberCities.map(city=><option value={city}>{city}</option>)}</select></div>
      <p class="result-count" id="result-count"></p><div class="member-grid" id="member-grid" data-members={JSON.stringify(members)}></div>
      <p class="grid-hint" id="member-grid-hint"></p>
    </div></section>
  </main>
  <Footer />
  <div class="member-drawer-overlay" id="member-overlay"></div><aside class="member-drawer" id="member-drawer" aria-hidden="true"><div class="member-drawer-inner" id="member-drawer-content"></div></aside>
</BaseLayout>
<script>
  // When no filter is active, cap the grid to two rows (measured from real card
  // positions, so it adapts to however many columns actually fit); any active
  // filter (search/select) reveals the full matching list. Returns the applied
  // row limit, or -1 when nothing was hidden.
  const applyRowLimit=(gridEl:HTMLElement,active:boolean,rows=2):number=>{const cards=Array.from(gridEl.children).filter((el):el is HTMLElement=>el instanceof HTMLElement);if(active||!cards.length){cards.forEach(c=>{c.style.display=''});return -1}const top=cards[0].offsetTop;let cols=0;for(const c of cards){if(c.offsetTop===top)cols++;else break}if(!cols)cols=1;const limit=cols*rows;cards.forEach((c,i)=>{c.style.display=i<limit?'':'none'});return cards.length>limit?limit:-1};
  const cityGrid=document.querySelector<HTMLElement>('#city-directory-grid'),citySearch=document.querySelector<HTMLInputElement>('#city-search'),cityRegion=document.querySelector<HTMLSelectElement>('#city-region-filter'),cityCountry=document.querySelector<HTMLSelectElement>('#city-country-filter'),citySort=document.querySelector<HTMLSelectElement>('#city-sort'),cityCount=document.querySelector<HTMLElement>('#city-result-count'),cityTotal=document.querySelector<HTMLElement>('#city-stat-total'),cityHint=document.querySelector<HTMLElement>('#city-grid-hint');
  if(cityGrid){const cities=JSON.parse(cityGrid.dataset.cities||'[]'),fallback=cityGrid.dataset.fallback||'';const renderCities=()=>{const query=(citySearch?.value||'').trim().toLocaleLowerCase('sq');const filterActive=!!(query||cityRegion?.value||cityCountry?.value);const list=cities.filter((item:any)=>(!query||`${item.city} ${item.country}`.toLocaleLowerCase('sq').includes(query))&&(!cityRegion?.value||item.region===cityRegion.value)&&(!cityCountry?.value||item.country===cityCountry.value)).sort((a:any,b:any)=>(citySort?.value==='country'?`${a.country} ${a.city}`:`${a.city} ${a.country}`).localeCompare(citySort?.value==='country'?`${b.country} ${b.city}`:`${b.city} ${b.country}`,'sq'));if(cityTotal)cityTotal.textContent=String(list.length);if(cityCount)cityCount.textContent=`${list.length} qytet${list.length===1?'':'e'} u gjet${list.length===1?'':'ën'}`;cityGrid.innerHTML=list.length?list.map((item:any)=>`<a class="member-card city-directory-card" href="/qytetet/${item.slug}/"><div class="member-card-top"><img class="member-avatar city-directory-image" src="${encodeURI(item.image||fallback)}" alt="" loading="lazy"><div><p class="member-card-name">${item.city}</p><p class="member-card-role">${item.country}</p></div><span class="city-directory-arrow" aria-hidden="true">↗</span></div></a>`).join(''):'<p class="member-empty">Asnjë qytet nuk përputhet me filtrat. Provo një kërkim tjetër.</p>';const shown=applyRowLimit(cityGrid,filterActive);if(cityHint)cityHint.textContent=shown>=0?`Po shfaqen ${shown} nga ${list.length} qytete — kërko ose zgjidh një filtër për t'i parë të gjitha.`:''};[citySearch,cityRegion,cityCountry,citySort].forEach(control=>control?.addEventListener(control===citySearch?'input':'change',renderCities));renderCities()}
  const grid=document.querySelector<HTMLElement>('#member-grid'),search=document.querySelector<HTMLInputElement>('#member-search'),group=document.querySelector<HTMLSelectElement>('#filter-group'),city=document.querySelector<HTMLSelectElement>('#filter-city'),count=document.querySelector<HTMLElement>('#result-count'),total=document.querySelector<HTMLElement>('#stat-total'),hint=document.querySelector<HTMLElement>('#member-grid-hint'),overlay=document.querySelector<HTMLElement>('#member-overlay'),drawer=document.querySelector<HTMLElement>('#member-drawer'),content=document.querySelector<HTMLElement>('#member-drawer-content');
  if(grid){const members=JSON.parse(grid.dataset.members||'[]');const initials=(name:string)=>name.split(' ').map((part:string)=>part[0]).join('').slice(0,2).toUpperCase();const pills=(member:any)=>member.groups.map((value:string)=>`<span class="member-pill member-pill-accent">${value}</span>`).join('');const render=()=>{const query=(search?.value||'').trim().toLowerCase();const filterActive=!!(query||group?.value||city?.value);const list=members.filter((member:any)=>(!query||`${member.name} ${member.username}`.toLowerCase().includes(query))&&(!group?.value||member.groups.includes(group.value))&&(!city?.value||member.city===city.value)).sort((a:any,b:any)=>a.name.localeCompare(b.name));if(total)total.textContent=String(list.length);if(count)count.textContent=`${list.length} anëtar${list.length===1?'':'ë'} u gjet${list.length===1?'':'ën'}`;grid.innerHTML=list.length?list.map((member:any)=>`<button class="member-card" type="button" data-username="${member.username}"><div class="member-card-top">${member.avatar?`<img class="member-avatar" src="${member.avatar}" alt="" loading="lazy">`:`<span class="member-avatar member-avatar-fallback">${initials(member.name)}</span>`}<div><p class="member-card-name">${member.name}</p><p class="member-card-role">@${member.username}</p></div></div><div class="member-card-meta">${member.city?`<span class="member-pill">${member.city}</span>`:''}${pills(member)}</div></button>`).join(''):'<p class="member-empty">Asnjë anëtar nuk përputhet me filtrat.</p>';const shown=applyRowLimit(grid,filterActive);if(hint)hint.textContent=shown>=0?`Po shfaqen ${shown} nga ${list.length} anëtarë — kërko ose zgjidh një filtër për t'i parë të gjithë.`:''};const close=()=>{drawer?.classList.remove('open');overlay?.classList.remove('open');drawer?.setAttribute('aria-hidden','true');document.body.style.overflow=''};grid.addEventListener('click',event=>{const username=(event.target as HTMLElement).closest<HTMLElement>('.member-card')?.dataset.username,member=members.find((item:any)=>item.username===username);if(!member||!drawer||!overlay||!content)return;content.innerHTML=`<button class="member-drawer-close" type="button" aria-label="Mbyll profilin">✕</button>${member.avatar?`<img class="member-drawer-avatar" src="${member.avatar}" alt="">`:`<span class="member-drawer-avatar member-avatar-fallback">${initials(member.name)}</span>`}<h2>${member.name}</h2><p class="member-drawer-role">@${member.username}</p><div class="member-tags">${member.city?`<span class="member-pill">${member.city}</span>`:''}${pills(member)}<span class="member-pill">Anëtar që nga ${member.since}</span></div><a class="partner-button" href="${member.profileUrl}" target="_blank" rel="noreferrer">Shiko profilin në forum <span>↗</span></a>`;drawer.classList.add('open');overlay.classList.add('open');drawer.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';content.querySelector('.member-drawer-close')?.addEventListener('click',close)});[search,group,city].forEach(control=>control?.addEventListener(control===search?'input':'change',render));overlay?.addEventListener('click',close);document.addEventListener('keydown',event=>{if(event.key==='Escape')close()});render()}
</script>
<style>
  .network-overview{overflow:hidden}.network-overview-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(480px,1.2fr);gap:clamp(45px,7vw,100px);align-items:center}.network-overview-copy h1{max-width:650px;margin:0;font-size:clamp(48px,6vw,76px);font-weight:300;line-height:1.02;letter-spacing:-.045em}.network-overview-copy>p:last-of-type{max-width:570px;color:#ffffffb8;font-size:19px;line-height:1.75}.network-jump{display:flex;gap:10px;margin-top:35px}.network-jump a{display:flex;gap:12px;padding:13px 17px;border:1px solid #ffffff40;border-radius:999px;font-size:14px;font-weight:700}.network-jump a:hover{color:var(--night);background:#fff}.network-jump span{color:#c9aebd}.network-section-heading{display:grid;grid-template-columns:1fr minmax(280px,440px);gap:50px;align-items:end;margin-bottom:52px}.network-section-heading h2{margin:0;font-size:clamp(38px,5vw,58px);font-weight:400;line-height:1.08}.network-section-heading>p{margin:0;color:var(--muted);font-size:18px;line-height:1.75}.city-directory-stats{display:flex;align-items:baseline;gap:12px;margin-bottom:24px;padding-block:20px;border-block:1px solid var(--line)}.city-directory-stats strong{font-family:var(--font-display);font-size:38px;font-weight:400}.city-directory-stats span{color:var(--muted);font-size:14px;text-transform:uppercase;letter-spacing:.08em}.city-filters{margin-bottom:0}.city-directory-grid{margin-top:32px}.city-directory-card{color:var(--ink);text-decoration:none}.city-directory-card .member-card-top{min-width:0}.city-directory-image{border-radius:10px}.city-directory-card .member-card-top>div{min-width:0}.city-directory-card .member-card-name,.city-directory-card .member-card-role{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.city-directory-arrow{margin-left:auto;color:var(--accent);font-size:18px}.city-card-facts{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:12px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}.activity-level{padding:4px 8px;border-radius:999px;color:var(--accent-dark);background:#eee1e8;font-weight:700}.activity-shumë-aktiv,.activity-aktiv{color:#315e44;background:#e0eee6}.activity-joaktiv{color:#626368;background:#ececef}#anetaret .member-stats{margin:0 0 40px;padding-block:24px;border-block:1px solid var(--line)}#anetaret .member-grid{margin-top:32px}@media(max-width:950px){.network-overview-grid,.network-section-heading{grid-template-columns:1fr}.network-overview-grid{gap:55px}}@media(max-width:560px){.network-jump{flex-direction:column}.network-jump a{justify-content:center}}
</style>
