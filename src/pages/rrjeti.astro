---
// /rrjeti/ used to hold every section as a tab (/rrjeti/#anetaret, …). Each is its own
// page now; send old links to the matching one, Qytetet by default.
---
<!doctype html>
<html lang="sq">
  <head>
    <meta charset="utf-8" />
    <title>Rrjeti · Illyrian Brains</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="/qytetet/" />
    <script is:inline>
      const rrjetiPages = { qytetet: '/qytetet/', anetaret: '/anetaret/', shoqatat: '/shoqatat/', bizneset: '/bizneset/', aktiviteti: '/rrjeti/postimet/', postimet: '/rrjeti/postimet/' };
      location.replace(rrjetiPages[location.hash.slice(1)] || '/qytetet/');
    </script>
    <meta http-equiv="refresh" content="0; url=/qytetet/" />
  </head>
  <body><a href="/qytetet/">Rrjeti</a></body>
</html>
