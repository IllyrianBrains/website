---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/directory.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import JoinCTA from '../../components/JoinCTA.astro';
import MemberNetworkGraph from '../../components/MemberNetworkGraph.astro';
import { cities, defaultCityImage } from '../../data/cities';
import { directoryMembers } from '../../data/members';

const memberByUsername = new Map(directoryMembers.map((member) => [member.username.toLowerCase(), member]));
// Forum posts used to mention organizers as "@username", linking to their forum
// profile — the forum integration is gone, so instead link mentions we can still
// resolve to the site's own member directory, pre-filtered to that person.
const mentionPattern = /(?<!\w)@([A-Za-z][\w.-]{0,32})/g;
const linkMemberMentions = (html: string) => html.replace(mentionPattern, (match, rawUsername: string) => {
  const trailingPunct = rawUsername.match(/[.,;:)]+$/)?.[0] || '';
  const username = trailingPunct ? rawUsername.slice(0, -trailingPunct.length) : rawUsername;
  const member = memberByUsername.get(username.toLowerCase());
  if (!member) return match;
  return `<a class="city-mention" href="/anetaret/?search=${encodeURIComponent(member.username)}">@${username}</a>${trailingPunct}`;
});

const htmlFiles = import.meta.glob('../../data/cities-content/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const contentBySlug: Record<string, string> = {};
for (const [path, content] of Object.entries(htmlFiles)) {
  const slug = path.split('/').pop()!.replace('.html', '');
  contentBySlug[slug] = content;
}

export function getStaticPaths() {
  return cities.map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
const cityMembers = directoryMembers.filter(member => member.city === city.city).sort((a,b) => a.name.localeCompare(b.name,'sq'));
const rawCommunityHtml = contentBySlug[city.slug] || '';
const getImageAttribute = (tag: string, name: string) => tag.match(new RegExp(`${name}=["']([^"']*)["']`, 'i'))?.[1] || '';
const cityPhotos = [...rawCommunityHtml.matchAll(/<img\b[^>]*>/gi)].map(match => ({ src: getImageAttribute(match[0], 'src'), alt: getImageAttribute(match[0], 'alt') })).filter(photo => photo.src);
const communityHtml = rawCommunityHtml
  .replace(/<img\b[^>]*>/gi, '')
  .replace(/<p>\s*(?:<br\s*\/?\s*>\s*)*<\/p>/gi, '')
  .replace(/<div>\s*<\/div>/gi, '');
const sectionPattern = /<h[23][^>]*>([\s\S]*?)<\/h[23]>/gi;
const matches = communityHtml ? [...communityHtml.matchAll(sectionPattern)] : [];
const cleanTitle = (html: string) => html.replace(/<[^>]+>/g, '').trim();
const communityIntro = communityHtml ? linkMemberMentions(communityHtml.slice(0, matches[0]?.index ?? communityHtml.length).trim()) : '';
const communitySections = matches.map((match, index) => ({
  title: cleanTitle(match[1]),
  html: linkMemberMentions(communityHtml.slice((match.index ?? 0) + match[0].length, matches[index + 1]?.index ?? communityHtml.length).trim()),
})).filter(section => section.title || section.html)
  // Forum posts hand-listed organizers under a "Kontakt" heading — the
  // "Pjesë e rrjetit" section below now lists them automatically from the
  // member directory, so this manual, forum-linked duplicate is dropped.
  .filter(section => !section.title.toLocaleLowerCase('sq').includes('kontakt'));
---
<BaseLayout title={`Illyrian Brains ${city.city}`} description={`Komuniteti shqiptar i profesionistëve në ${city.city}.`}>
  <Header />
  <main class="city-detail-page" id="city-page" data-city={city.city} data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}>
    <section class="section tone-dark city-detail-hero">
      <div class="container">
        <a class="city-back-link" href="/qytetet/"><span aria-hidden="true">←</span> Të gjithë qytetet</a>
        <div class="city-hero-layout">
          <div class="city-hero-copy">
            <p class="eyebrow">{city.country}</p>
            <h1>Illyrian Brains<br /><span>{city.city}</span></h1>
            <p>Komuniteti shqiptar i profesionistëve në {city.city}—një hapësirë për njohje, dije dhe bashkëpunim.</p>
            <div class="city-hero-actions">
              <button class="partner-button city-subscribe-button" type="button" id="city-subscribe" hidden>Ndiq qytetin</button>
              <span class="city-subscriber-count" id="city-subscriber-count" hidden></span>
              {city.instagramUrl
                ? <a class="partner-button" href={city.instagramUrl} target="_blank" rel="noreferrer">Kontakto në Instagram <span aria-hidden="true">↗</span></a>
                : <a class="partner-button" href="#komuniteti">Zbulo komunitetin <span aria-hidden="true">↓</span></a>}
              {city.instagramUrl && <a class="city-text-link" href="#komuniteti">Zbulo komunitetin ↓</a>}
              {city.lumaUrl && <a class="city-text-link" href={city.lumaUrl} target="_blank" rel="noreferrer">Shiko eventet në Luma ↗</a>}
            </div>
          </div>
          <figure class="city-hero-figure">
            <img src={encodeURI(city.image || defaultCityImage)} alt={city.image ? `Komuniteti Illyrian Brains në ${city.city}` : ""} loading="eager" />
            <figcaption><span>Komuniteti lokal</span><strong>{city.city}, {city.country}</strong></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section tone-white city-community" id="komuniteti">
      <div class="container city-content-layout">
        <aside class="city-content-index">
          <p class="eyebrow">Në këtë faqe</p>
          <a href="#rreth-komunitetit">Rreth komunitetit</a>
          {communitySections.map((section, index) => <a href={`#seksioni-${index + 1}`}>{section.title}</a>)}
          {cityMembers.length > 0 && <a href="#njerezit">Pjesë e rrjetit</a>}
          {cityMembers.length > 0 && <a href="#rrjeti">Si lidhet komuniteti</a>}
          {city.activities && city.activities.length > 0 && <a href="#aktivitetet">Aktivitetet</a>}
          {cityPhotos.length > 0 && <a href="#galeria">Galeria</a>}
        </aside>
        <div class="city-content-main">
          <section class="city-content-section city-overview" id="rreth-komunitetit">
            <p class="eyebrow">Rreth komunitetit</p>
            <h2>Një komunitet që të lidh me njerëzit e duhur.</h2>
            {communityIntro ? <div class="city-rich-text" set:html={communityIntro} /> : <p class="city-intro-fallback">Illyrian Brains {city.city} bashkon profesionistë, studentë, krijues dhe sipërmarrës shqiptarë që jetojnë në {city.city} dhe zonat përreth. Komuniteti krijon mundësi për njohje të reja, shkëmbim përvojash dhe bashkëpunim.</p>}
          </section>

          {communitySections.map((section, index) => (
            <section class="city-content-section" id={`seksioni-${index + 1}`}>
              <span class="city-section-number">{String(index + 1).padStart(2, '0')}</span>
              <h2>{section.title}</h2>
              <div class="city-rich-text" set:html={section.html} />
            </section>
          ))}

          {cityMembers.length > 0 && (
            <section class="city-content-section" id="njerezit">
              <span class="city-section-number">{String(communitySections.length + 1).padStart(2, '0')}</span>
              <h2>Pjesë e rrjetit.</h2>
              <div class="member-grid city-people-grid" id="city-people-grid" data-members={JSON.stringify(cityMembers)}>
                {cityMembers.map(member => (
                  <button class:list={['member-card', 'city-people-card', (member.membershipType === 'Organizator' || member.groups?.includes('Qytetet')) && 'is-organizer']} type="button" data-username={member.username}>
                    <div class="member-card-top">
                      {member.avatar ? <img class="member-avatar" src={member.avatar} alt="" loading="lazy" /> : <span class="member-avatar member-avatar-fallback">{member.name.split(' ').map(part => part[0]).join('').slice(0,2).toUpperCase()}</span>}
                      <div><p class="member-card-name">{member.name}</p><p class="member-card-role">{member.title || member.fieldsOfExpertise?.join(' · ') || `@${member.username}`}</p></div>
                    </div>
                    {(member.membershipType === 'Organizator' || member.groups?.includes('Qytetet')) && <div class="member-card-meta"><span class="member-pill member-pill-gold">Organizator/e</span></div>}
                    <span class="member-card-action">Shiko profilin <span aria-hidden="true">→</span></span>
                  </button>
                ))}
              </div>
            </section>
          )}

          {city.activities && city.activities.length > 0 && <section class="city-content-section" id="aktivitetet"><span class="city-section-number">{String(communitySections.length + (cityMembers.length > 0 ? 2 : 1)).padStart(2, '0')}</span><h2>Komunitetet dhe aktivitetet</h2><ul class="city-activities">{city.activities.map((activity) => <li>{activity}</li>)}</ul></section>}

          {cityPhotos.length > 0 && (
            <section class="city-content-section city-gallery-section" id="galeria">
              <span class="city-section-number">Galeria</span>
              <h2>Momente nga komuniteti.</h2>
              <div class="city-photo-grid">
                {cityPhotos.map((photo) => <figure><img src={encodeURI(photo.src)} alt={photo.alt || `Aktivitet i komunitetit Illyrian Brains ${city.city}`} loading="lazy" /></figure>)}
              </div>
            </section>
          )}
        </div>
      </div>
    </section>

    {cityMembers.length > 0 && <section class="section tone-grey city-network" id="rrjeti"><div class="container"><MemberNetworkGraph members={cityMembers} /></div></section>}

    <JoinCTA />
  </main>
  <Footer />
  {cityMembers.length > 0 && (
    <>
      <div class="member-drawer-overlay" id="city-member-overlay"></div>
      <aside class="member-drawer" id="city-member-drawer" aria-hidden="true"><div class="member-drawer-inner" id="city-member-drawer-content"></div></aside>
    </>
  )}
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { memberSession } from '../../scripts/member-session';
  import { memberUrl } from '../../scripts/members';

  const cityPage = document.querySelector<HTMLElement>('#city-page');
  const subscribeButton = document.querySelector<HTMLButtonElement>('#city-subscribe');
  const subscriberCount = document.querySelector<HTMLElement>('#city-subscriber-count');
  if (cityPage && subscribeButton && subscriberCount && cityPage.dataset.supabaseUrl && cityPage.dataset.supabaseKey) {
    const supabase = createClient(cityPage.dataset.supabaseUrl, cityPage.dataset.supabaseKey);
    const city = cityPage.dataset.city!;
    let subscribed = false;
    let count = 0;
    const paintSubscription = () => {
      subscribeButton.textContent = subscribed ? 'Po e ndjek ✓' : 'Ndiq qytetin';
      subscribeButton.classList.toggle('is-subscribed', subscribed);
      subscriberCount.textContent = `${count} ndjekës`;
      subscriberCount.hidden = false;
    };
    Promise.all([memberSession(supabase), supabase.rpc('subscription_stats', { p_kind: 'city', p_value: city })]).then(([{ session }, { data, error }]) => {
      if (error) return;
      subscribed = Boolean(data?.is_subscribed);
      count = Number(data?.subscribers || 0);
      subscribeButton.hidden = false;
      paintSubscription();
      subscribeButton.addEventListener('click', async () => {
        if (!session) { window.location.href = `/anetaresohu/profili/?next=${encodeURIComponent(window.location.pathname)}`; return; }
        subscribeButton.disabled = true;
        const next = !subscribed;
        const { error } = await supabase.rpc('set_subscription', { p_kind: 'city', p_value: city, p_on: next });
        subscribeButton.disabled = false;
        if (error) return alert(`Nuk u krye: ${error.message}`);
        subscribed = next;
        count = Math.max(0, count + (next ? 1 : -1));
        paintSubscription();
      });
    });
  }

  const grid = document.querySelector<HTMLElement>('#city-people-grid');
  const overlay = document.querySelector<HTMLElement>('#city-member-overlay');
  const drawer = document.querySelector<HTMLElement>('#city-member-drawer');
  const content = document.querySelector<HTMLElement>('#city-member-drawer-content');
  if (grid && overlay && drawer && content) {
    const members = JSON.parse(grid.dataset.members || '[]');
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character] || character));
    const initials = (name: string) => name.split(' ').map((part: string) => part[0]).join('').slice(0,2).toUpperCase();
    const fields = (member: any) => member.fieldsOfExpertise || [];
    const close = () => { drawer.classList.remove('open'); overlay.classList.remove('open'); drawer.setAttribute('aria-hidden','true'); document.body.style.overflow = ''; };
    grid.addEventListener('click', event => {
      const username = (event.target as HTMLElement).closest<HTMLElement>('.city-people-card')?.dataset.username;
      const member = members.find((item: any) => item.username === username);
      if (!member) return;
      content.innerHTML = `<button class="member-drawer-close" type="button" aria-label="Mbyll profilin">✕</button><div class="profile-cover"></div><div class="profile-head">${member.avatar ? `<img class="member-drawer-avatar" src="${escapeHtml(member.avatar)}" alt="">` : `<span class="member-drawer-avatar member-avatar-fallback">${escapeHtml(initials(member.name))}</span>`}<h2>${escapeHtml(member.name)}</h2><p class="member-drawer-role">${escapeHtml(member.title || fields(member).join(" · ") || "Ekspertiza TBD")}</p><p class="profile-meta">${[member.company, member.city, member.country].filter(Boolean).map(escapeHtml).join(" · ")}</p><p class="profile-meta">${member.membershipType ? `<span class="member-pill member-pill-gold">${escapeHtml(member.membershipType)}</span> ` : ""}Anëtar që nga ${escapeHtml(String(member.since))}</p><div class="member-drawer-actions"><a class="partner-button" href="${memberUrl(member.username)}">Profili i plotë <span>→</span></a>${member.linkedinUrl ? `<a class="partner-button" href="${encodeURI(member.linkedinUrl)}" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a>` : ""}${member.website ? `<a class="partner-button" href="${encodeURI(member.website)}" target="_blank" rel="noreferrer">Faqja personale <span>↗</span></a>` : ""}</div></div>${member.bio ? `<section class="profile-section"><h3>Rreth</h3><p class="member-drawer-bio">${escapeHtml(member.bio)}</p></section>` : ""}${fields(member).length || (member.specialty || []).length ? `<section class="profile-section"><h3>Ekspertiza dhe aftësitë</h3><div class="member-tags">${fields(member).map((value: string) => `<span class="member-pill member-pill-accent">${escapeHtml(value)}</span>`).join("")}${(member.specialty || []).map((value: string) => `<span class="member-pill member-pill-specialty">${escapeHtml(value)}</span>`).join("")}</div></section>` : ""}${(member.languages || []).length ? `<section class="profile-section"><h3>Gjuhët</h3><div class="member-tags">${member.languages.map((value: string) => `<span class="member-pill member-pill-location">${escapeHtml(value)}</span>`).join("")}</div></section>` : ""}`;
      drawer.classList.add('open'); overlay.classList.add('open'); drawer.setAttribute('aria-hidden','false'); document.body.style.overflow = 'hidden';
      content.querySelector('.member-drawer-close')?.addEventListener('click', close);
    });
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', event => { if (event.key === 'Escape') close(); });
  }
</script>

<style>
  .city-detail-hero { overflow: hidden; padding-top: 54px; }
  .city-back-link { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 42px; color: rgba(255,255,255,.68); font-size: 14px; font-weight: 600; }
  .city-back-link:hover { color: #fff; }
  .city-hero-layout { display: grid; grid-template-columns: minmax(0,.82fr) minmax(440px,1.18fr); gap: clamp(50px,8vw,110px); align-items: center; }
  .city-hero-copy h1 { margin: 0; font-size: clamp(48px,6vw,78px); font-weight: 300; line-height: .98; letter-spacing: -.045em; }
  .city-hero-copy h1 span { color: #d6b7c8; }
  .city-hero-copy > p:not(.eyebrow) { max-width: 580px; margin: 28px 0 0; color: rgba(255,255,255,.76); font-size: 19px; line-height: 1.75; }
  .city-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 34px; }
  .city-hero-actions .partner-button { margin: 0; }
  .city-subscribe-button.is-subscribed { border-color: rgba(255,255,255,.45); background: transparent; }
  .city-subscribe-button:disabled { opacity: .6; cursor: wait; }
  .city-subscriber-count { margin-left: -14px; color: rgba(255,255,255,.62); font-size: 12px; }
  .city-text-link { color: #e5d5de; font-size: 14px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .city-hero-figure { position: relative; height: clamp(360px,42vw,540px); margin: 0; padding: 10px; border: 1px solid rgba(255,255,255,.14); border-radius: 18px; background: rgba(255,255,255,.04); box-shadow: 0 28px 65px rgba(0,0,0,.28); }
  .city-hero-figure::after { content: ''; position: absolute; inset: 10px; border: 1px solid rgba(255,255,255,.18); border-radius: 11px; box-shadow: inset 0 -110px 80px rgba(14,14,18,.55); pointer-events: none; }
  .city-hero-figure img { width: 100%; height: 100%; border-radius: 11px; object-fit: cover; }
  .city-hero-figure figcaption { position: absolute; z-index: 1; right: 32px; bottom: 29px; left: 32px; display: flex; align-items: end; justify-content: space-between; gap: 20px; color: #fff; }
  .city-hero-figure figcaption span { color: #d6b7c8; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }
  .city-hero-figure figcaption strong { font-size: 16px; text-align: right; }
  .city-content-layout { display: grid; grid-template-columns: 230px minmax(0,760px); gap: clamp(45px,8vw,110px); align-items: start; }
  .city-content-index { position: sticky; top: 118px; display: flex; flex-direction: column; padding: 22px 0; border-block: 1px solid var(--line); }
  .city-content-index .eyebrow { margin-bottom: 12px; }
  .city-content-index a { padding: 9px 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
  .city-content-index a:hover { color: var(--accent); }
  .city-content-main { min-width: 0; }
  .city-content-section { position: relative; padding: 54px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 110px; }
  .city-content-section:first-child { padding-top: 0; }
  .city-content-section h2 { max-width: 680px; margin: 0 0 25px; font-size: clamp(30px,4vw,42px); font-weight: 400; line-height: 1.18; letter-spacing: -.025em; }
  .city-section-number { display: block; margin-bottom: 14px; color: var(--accent); font-size: 13px; font-weight: 800; letter-spacing: .1em; }
  .city-intro-fallback, .city-rich-text :global(p), .city-rich-text :global(ul), .city-rich-text :global(ol), .city-rich-text :global(blockquote) { max-width: 68ch; color: #4f5057; font-size: 18px; line-height: 1.85; }
  .city-rich-text :global(p) { margin: 0 0 20px; }
  .city-rich-text :global(ul), .city-rich-text :global(ol) { margin: 18px 0 24px; padding-left: 25px; }
  .city-rich-text :global(li) { margin-bottom: 11px; padding-left: 5px; }
  .city-rich-text :global(li::marker) { color: var(--accent); }
  .city-rich-text :global(ul ul) { margin: 10px 0; }
  .city-rich-text :global(a) { color: var(--accent-dark); font-weight: 650; text-decoration: underline; text-underline-offset: 4px; }
  .city-rich-text :global(blockquote) { margin: 0 0 30px; padding: 20px 24px; border-left: 3px solid var(--accent); background: #f4eef1; }
  .city-rich-text :global(blockquote p) { margin: 0; color: var(--ink); }
  .city-rich-text :global(img) { width: 100%; margin: 28px 0; border-radius: 12px; }
  .city-photo-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; margin-top: 32px; }
  .city-photo-grid figure { position: relative; min-width: 0; margin: 0; overflow: hidden; border-radius: 12px; background: var(--soft); }
  .city-photo-grid img { width: 100%; height: 270px; object-fit: cover; transition: transform .35s ease; }
  .city-photo-grid figure:hover img { transform: scale(1.025); }
  .city-network { scroll-margin-top: 90px; }
  .city-people-card.is-organizer { border: 1px solid rgba(180,138,45,.3); background: #fffdf8; }
  .city-people-card.is-organizer:hover { border-color: rgba(180,138,45,.55); }
  @media (max-width: 900px) { .city-hero-layout { grid-template-columns: 1fr; } .city-hero-figure { height: min(68vw,480px); } .city-content-layout { grid-template-columns: 1fr; } .city-content-index { position: static; display: grid; grid-template-columns: repeat(2,1fr); gap: 0 18px; } .city-content-index .eyebrow { grid-column: 1/-1; } }
  @media (max-width: 560px) { .city-detail-hero { padding-top: 38px; } .city-back-link { margin-bottom: 32px; } .city-hero-figure { height: 320px; } .city-hero-figure figcaption { align-items: start; flex-direction: column; gap: 5px; } .city-hero-figure figcaption strong { text-align: left; } .city-content-index { grid-template-columns: 1fr; } .city-content-section { padding-block: 42px; } .city-intro-fallback, .city-rich-text :global(p), .city-rich-text :global(ul), .city-rich-text :global(ol), .city-rich-text :global(blockquote) { font-size: 17px; } .city-photo-grid { grid-template-columns: 1fr; } .city-photo-grid img { height: 250px; } }
</style>
