---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NetworkDirectoryHero from '../../components/NetworkDirectoryHero.astro';
import { cities, defaultCityImage } from '../../data/cities';
import { cityRegions } from '../../data/regions';
const bySlug = (slug:string) => cities.find(city => city.slug === slug);

// Reuse the forum-sourced city content (same source as the per-city pages) to
// derive a short card description, instead of hand-writing 50+ blurbs.
const htmlFiles = import.meta.glob('../../data/cities-content/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const contentBySlug: Record<string, string> = {};
for (const [path, content] of Object.entries(htmlFiles)) {
  const slug = path.split('/').pop()!.replace('.html', '');
  contentBySlug[slug] = content;
}
const stripTags = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const describeCity = (slug: string, city: string, country: string) => {
  const firstParagraph = contentBySlug[slug]?.match(/<p>([\s\S]*?)<\/p>/i)?.[1];
  const text = firstParagraph ? stripTags(firstParagraph) : `Komuniteti i Illyrian Brains në ${city}, ${country}.`;
  return text.length > 110 ? `${text.slice(0, 110).replace(/\s+\S*$/, '')}…` : text;
};

const directoryCities = cityRegions.flatMap(region => region.citySlugs.map(bySlug).filter(Boolean).map(city => ({ ...city!, region: region.name, color: region.color, description: describeCity(city!.slug, city!.city, city!.country) }))).sort((a,b) => a.city.localeCompare(b.city,'sq'));
const countries = [...new Set(cities.map(city => city.country))].sort((a,b) => a.localeCompare(b,'sq'));
---
<BaseLayout title="Qytetet · Illyrian Brains" description="Zbulo komunitetet lokale të rrjetit Illyrian Brains, qytet pas qyteti.">
  <Header />
  <main class="network-page">
    <NetworkDirectoryHero kind="cities" title="Qytetet e rrjetit." description="Qytetet janë pika e nisjes së rrjetit: aty lindin njohjet, aktivitetet dhe bashkëpunimet lokale. Zgjidh një qytet për t'u njohur me komunitetin pranë teje." showVisual={false} />

    <section class="section tone-white" id="qytetet"><div class="container">
      <div class="map-legend" id="city-map-legend">
        {cityRegions.map(region => <button type="button" class="map-legend-item" data-region={region.name}><span class="map-legend-dot" style={`background:${region.color}`} aria-hidden="true"></span>{region.name}</button>)}
      </div>
      <div class="community-map-layout">
        <div id="community-map" data-cities={JSON.stringify(directoryCities)} aria-label="Harta e qyteteve, ngjyrosur sipas rajonit"></div>
      </div>
    </div></section>

    <section class="section tone-grey"><div class="container">
      <div class="city-directory-stats"><strong id="city-stat-total">{directoryCities.length}</strong><span>qytete në rrjet</span></div>
      <div class="member-filters city-filters">
        <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="city-search" type="search" placeholder="Kërko qytet ose shtet…" aria-label="Kërko qytete"/></div>
        <select id="city-region-filter" aria-label="Filtro sipas rajonit"><option value="">Të gjitha rajonet</option>{cityRegions.map(region=><option value={region.name}>{region.name}</option>)}</select>
        <select id="city-country-filter" aria-label="Filtro sipas shtetit"><option value="">Të gjitha shtetet</option>{countries.map(country=><option value={country}>{country}</option>)}</select>
        <details class="city-status-filter" id="city-status-filter">
          <summary aria-label="Filtro sipas statusit"><span id="city-status-filter-label">Statusi: Aktive</span></summary>
          <fieldset>
            <legend>Statusi i qytetit</legend>
            <label><input type="checkbox" value="active" checked/><span>Aktive</span></label>
            <label><input type="checkbox" value="paused"/><span>Në pauzë</span></label>
            <label><input type="checkbox" value="inactive"/><span>Jo aktive</span></label>
          </fieldset>
        </details>
      </div>
      <p class="result-count" id="city-result-count"></p>
      <div class="member-grid city-directory-grid" id="city-directory-grid" data-cities={JSON.stringify(directoryCities)} data-fallback={defaultCityImage}>
        {directoryCities.map(city => <article class="member-card city-directory-card"><a class="city-directory-media" href={`/qytetet/${city.slug}/`} aria-label={`Shiko komunitetin në ${city.city}`}><img class="city-directory-image" src={encodeURI(city.image || defaultCityImage)} alt="" loading="lazy"/></a><div class="city-directory-body"><div class="city-directory-heading"><a class="member-card-name" href={`/qytetet/${city.slug}/`}>{city.city}</a><p class="member-card-role">{city.country}</p></div><p class="city-directory-description">{city.description}</p><div class="city-directory-footer"><span class={`city-status-pill city-status-${city.status}`}><span class="city-status-dot" aria-hidden="true"></span>{city.status === 'active' ? 'Aktive' : city.status === 'paused' ? 'Në pauzë' : 'Jo aktive'}</span>{city.instagramUrl && <a class="city-social-link" href={city.instagramUrl} target="_blank" rel="noreferrer" aria-label={`Kontakto Illyrian Brains ${city.city} në Instagram`}>Instagram <span aria-hidden="true">↗</span></a>}</div></div></article>)}
      </div>
    </div></section>
  </main>
  <Footer />
</BaseLayout>
<script>
  const cityGrid=document.querySelector<HTMLElement>('#city-directory-grid'),citySearch=document.querySelector<HTMLInputElement>('#city-search'),cityRegion=document.querySelector<HTMLSelectElement>('#city-region-filter'),cityCountry=document.querySelector<HTMLSelectElement>('#city-country-filter'),cityStatus=document.querySelector<HTMLDetailsElement>('#city-status-filter'),cityStatusSummary=document.querySelector<HTMLElement>('#city-status-filter-label'),cityStatusInputs=Array.from(cityStatus?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')||[]),cityCount=document.querySelector<HTMLElement>('#city-result-count'),cityTotal=document.querySelector<HTMLElement>('#city-stat-total');
  const escapeCityHtml=(value:string)=>value.replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]||character));
  const cityStatusLabel=(status:string)=>status==='active'?'Aktive':status==='paused'?'Në pauzë':'Jo aktive';
  if(cityGrid){const cities=JSON.parse(cityGrid.dataset.cities||'[]'),fallback=cityGrid.dataset.fallback||'';const renderCities=()=>{const query=(citySearch?.value||'').trim().toLocaleLowerCase('sq');const statuses=cityStatusInputs.filter(input=>input.checked).map(input=>input.value);if(cityStatusSummary){const labels=cityStatusInputs.filter(input=>input.checked).map(input=>input.nextElementSibling?.textContent||'');cityStatusSummary.textContent=labels.length?`Statusi: ${labels.join(', ')}`:'Statusi: Asnjë';}const list=cities.filter((item:any)=>(!query||`${item.city} ${item.country}`.toLocaleLowerCase('sq').includes(query))&&(!cityRegion?.value||item.region===cityRegion.value)&&(!cityCountry?.value||item.country===cityCountry.value)&&statuses.includes(item.status)).sort((a:any,b:any)=>`${a.city} ${a.country}`.localeCompare(`${b.city} ${b.country}`,'sq'));if(cityTotal)cityTotal.textContent=String(list.length);if(cityCount)cityCount.textContent=`${list.length} qytet${list.length===1?'':'e'} u gjet${list.length===1?'':'ën'}`;cityGrid.innerHTML=list.length?list.map((item:any)=>`<article class="member-card city-directory-card"><a class="city-directory-media" href="/qytetet/${item.slug}/" aria-label="Shiko komunitetin në ${escapeCityHtml(item.city)}"><img class="city-directory-image" src="${encodeURI(item.image||fallback)}" alt="" loading="lazy"></a><div class="city-directory-body"><div class="city-directory-heading"><a class="member-card-name" href="/qytetet/${item.slug}/">${escapeCityHtml(item.city)}</a><p class="member-card-role">${escapeCityHtml(item.country)}</p></div><p class="city-directory-description">${escapeCityHtml(item.description||'')}</p><div class="city-directory-footer"><span class="city-status-pill city-status-${item.status}"><span class="city-status-dot" aria-hidden="true"></span>${cityStatusLabel(item.status)}</span>${item.instagramUrl?`<a class="city-social-link" href="${escapeCityHtml(encodeURI(item.instagramUrl))}" target="_blank" rel="noreferrer" aria-label="Kontakto Illyrian Brains ${escapeCityHtml(item.city)} në Instagram">Instagram <span aria-hidden="true">↗</span></a>`:''}</div></div></article>`).join(''):'<p class="member-empty">Asnjë qytet nuk përputhet me filtrat. Provo një kërkim tjetër.</p>'};[citySearch,cityRegion,cityCountry,...cityStatusInputs].forEach(control=>control?.addEventListener(control===citySearch?'input':'change',renderCities));renderCities()}

  // Region legend doubles as a shortcut into the existing region <select> filter —
  // clicking a chip sets/clears it and reuses the filtering already wired above.
  const cityLegend=document.querySelector<HTMLElement>('#city-map-legend');
  const legendButtons=cityLegend?Array.from(cityLegend.querySelectorAll<HTMLButtonElement>('.map-legend-item')):[];
  const syncLegend=()=>{legendButtons.forEach(btn=>btn.classList.toggle('is-active',!!cityRegion&&btn.dataset.region===cityRegion.value))};
  legendButtons.forEach(btn=>btn.addEventListener('click',()=>{if(!cityRegion)return;cityRegion.value=cityRegion.value===btn.dataset.region?'':(btn.dataset.region||'');cityRegion.dispatchEvent(new Event('change'));syncLegend()}));
  cityRegion?.addEventListener('change',syncLegend);
</script>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  const cityMapElement = document.querySelector('#community-map');
  if (cityMapElement && window.L) {
    const cityMapData = JSON.parse(cityMapElement.dataset.cities || '[]');
    const cityMap = L.map(cityMapElement, { scrollWheelZoom: true, doubleClickZoom: true, touchZoom: true, zoomControl: true }).setView([44, 8], 3);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(cityMap);

    const cityMarkers = cityMapData.map((city) => {
      const isInactive = city.status === 'inactive';
      const marker = L.circleMarker([city.lat, city.lng], {
        radius: 10, color: '#fff', weight: 2, opacity: .9,
        fillColor: isInactive ? '#9a9ba3' : city.color, fillOpacity: isInactive ? .5 : .85
      })
        .bindTooltip(`<div class="map-city-tooltip"><strong>${city.city}</strong><span>${city.country}${isInactive ? ' · jo aktive' : ''}</span></div>`, { direction: 'top', offset: [0, -10], opacity: .96 })
        .bindPopup(`<div class="map-popup"><strong>${city.city}</strong><span>${city.country}</span><small>${city.region}${isInactive ? ' · Jo aktive' : ''}</small><a class="map-popup-link" href="/qytetet/${city.slug}/">Shiko qytetin ↗</a></div>`);
      marker.addTo(cityMap);
      return { city, marker };
    });
    // Fit to the European cluster specifically rather than every marker — most
    // cities are in Europe, and including the North American / Middle East
    // outliers in the bounds zooms the map out so far that the view is mostly
    // open ocean. Those markers still render and are reachable by panning.
    const isEurope = (city) => city.lat >= 34 && city.lat <= 71 && city.lng >= -25 && city.lng <= 45;
    const europeMarkers = cityMarkers.filter(({ city }) => isEurope(city)).map(({ marker }) => marker);
    const fitMarkers = europeMarkers.length ? europeMarkers : cityMarkers.map(({ marker }) => marker);
    if (fitMarkers.length) cityMap.fitBounds(L.featureGroup(fitMarkers).getBounds(), { padding: [34, 34] });
  }
</script>
<style is:global>
  .city-collaboration-card{border:1px solid rgba(255,255,255,.1)!important;background:linear-gradient(145deg,var(--city-card-start),var(--city-card-end))!important}.city-card-plum{--city-card-start:#80566f;--city-card-end:#5a394d}.city-card-blue{--city-card-start:#486f7e;--city-card-end:#294b5a}.city-card-ochre{--city-card-start:#b06f58;--city-card-end:#854938}.city-collaboration-card::after{border-color:rgba(255,255,255,.2)!important;box-shadow:0 0 70px rgba(255,255,255,.06)!important}
  .city-collaboration{padding:96px 0 104px;border-bottom:1px solid var(--line);background:#f7f6f4}.city-collaboration-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,430px);column-gap:70px;align-items:end;margin-bottom:44px}.city-collaboration-heading .eyebrow{grid-column:1/-1;margin-bottom:15px}.city-collaboration-heading h2{max-width:650px;margin:0;font-size:clamp(42px,5.3vw,66px);font-weight:400;line-height:.98;letter-spacing:-.045em}.city-collaboration-heading>p:last-child{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.city-collaboration-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.city-collaboration-card{--city-collaboration-color:#744761;position:relative;display:flex;min-height:330px;flex-direction:column;justify-content:space-between;overflow:hidden;padding:27px 29px 30px;border-radius:12px;color:#fff;background:var(--city-collaboration-color);box-shadow:0 14px 35px rgba(23,24,29,.12);transition:transform .22s ease,box-shadow .22s ease}.city-collaboration-card::after{content:'';position:absolute;right:-52px;top:-62px;width:180px;height:180px;border:1px solid rgba(255,255,255,.16);border-radius:50%}.city-collaboration-card:hover{transform:translateY(-5px);box-shadow:0 20px 42px rgba(23,24,29,.18)}.city-card-plum{--city-collaboration-color:#744761}.city-card-blue{--city-collaboration-color:#365d70}.city-card-ochre{--city-collaboration-color:#a56f32}.city-card-number{position:relative;z-index:1;display:grid;width:36px;height:36px;place-items:center;border:1px solid rgba(255,255,255,.45);border-radius:50%;font-size:10px;font-weight:800;letter-spacing:.08em}.city-collaboration-card>div{position:relative;z-index:1}.city-collaboration-card h3{max-width:280px;margin:0 0 13px;font-size:clamp(25px,2.2vw,31px);font-weight:400;line-height:1.05;letter-spacing:-.025em}.city-collaboration-card p{max-width:310px;margin:0;color:rgba(255,255,255,.78);font-size:14px;line-height:1.65}@media(max-width:900px){.city-collaboration-heading{grid-template-columns:1fr;gap:20px}.city-collaboration-grid{grid-template-columns:1fr}.city-collaboration-card{min-height:250px}}@media(max-width:600px){.city-collaboration{padding:72px 0 78px}.city-collaboration-heading{margin-bottom:30px}.city-collaboration-heading h2{font-size:clamp(38px,11vw,48px)}.city-collaboration-heading>p:last-child{font-size:15px}.city-collaboration-card{min-height:235px;padding:24px}.city-collaboration-card h3{font-size:27px}}
  .city-hero .about-body{max-width:640px;margin-top:18px;color:#ffffffb8;font-size:19px;line-height:1.75}#qytetet .map-legend{margin-top:0}.city-directory-stats{display:flex;align-items:baseline;gap:12px;margin-top:28px;margin-bottom:24px;padding-block:20px;border-block:1px solid var(--line)}.city-directory-stats strong{font-family:var(--font-display);font-size:38px;font-weight:400}.city-directory-stats span{color:var(--muted);font-size:14px;text-transform:uppercase;letter-spacing:.08em}.city-filters{margin-bottom:0}
  .city-directory-grid{grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;margin-top:32px;margin-bottom:12px}
  .city-directory-card{gap:0;padding:0;border:1px solid rgba(23,24,29,.08);border-radius:12px;color:var(--ink);text-decoration:none;background:#fff;box-shadow:0 6px 16px rgba(23,24,29,.05);cursor:default;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
  .city-directory-card:hover{transform:translateY(-3px);border-color:rgba(116,71,97,.28);box-shadow:0 14px 28px rgba(23,24,29,.1)}
  .city-directory-media{position:relative;overflow:hidden;aspect-ratio:16/10;border-radius:12px 12px 0 0;background:var(--soft)}
  .city-directory-image{display:block;width:100%;height:100%;margin:0;border-radius:0;object-fit:cover;transition:transform .4s ease}
  .city-directory-card:hover .city-directory-image{transform:scale(1.04)}
  .city-directory-body{display:flex;flex:1;flex-direction:column;gap:8px;padding:16px 18px 18px}
  .city-directory-heading{min-width:0}
  .city-directory-card .member-card-name,.city-directory-card .member-card-role{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .city-directory-card .member-card-name{margin:0;font-size:16px;font-weight:700}
  .city-directory-card .member-card-name:hover{color:var(--accent)}
  .city-directory-card .member-card-role{margin:2px 0 0}
  .city-directory-description{margin:0;min-height:calc(1.55em * 2);color:var(--muted);font-size:13px;line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .city-status-pill{display:inline-flex;align-items:center;align-self:flex-start;gap:6px;margin-top:2px;padding:4px 10px 4px 8px;border-radius:99px;font-size:11px;font-weight:700}
  .city-status-dot{width:7px;height:7px;border-radius:50%}
  .city-status-pill.city-status-active{background:rgba(47,140,90,.12);color:#237049}
  .city-status-pill.city-status-active .city-status-dot{background:#2f9e63}
  .city-status-pill.city-status-paused{background:rgba(190,130,40,.14);color:#8a5a17}
  .city-status-pill.city-status-paused .city-status-dot{background:#c9861f}
  .city-status-pill.city-status-inactive{background:rgba(110,111,120,.13);color:#63646c}
  .city-status-pill.city-status-inactive .city-status-dot{background:#8a8b93}
  .city-directory-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;padding-top:4px}
  .city-social-link{color:var(--accent-dark);font-size:12px;font-weight:750;text-decoration:underline;text-underline-offset:4px}
  .city-social-link:hover{color:var(--accent)}
  .city-status-filter{position:relative;min-width:170px}
  .city-status-filter summary{display:flex;min-height:43px;align-items:center;justify-content:space-between;gap:10px;padding:10px 16px;border:1px solid var(--line);border-radius:999px;color:var(--ink);background:#fff;font-size:13px;cursor:pointer;list-style:none}
  .city-status-filter summary::-webkit-details-marker{display:none}
  .city-status-filter summary::after{content:'▾';color:var(--muted);font-size:11px}
  .city-status-filter[open] summary{outline:2px solid var(--accent);outline-offset:1px}
  .city-status-filter fieldset{position:absolute;z-index:20;top:calc(100% + 7px);left:0;display:grid;min-width:190px;gap:4px;margin:0;padding:8px;border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:0 14px 35px rgba(23,24,29,.14)}
  .city-status-filter legend{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .city-status-filter label{display:flex;align-items:center;gap:9px;padding:8px 9px;border-radius:7px;font-size:13px;cursor:pointer}
  .city-status-filter label:hover{background:var(--soft)}
  .city-status-filter input{width:16px;height:16px;margin:0;accent-color:var(--accent)}
  @media(max-width:560px){.city-directory-grid{grid-template-columns:1fr}}
</style>
