import SpeedSortGame from '../../components/playground/SpeedSortGame.astro';
import QuizzesPanel from '../../components/playground/QuizzesPanel.astro';
import InvestGame from '../../components/playground/InvestGame.astro';
import IcebreakerGame from '../../components/playground/IcebreakerGame.astro';
import PitchBuilder from '../../components/playground/PitchBuilder.astro';

