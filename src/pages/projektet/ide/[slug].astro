---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ideas from '../../../data/ideas.json';
import { directoryMembers as members } from '../../../data/members';
import { formatDate, ideaContentType, ideaMailto, ideaReadingMinutes, ideaSummary, ideaTypeLabels, renderMarkdown, type Idea } from '../../../scripts/ideas';
import { memberUrl } from '../../../scripts/members';

export function getStaticPaths() {
  return (ideas as Idea[]).map((idea, index) => ({ params: { slug: idea.slug }, props: { idea, number: idea.id ?? ideas.length - index } }));
}
const { idea, number } = Astro.props as { idea: Idea; number: number };
const descriptionHtml = renderMarkdown(idea.description);
const mailto = ideaMailto(idea, number);
const publishedDate = formatDate(idea.date);
const contentType = ideaContentType(idea);
const contentTypeLabel = ideaTypeLabels[contentType];
const readingMinutes = ideaReadingMinutes(idea);
const usesStatus = ['opportunity', 'event', 'request'].includes(contentType);
const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('sq').replace(/[^a-z0-9]/g, '');
const authorName = idea.name || 'Anëtar i rrjetit';
const author = idea.author_username ? members.find(member => member.username === idea.author_username) : members.find(member => normalize(member.name) === normalize(authorName) || normalize(member.username) === normalize(authorName));
const authorUrl = author ? memberUrl(author.username) : `/anetaret/?search=${encodeURIComponent(authorName)}`;
---
<BaseLayout title={`${idea.title} · Postimet · Illyrian Brains`} description={ideaSummary(idea)}>
  <Header />
  <main class="notification-detail-page">
    <section class="section notification-detail-shell">
      <div class="container city-page">
        <nav class="notification-breadcrumb" aria-label="Breadcrumb"><a href="/rrjeti/postimet/">Postimet</a><span aria-hidden="true">›</span><a href={`/rrjeti/postimet/?type=${contentType}`}>{contentTypeLabel}</a></nav>
        <article class="notification-detail-card">
          <header class="notification-detail-head">
            <div class="idea-detail-badges">
              <span class="idea-detail-type">{contentTypeLabel}</span>
              {idea.location && <span class="idea-detail-location">{idea.location}</span>}
              {(idea.tags || []).map(tag => <span class="idea-detail-tag">{tag}</span>)}
              {usesStatus && <span class:list={['idea-status', idea.resolved ? 'is-resolved' : 'is-open']}>{idea.resolved ? 'Përfunduar' : 'Aktive'}</span>}
            </div>
            <h1>{idea.title}</h1>
            <p class="notification-detail-summary">{ideaSummary(idea)}</p>
            <div class="notification-detail-byline">
              <a href={authorUrl} class="notification-detail-author"><span aria-hidden="true">●</span><strong>{authorName}</strong><small>Shiko profilin në rrjet</small></a>
              <div class="notification-detail-reading">{publishedDate && <time>{publishedDate}</time>}<span>{readingMinutes} min lexim</span></div>
            </div>
          </header>
          <div class="notification-detail-body">
            <div class="idea-detail-rich" set:html={descriptionHtml} />
            <div class="idea-detail-actions"><a class="partner-button" href={mailto}>Përgjigju me email <span aria-hidden="true">↗</span></a></div>
          </div>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .notification-detail-page{background:#fff}.notification-detail-shell{padding-block:clamp(38px,6vw,72px) clamp(70px,10vw,130px);background:#fff}.notification-breadcrumb{display:flex;max-width:900px;align-items:center;gap:9px;margin:0 auto 34px;color:var(--muted);font-size:12px}.notification-breadcrumb a{color:var(--accent-dark);font-weight:750;text-decoration:none}.notification-breadcrumb a:hover{text-decoration:underline;text-underline-offset:4px}.notification-detail-card{background:#fff}.notification-detail-head{max-width:900px;margin-inline:auto;padding:0 0 36px;border-bottom:1px solid var(--line)}.idea-detail-badges{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:20px}.idea-detail-type{color:var(--accent-dark);font-size:11px;font-weight:850;text-transform:uppercase;letter-spacing:.07em}.idea-detail-location{color:var(--muted);font-size:11px;font-weight:750}.idea-detail-tag,.idea-status{display:inline-flex;padding:5px 10px;border-radius:999px;font-size:11px;font-weight:800}.idea-detail-tag{background:var(--soft);color:#555158}.idea-status.is-open{color:#2b5a92;background:rgba(45,100,170,.1)}.idea-status.is-resolved{color:#246247;background:rgba(42,112,82,.1)}.notification-detail-head h1{max-width:860px;margin:0;color:var(--ink);font-size:clamp(40px,6vw,68px);font-weight:500;line-height:1.04;letter-spacing:-.04em}.notification-detail-summary{max-width:760px;margin:22px 0 0;color:#65636a;font-family:Georgia,var(--font-body);font-size:20px;line-height:1.55}.notification-detail-byline{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:32px}.notification-detail-author{display:grid;grid-template-columns:auto 1fr;column-gap:9px;color:var(--ink);text-decoration:none}.notification-detail-author>span{grid-row:1/3;align-self:center;color:var(--accent);font-size:9px}.notification-detail-author strong{font-size:14px}.notification-detail-author small{color:var(--muted);font-size:11px}.notification-detail-author:hover strong{text-decoration:underline}.notification-detail-reading{display:flex;gap:12px;color:var(--muted);font-size:12px}.notification-detail-body{max-width:720px;margin-inline:auto;padding:clamp(38px,6vw,68px) 0}.idea-detail-rich{color:#29292c;font-family:Georgia,"Times New Roman",serif;font-size:18px;line-height:1.85}.idea-detail-rich :global(p){margin:0 0 25px}.idea-detail-rich :global(h1),.idea-detail-rich :global(h2),.idea-detail-rich :global(h3),.idea-detail-rich :global(h4){margin:42px 0 16px;color:var(--ink);font-family:var(--font-body);font-weight:750;line-height:1.25}.idea-detail-rich :global(h1){font-size:30px}.idea-detail-rich :global(h2){font-size:26px}.idea-detail-rich :global(h3){font-size:22px}.idea-detail-rich :global(h4){font-size:19px}.idea-detail-rich :global(ul),.idea-detail-rich :global(ol){margin:0 0 26px;padding-left:28px}.idea-detail-rich :global(li){margin-bottom:10px;padding-left:5px}.idea-detail-rich :global(li::marker){color:var(--accent)}.idea-detail-rich :global(a){color:var(--accent-dark);text-decoration:underline;text-underline-offset:3px;word-break:break-word}.idea-detail-rich :global(strong){color:var(--ink)}.idea-detail-rich :global(blockquote){margin:34px 0;padding:4px 0 4px 24px;border-left:3px solid var(--ink);font-size:20px;font-style:italic}.idea-detail-rich :global(blockquote p){margin:0}.idea-detail-rich :global(code){padding:2px 6px;border-radius:4px;background:#f1eef0;font-size:15px}.idea-detail-rich :global(hr){margin:38px 0;border:0;border-top:1px solid var(--line)}.idea-detail-rich :global(table){display:block;max-width:100%;margin-bottom:28px;overflow-x:auto;border-collapse:collapse;font-family:var(--font-body);font-size:14px}.idea-detail-rich :global(th),.idea-detail-rich :global(td){padding:9px 14px;border:1px solid var(--line);text-align:left}.idea-detail-actions{margin-top:48px;padding-top:30px;border-top:1px solid var(--line)}
  @media(max-width:600px){.notification-detail-shell{padding-top:28px}.notification-breadcrumb{margin-bottom:26px}.notification-detail-head{padding-bottom:28px}.notification-detail-head h1{font-size:40px}.notification-detail-summary{font-size:18px}.notification-detail-byline{align-items:flex-start;flex-direction:column;gap:12px}.notification-detail-body{padding-block:36px}.idea-detail-rich{font-size:17px}}
</style>
