---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { atlasCountries } from '../../../data/atlas';
---
<BaseLayout title="Atlas · Illyrian Brains" description="Atlas — guida praktike për integrim, të ndërtuara nga komuniteti Illyrian Brains për çdo vend.">
  <Header />
  <main>
    <section class="section tone-dark">
      <div class="container city-page">
        <p class="eyebrow">Projektet</p>
        <h1>Atlas</h1>
        <p class="about-body">Një guidë praktike për shqiptarët në mërgim, ndërtuar nga vetë komuniteti — përditshmëria, dokumentat dhe emigrimi, integrimi dhe rrjetëzimi, vend pas vendi. Nuk zëvendëson në asnjë mënyrë burimet zyrtare.</p>
      </div>
    </section>

    <section class="section tone-white">
      <div class="container">
        <div class="atlas-grid">
          {atlasCountries.map((country) => (
            <a class="atlas-card" href={`/projektet/atlas/${country.slug}/`}>
              <span class="atlas-flag" aria-hidden="true">{country.flag}</span>
              <span class="atlas-card-title">{country.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
