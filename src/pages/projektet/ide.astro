---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/directory.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ideas from '../../data/ideas.json';
import { ORG_EMAIL, ideaRowHtml, type Idea } from '../../scripts/ideas';

// "Mundësitë" (formerly "Ndaj Ide"): the public ideas & requests, as a
// LinkedIn-style feed. Ideas come from Supabase (scripts/sync-ideas-supabase.mjs writes ideas.json
// before each build), and the list reloads live in the browser — see the
// script below — so ideas published since the last deploy show up too.
// The public "#" number is the Supabase id; before the switch (no ids yet),
// the oldest idea is #1 as well.
const numberOf = (idea: Idea, index: number) => idea.id ?? ideas.length - index;
const rowsHtml = (ideas as Idea[]).map((idea, index) => ideaRowHtml(idea, numberOf(idea, index), true)).join('');
const builtSlugs = ideas.map((idea) => idea.slug);

// For people who aren't members (and so can't sign in): the old email route.
const shareIdeaMailto = `mailto:${ORG_EMAIL}?subject=${encodeURIComponent('Ide e re nga rrjeti')}&body=${encodeURIComponent('Përshëndetje,\n\nDua të ndaj një ide:\n\nTitulli:\nPërshkrimi:\nEtiketat (p.sh. Berlin, punë, IT):\n\nA dëshiron që emri yt të shfaqet publikisht? (po/jo):')}`;
const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || '';
---
<BaseLayout title="Mundësitë · Illyrian Brains" description="Mundësi, kërkesa dhe oferta nga anëtarët e rrjetit — për njëri-tjetrin, jo për organizatën.">
  <Header />
  <main>
    <section class="section tone-dark page-hero page-hero--ideas">
      <div class="container city-page">
        <p class="eyebrow">Laboratori</p>
        <h1>Mundësitë</h1>
        <p class="about-body">Nga rrjeti, për rrjetin. Dikush kërkon punë, dikush ofron ndihmë, dikush do të nisë një grup të ri në qytetin e vet. Këtu i gjen dhe i ndan.</p>
        <a class="partner-button ideas-hero-cta" href={shareIdeaMailto}>Na e dërgo me email <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section tone-white ideas-how-section">
      <div class="container city-page">
        <div class="ideas-how">
          <div class="ideas-how-step">
            <span class="ideas-how-number">1</span>
            <h3>Ndaje</h3>
            <p><a href={shareIdeaMailto}>Na e dërgo me email</a> dhe ekipi i IB e shton në listë. Na thuaj nëse do që emri yt të shfaqet publikisht.</p>
          </div>
          <div class="ideas-how-step">
            <span class="ideas-how-number">2</span>
            <h3>Komuniteti përgjigjet</h3>
            <p>Çdo mundësi ka një buton "Përgjigju me email" — kushdo i interesuar të kontakton drejtpërdrejt.</p>
          </div>
          <div class="ideas-how-step">
            <span class="ideas-how-number">3</span>
            <h3>E zgjidhur</h3>
            <p>Kur ideja gjen atë që kërkonte — punë, grup, bashkëpunëtor — shënohet "E zgjidhur", që lista të mbetet e freskët për kërkesat ende aktive.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section tone-grey" id="idete">
      <div class="container city-page">
        <p class="about-body" id="idea-none" hidden={ideas.length > 0}>Ende nuk ka mundësi të shtuara. Bëhu i pari më poshtë.</p>
        <div class="ideas-feed-layout" id="idea-catalog" hidden={ideas.length === 0}>
          <aside class="ideas-feed-aside">
            <div class="ideas-feed-card" aria-label="Filtro mundësitë">
              <h2>Gjej mundësinë e duhur</h2>
              <div class="member-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="idea-search" type="search" placeholder="Kërko sipas fjalës kyçe…" aria-label="Kërko mundësi"/></div>
              <div class="tag-filter" id="idea-tags" aria-label="Filtro sipas etiketave" hidden></div>
              <select id="idea-sort" aria-label="Rendit mundësitë"><option value="latest">Më të rejat</option><option value="earliest">Më të vjetrat</option></select>
            </div>
            <div class="ideas-feed-card">
              <h2>Ke diçka për rrjetin?</h2>
              <p>Kërkon punë, ofron ndihmë ose do të nisësh një grup? Ndaje me anëtarët.</p>
              <a class="partner-button" href={shareIdeaMailto}>Na e dërgo me email <span aria-hidden="true">→</span></a>
            </div>
          </aside>
          <div class="ideas-feed-main">
            <p class="idea-result-count" id="idea-result-count"></p>
            <ul class="idea-list" id="idea-list" data-built-slugs={JSON.stringify(builtSlugs)} data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} set:html={rowsHtml}></ul>
            <p class="directory-empty" id="idea-empty" hidden>Asnjë mundësi nuk përputhet me filtrat.</p>
            <div class="idea-pagination" id="idea-pagination"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section tone-dark ideas-cta-section">
      <div class="container city-page ideas-cta">
        <div class="ideas-cta-copy">
          <p class="eyebrow">Shto një mundësi</p>
          <h2>Hidhe kërkesën ose ofertën tënde në kavanoz.</h2>
          <p class="about-body">Kërkon punë? Do të nisësh një grup? Ke diçka për t'i ofruar dikujt tjetër në rrjet? Na e dërgo me email — pak minuta. Mund të zgjedhësh të mos shfaqësh emrin tënd publikisht.</p>
          <a class="partner-button" href={shareIdeaMailto}>Na e dërgo me email <span aria-hidden="true">→</span></a>
          <p class="ideas-cta-alt">Ekipi i IB e shton në listë. Nuk je ende anëtar? <a href="/anetaresohu/regjistrohu/">Regjistrohu</a>.</p>
        </div>
        <svg class="ideas-jar" viewBox="0 0 140 170" aria-hidden="true">
          <rect x="22" y="28" width="96" height="20" rx="6" fill="#5d374d" />
          <rect x="32" y="46" width="76" height="12" fill="#c9aebd" />
          <path d="M32,58 L32,128 A16,16 0 0 0 48,144 L92,144 A16,16 0 0 0 108,128 L108,58 Z" fill="rgba(255,255,255,.06)" stroke="#c9aebd" stroke-width="2.5" />
          <g transform="rotate(-11 58 103)">
            <rect x="44" y="93" width="28" height="20" rx="4" fill="#c9aebd" />
            <line x1="49" y1="100" x2="65" y2="100" stroke="#5d374d" stroke-width="1.6" stroke-linecap="round" />
            <line x1="49" y1="105" x2="60" y2="105" stroke="#5d374d" stroke-width="1.6" stroke-linecap="round" />
          </g>
          <g transform="rotate(8 80 112)">
            <rect x="66" y="102" width="28" height="20" rx="4" fill="#744761" />
            <line x1="71" y1="109" x2="87" y2="109" stroke="#f0e3ea" stroke-width="1.6" stroke-linecap="round" />
            <line x1="71" y1="114" x2="82" y2="114" stroke="#f0e3ea" stroke-width="1.6" stroke-linecap="round" />
          </g>
          <g transform="rotate(-4 65 124)">
            <rect x="50" y="114" width="30" height="20" rx="4" fill="#f6f5f5" />
            <line x1="55" y1="121" x2="71" y2="121" stroke="#5d374d" stroke-width="1.6" stroke-linecap="round" />
            <line x1="55" y1="126" x2="66" y2="126" stroke="#5d374d" stroke-width="1.6" stroke-linecap="round" />
          </g>
          <g stroke="#c9aebd" stroke-width="2" stroke-linecap="round">
            <path d="M118 14 L118 24 M113 19 L123 19" />
            <path d="M25 12 L25 18 M22 15 L28 15" />
          </g>
        </svg>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { ideaFromRow, ideaRowHtml, tagFilter, type Idea } from '../../scripts/ideas';

  const PAGE_SIZE = 12;
  const ideaSearch = document.querySelector<HTMLInputElement>('#idea-search');
  const ideaSort = document.querySelector<HTMLSelectElement>('#idea-sort');
  const ideaCount = document.querySelector<HTMLElement>('#idea-result-count');
  const ideaEmpty = document.querySelector<HTMLElement>('#idea-empty');
  const ideaPagination = document.querySelector<HTMLElement>('#idea-pagination');
  let ideaRows = [...document.querySelectorAll<HTMLElement>('.idea-row')];
  let currentPage = 1;

  function renderPagination(totalPages: number) {
    if (!ideaPagination) return;
    if (totalPages <= 1) { ideaPagination.innerHTML = ''; return; }
    const pageButton = (page: number, label: string, disabled = false, extraClass = '') =>
      `<button type="button" data-page="${page}" class="${page === currentPage ? 'is-active' : ''} ${extraClass}" ${disabled ? 'disabled' : ''}>${label}</button>`;
    let html = pageButton(currentPage - 1, '‹ Mbrapa', currentPage === 1, 'idea-pagination-nav');
    for (let page = 1; page <= totalPages; page++) html += pageButton(page, String(page));
    html += pageButton(currentPage + 1, 'Para ›', currentPage === totalPages, 'idea-pagination-nav');
    html += `<span class="idea-pagination-label">Faqja ${currentPage} nga ${totalPages}</span>`;
    ideaPagination.innerHTML = html;
    ideaPagination.querySelectorAll<HTMLButtonElement>('button:not(:disabled)').forEach((button) => {
      button.addEventListener('click', () => {
        currentPage = Number(button.dataset.page);
        filterIdeas();
        document.querySelector('#idete')?.scrollIntoView({ block: 'start' });
      });
    });
  }

  function filterIdeas() {
    const query = (ideaSearch?.value || '').trim().toLocaleLowerCase('sq');
    const sort = ideaSort?.value || 'latest';
    const matched = ideaRows.filter((row) => (!query || (row.dataset.search || '').includes(query)) && tags.matches(row));
    matched.sort((a, b) => {
      const dateA = Date.parse(a.dataset.date || '');
      const dateB = Date.parse(b.dataset.date || '');
      if (isNaN(dateA) && isNaN(dateB)) return 0;
      if (isNaN(dateA)) return 1; // undated rows sink to the bottom either way
      if (isNaN(dateB)) return -1;
      return sort === 'earliest' ? dateA - dateB : dateB - dateA;
    });
    const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
    currentPage = Math.min(currentPage, totalPages);
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageRows = new Set(matched.slice(start, start + PAGE_SIZE));
    ideaRows.forEach((row) => { row.hidden = !pageRows.has(row); });
    if (ideaCount) ideaCount.textContent = `${matched.length} ${matched.length === 1 ? 'mundësi u gjet' : 'mundësi u gjetën'}`;
    if (ideaEmpty) ideaEmpty.hidden = matched.length > 0;
    renderPagination(totalPages);
  }
  ideaSearch?.addEventListener('input', () => { currentPage = 1; filterIdeas(); });
  const tags = tagFilter(document.querySelector<HTMLElement>('#idea-tags')!, () => { currentPage = 1; filterIdeas(); });
  tags.render(ideaRows);
  ideaSort?.addEventListener('change', () => { currentPage = 1; filterIdeas(); });
  filterIdeas();

  // Live reload: the list above was built at the last deploy; fetch the
  // published ideas now so ones published since (and resolved/removed ones)
  // are up to date. Ideas without a built page open their full text in the row.
  const list = document.querySelector<HTMLElement>('#idea-list')!;
  const { supabaseUrl, supabaseKey } = list.dataset;
  if (supabaseUrl && supabaseKey) {
    const builtSlugs = new Set<string>(JSON.parse(list.dataset.builtSlugs || '[]'));
    fetch(`${supabaseUrl}/rest/v1/public_ideas?select=*&order=created_at.desc`, { headers: { apikey: supabaseKey, ...(supabaseKey.startsWith('eyJ') && { Authorization: `Bearer ${supabaseKey}` }) } })
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((rows: any[]) => {
        const ideas: Idea[] = rows.map(ideaFromRow);
        list.innerHTML = ideas.map((idea) => ideaRowHtml(idea, idea.id!, builtSlugs.has(idea.slug))).join('');
        ideaRows = [...list.querySelectorAll<HTMLElement>('.idea-row')];
        tags.render(ideaRows);
        document.querySelector<HTMLElement>('#idea-none')!.hidden = ideas.length > 0;
        document.querySelector<HTMLElement>('#idea-catalog')!.hidden = ideas.length === 0;
        filterIdeas();
      })
      .catch(() => {}); // e.g. 005-ideas.sql not run yet — keep the built list
  }
</script>

<style>
  .ideas-hero-cta { margin-top: 26px; }

  .ideas-how-section { padding-block: clamp(40px, 6vw, 60px); }
  .ideas-how { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .ideas-how-step { position: relative; padding-left: 44px; }
  .ideas-how-number { position: absolute; left: 0; top: 0; display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid rgba(116,71,97,.3); border-radius: 50%; color: var(--accent-dark); font-size: 13px; font-weight: 800; }
  .ideas-how-step h3 { margin: 0 0 6px; font-size: 16px; font-weight: 700; }
  .ideas-how-step p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
  @media (max-width: 760px) {
    .ideas-how { grid-template-columns: 1fr; gap: 22px; }
  }

  .ideas-feed-layout { display: grid; grid-template-columns: 300px minmax(0, 720px); gap: 28px; align-items: start; justify-content: center; }
  .ideas-feed-layout[hidden] { display: none; }
  .ideas-feed-aside { display: grid; gap: 16px; position: sticky; top: 96px; }
  .ideas-feed-card { display: grid; gap: 12px; padding: 20px; border: 1px solid var(--line); border-radius: 14px; background: #fff; }
  .ideas-feed-card h2 { margin: 0; font-size: 18px; }
  .ideas-feed-card p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .ideas-feed-card select { width: 100%; }
  .ideas-feed-card .partner-button { margin-top: 0; justify-self: start; }
  .idea-result-count { margin: 0 0 12px; color: var(--muted); font-size: 13px; }
  .directory-empty { margin: 30px 0; color: var(--muted); }
  @media (max-width: 900px) {
    .ideas-feed-layout { grid-template-columns: 1fr; }
    .ideas-feed-aside { position: static; }
  }

  .idea-pagination { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px; margin: 32px 0 0; padding-top: 22px; border-top: 1px solid var(--line); }
  .idea-pagination :global(.idea-pagination-label) { margin-left: 8px; color: var(--muted); font-size: 13px; }
  .idea-pagination :global(button) { min-width: 34px; height: 34px; padding: 0 12px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); background: #fff; font: 700 13px var(--font-body); cursor: pointer; transition: color .15s ease, background-color .15s ease, border-color .15s ease; }
  .idea-pagination :global(button.idea-pagination-nav) { min-width: auto; color: var(--accent-dark); }
  .idea-pagination :global(button:hover:not(:disabled)) { color: #fff; border-color: var(--accent); background: var(--accent); }
  .idea-pagination :global(button.is-active) { color: #fff; border-color: var(--accent); background: var(--accent); }
  .idea-pagination :global(button:disabled) { opacity: .4; cursor: default; }


  .ideas-cta-section { padding-block: clamp(55px, 8vw, 90px); }
  .ideas-cta { display: grid; grid-template-columns: minmax(0, 1fr) minmax(150px, 220px); gap: clamp(30px, 6vw, 70px); align-items: center; }
  .ideas-cta-copy .eyebrow { margin-bottom: 10px; }
  .ideas-cta-copy h2 { margin: 0 0 14px; font-size: clamp(30px, 3.6vw, 42px); font-weight: 400; line-height: 1.1; color: #fff; }
  .ideas-cta-copy .about-body { color: rgba(255,255,255,.68); }
  .ideas-cta-copy .partner-button { margin-top: 22px; }
  .ideas-cta-alt { margin: 16px 0 0; color: rgba(255,255,255,.6); font-size: 14px; line-height: 1.6; }
  .ideas-cta-alt a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .ideas-jar { width: 100%; max-width: 220px; justify-self: center; }
  @media (max-width: 700px) {
    .ideas-cta { grid-template-columns: 1fr; text-align: center; }
    .ideas-jar { max-width: 160px; }
  }
</style>
