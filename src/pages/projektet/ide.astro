---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Ide · Illyrian Brains" description="Ide — një hapësirë për të mbledhur ide dhe informacion nga komuniteti i Illyrian Brains.">
  <Header />
  <main>
    <section class="section tone-dark page-hero page-hero--ideas">
      <div class="container city-page">
        <p class="eyebrow">Projektet</p>
        <h1>Ide</h1>
        <p class="about-body">Një hapësirë për të mbledhur ide dhe informacion nga komuniteti — vend ku çdo anëtar mund të propozojë atë që rrjeti duhet të ndërtojë më pas.</p>
        <p class="about-body">Përmbajtja për këtë projekt do të shtohet së shpejti.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
