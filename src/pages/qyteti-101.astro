---
import SiteLayout from '../layouts/SiteLayout.astro';
import JoinCTA from '../components/JoinCTA.astro';
import CityCommunityNetwork from '../components/CityCommunityNetwork.astro';

const responsibilities = [
  { number: '01', title: 'Koordinimi', summary: 'Mban ekipin të lidhur dhe kujdeset që qyteti të mos ndalet.', details: ['Vendos ritmin dhe prioritetet bashkë me koordinatorin tjetër, në linjë me qëllimin profesional të rrjetit.', 'Mban lidhjen me rrjetin IB dhe me qytetet e tjera, për të sjellë mundësi (evente, bashkëpunime, burime) te anëtarët.', 'Ndjek nevojat profesionale të komunitetit, për t’i orientuar aktivitetet drejt tyre.', 'Siguron një dorëzim të qartë — kontakte, kalendar, histori — kur dikush largohet nga roli.'] },
  { number: '02', title: 'Rrjetëzimi', summary: 'Përdor platformën e anëtarëve për të lidhur njerëzit me projektet dhe profesionistët e duhur, sipas asaj që kërkojnë.', details: ['Shfleton profilet dhe aspiratat e anëtarëve në platformë për të kuptuar çfarë kërkojnë — një projekt, një mentor, një lidhje profesionale.', 'Përdor rekomandimet e "Rrjeti im" dhe listën e anëtarëve për të gjetur përputhjet më të mira dhe për t’i prezantuar me njëri-tjetrin.', 'I lidh me projektet e tjera të rrjetit (Atlas, Mentoring, Heritage, Global) kur interesi përputhet.', 'Ndjek nëse lidhja ka funksionuar dhe krijon lidhje të reja kur nevojitet.'] },
  { number: '03', title: 'Komunikimi', summary: 'Mban qytetin të dukshëm në rrjetet sociale dhe kanalet e komunitetit.', details: ['Përgatit dhe publikon përmbajtje për rrjetet sociale rreth aktiviteteve dhe komunitetit.', 'Mban një ton profesional, në linjë me identitetin e Illyrian Brains.', 'Nxit dukshmërinë e anëtarëve dhe arritjeve të tyre profesionale.', 'Bashkërendon me ekipin qendror të IB për kanalet dhe materialet e përbashkëta.'] },
];

const activityRoles = [
  { number: '01', title: 'Përgjegjësja e aktivitetit', summary: 'Drejton aktivitetin nga njoftimi deri në mbyllje.', details: ['Njofton aktivitetin në kanalet e komunitetit dhe ndjek konfirmimet.', 'Hap dhe mbyll aktivitetin, duke mbajtur kohën dhe ritmin e axhendës.', 'Kalon fjalën mes pjesëve të takimit dhe përgjigjet pyetjeve të pjesëmarrësve.', 'Përgatit një temë ose fokus profesional për takimin (karrierë, industri, aftësi), kur ka mundësi.'] },
  { number: '02', title: 'Mikpritësi', summary: 'Krijon kushtet për njohje dhe lidhje profesionale mes pjesëmarrësve.', details: ['Përshëndet njerëzit që vijnë.', 'Prezanton pjesëmarrësit e rinj me pjesën tjetër të grupit, duke përmendur fushën e tyre profesionale.', 'Kujdeset që askush të mos mbetet vetëm, duke nxitur biseda dhe lidhje të reja.', 'Fton pjesëmarrësit të ndajnë shkurtimisht me çfarë merren, për të lehtësuar njohjet.'] },
  { number: '03', title: 'Përgjegjësja e vendit dhe logjistikës', summary: 'Siguron që hapësira dhe gjërat e nevojshme janë gati.', details: ['Rezervon ose organizon një vend të përshtatshëm për një takim profesional.', 'Kujdeset për ulëset, pajisjet dhe çdo material të nevojshëm (p.sh. ekran për prezantime).', 'Zgjidh çështjet logjistike që dalin në çast.', 'Mendon për detaje që lehtësojnë bisedat profesionale, si një hapësirë e qetë për biseda individuale.'] },
];

const advancedQuestions = [
  { question: 'Si e zgjerojmë komunitetin pa humbur lidhjen mes anëtarëve?', answer: 'Mbajeni komunitetin kryesor si pikën e përbashkët, mirëpritni rregullisht pjesëmarrësit e rinj dhe krijoni role të vogla ku njerëzit mund të kontribuojnë pa marrë përsipër shumë punë.', todo: ['Caktoni dikë përgjegjës për mirëseardhjen e çdo anëtari të ri.', 'Mbani një kalendar të përbashkët, të dukshëm për të gjithë.', 'Krijoni 2–3 role të vogla, të marra përsipër nga vullnetarë.'] },
  { question: 'Kur ka kuptim të krijojmë një grup të ri, dhe si bashkëjetojnë disa grupe në të njëjtin qytet?', answer: 'Krijojeni kur ka interes të përsëritur, një qëllim të qartë dhe të paktën një anëtar që do të kujdeset për vazhdimësinë. Çdo grup mban ritmin dhe organizatorët e vet, por të gjithë ndajnë kalendarin dhe lidhjen me komunitetin kryesor të qytetit.', todo: ['Konfirmoni se ka interes të përsëritur, jo vetëm një kërkesë të vetme.', 'Gjeni një anëtar që merr përsipër vazhdimësinë e grupit.', 'Shtoni grupin te kalendari dhe kanalet e përbashkëta të qytetit.'] },
  { question: 'Si i bëjmë eventet dhe ekipin organizator të qëndrueshëm?', answer: 'Përdorni formate që përsëriten, planifikoni paraprakisht dhe ndryshoni personin përgjegjës nga një event te tjetri. Ftoni njerëz të marrin përsipër një aktivitet konkret — me kohë disa prej tyre bëhen koordinatorë të rinj.', todo: ['Zgjidhni 2–3 formate eventesh që mund t’i përsërisni pa shumë planifikim.', 'Rrotulloni rolet e aktivitetit nga një event te tjetri.', 'Ftoni rregullisht anëtarë të marrin përsipër një detyrë konkrete.'] },
  { question: 'Si gjejmë partnerë, hapësira dhe sponsorizime për aktivitetet?', answer: 'Krijoni marrëdhënie të qëndrueshme me kompani, universitete, inkubatorë dhe hapësira lokale — për praktika, vende pune, mentorim ose sponsorizim. Regjistrojini te Shoqatat dhe Bizneset e rrjetit dhe mbani shpenzimet e kontributet transparente.', todo: ['Identifikoni 3–5 kompani ose institucione lokale për t’i kontaktuar.', 'Regjistrojini partnerët te Shoqatat ose Bizneset e rrjetit.', 'Mbani një tabelë të thjeshtë me marrëveshjet, shpenzimet dhe kontributet.'] },
  { question: 'Si e matim ndikimin profesional të qytetit?', answer: 'Ndjekni tregues të thjeshtë — praktika ose punë të gjetura përmes rrjetit, lidhje mentorimi që kanë funksionuar, pjesëmarrje në evente — dhe ndajini periodikisht me komunitetin.', todo: ['Zgjidhni 3–4 tregues të thjeshtë për t’i ndjekur (punë, mentorime, pjesëmarrje).', 'Mbledhini këto të dhëna pas çdo aktiviteti të madh.', 'Ndani rezultatet me komunitetin një ose dy herë në vit.'] },
  { question: 'A duhet qyteti të regjistrohet si organizatë e veçantë, dhe si ruajmë cilësinë kur rritet?', answer: 'Jo domosdoshmërisht — qyteti funksionon si pjesë e Illyrian Brains, pa barrën administrative të një OJQ-je. Me rritjen e ekipit, mbështetuni te rolet e qarta (koordinim, rrjetëzim, komunikim) dhe standarde të thjeshta për format e aktiviteteve.', todo: ['Kontaktoni ekipin qendror të IB vetëm nëse lind nevoja për fonde ose marrëveshje formale.', 'Shkruani standardet bazë të formatit dhe tonit, në një faqe të thjeshtë.', 'Rishikoni rolet e koordinimit, rrjetëzimit dhe komunikimit kur ekipi zgjerohet.'] },
];

const faqs = [
  { question: 'Si bashkohem me komunitetin e qytetit tim?', answer: 'Regjistrohuni te "Regjistrohu" dhe zgjidhni qytetin tuaj. Pas miratimit, do të shihni aktivitetet dhe kanalet e qytetit dhe mund të lidheni me anëtarët e tjerë.' },
  { question: 'A kushton diçka të bëhesh anëtar?', answer: 'Jo, anëtarësimi është falas. Roli juaj (Pjesëmarrës, Mbështetës, Organizator, Kontribues) përcakton si kontribuoni, jo ndonjë pagesë.' },
  { question: 'Çfarë duhet të pres herën e parë që shkoj në një aktivitet?', answer: 'Një mikpritës/e do t’ju përshëndesë dhe do t’ju prezantojë me pjesën tjetër të grupit. Nuk ka asnjë detyrim — mund të vini thjesht për të njohur njerëz dhe për të parë si funksionon komuniteti.' },
  { question: 'Sa persona duhen për ekipin lokal?', answer: 'Minimumi tre koordinatorë, që ndajnë vazhdimësinë e qytetit, komunitetin dhe komunikimin. Më shumë veta e lehtësojnë ndarjen e punës, por tre mjaftojnë për të filluar — rolet e çdo aktiviteti konkret ndahen veçmas, mes kujtdo që merr pjesë.' },
  { question: 'Sa shpesh duhet të organizohet një takim?', answer: 'Një takim në muaj është një ritëm i dobishëm, por jo një detyrim. Zgjidhni një ritëm që mund ta mbani me vazhdimësi.' },
  { question: 'Kush mund të propozojë një aktivitet?', answer: 'Çdo pjesëmarrës. Ekipi lokal ndihmon me koordinimin, ndërsa personi që sjell idenë mund të krijojë një grup të vogël për ta realizuar.' },
];
---

<SiteLayout title="Qyteti 101 · Illyrian Brains" description="Udhëzuesi i thjeshtë për organizimin e një komuniteti lokal të Illyrian Brains.">
  <section class="guide-hero">
    <div class="guide-container">
      <p class="eyebrow">Rreth nesh · Qytetet</p>
      <h1>Qyteti 101</h1>
      <p>Udhëzuesi i thjeshtë për të organizuar dhe mbajtur në lëvizje një komunitet lokal.</p>
    </div>
  </section>

  <main>
    <section class="guide-section guide-overview" aria-labelledby="overview-title">
      <div class="guide-container">
        <header class="guide-heading"><h2 id="overview-title">Tre pjesë që duhen organizuar në çdo qytet.</h2></header>
        <p class="guide-copy">Këto krijojnë strukturën bazë. Secila ka një qëllim të ndryshëm dhe së bashku e bëjnë qytetin të hapur, aktiv dhe të qëndrueshëm.</p>
        <div class="guide-foundations">
          <article><span>01</span><h3>Ekipi organizator</h3><p>Minimumi tre koordinatorë kujdesen për vazhdimësinë, komunitetin dhe komunikimin e qytetit; çdo aktivitet ndahet më tej në tre role të përkohshme.</p></article>
          <article><span>02</span><h3>Komuniteti kryesor</h3><p>Hapësira e përbashkët për të gjithë pjesëmarrësit, me komunikim të qartë dhe evente të hapura periodike.</p></article>
          <article><span>03</span><h3>Grupet tematike</h3><p>Grupe që krijohen rreth interesave konkrete dhe drejtohen nga anëtarë që duan të marrin përgjegjësi.</p></article>
        </div>
        <div class="guide-photos">
          <figure><img src="/assets/inst_meetup.png" alt="Pjesëmarrës të Illyrian Brains duke ndjekur një bisedë komunitare" loading="lazy" /><figcaption>Takimi i përbashkët krijon ritëm.</figcaption></figure>
          <figure><img src="/assets/cities/Berlin.jpg" alt="Komuniteti Illyrian Brains në Berlin gjatë një aktiviteti në natyrë" loading="lazy" /><figcaption>Formati përshtatet me komunitetin.</figcaption></figure>
        </div>
      </div>
    </section>

    <section class="guide-section guide-team" aria-labelledby="team-title">
      <div class="guide-container">
        <header class="guide-heading"><h2 id="team-title">Ekipi i qytetit</h2></header>
        <p class="guide-copy">Çdo qytet ka minimumi tre koordinatorë që kujdesen për vazhdimësinë, komunitetin dhe komunikimin. Çdo aktivitet konkret ndahet më tej në tre role të përkohshme, që mund t’i marrë përsipër kushdo.</p>
        <h3 class="guide-subhead">Minimumi tre koordinatorë</h3>
        <div class="guide-roles">
          {responsibilities.map(role => <details><summary><span>{role.number}</span><div><h3>{role.title}</h3><p>{role.summary}</p></div><i aria-hidden="true"></i></summary><ul>{role.details.map(detail => <li>{detail}</li>)}</ul></details>)}
        </div>
        <h3 class="guide-subhead">Tre role, për çdo aktivitet</h3>
        <div class="guide-roles">
          {activityRoles.map(role => <details><summary><span>{role.number}</span><div><h3>{role.title}</h3><p>{role.summary}</p></div><i aria-hidden="true"></i></summary><ul>{role.details.map(detail => <li>{detail}</li>)}</ul></details>)}
        </div>
      </div>
    </section>

    <section class="guide-section guide-events" aria-labelledby="events-title">
      <div class="guide-container">
        <header class="guide-heading"><h2 id="events-title">Tre formate për komunitetin e qytetit.</h2></header>
        <p class="guide-copy">Qyteti mund t’i alternojë këto formate gjatë vitit, sipas energjisë së ekipit dhe interesit të komunitetit.</p>
        <div class="guide-options">
          <article>
            <img src="/assets/inst_happyhour.png" alt="Anëtarë të komunitetit gjatë një Happy Hour" loading="lazy" />
            <div><strong>Happy Hour</strong><span>Takim i hapur dhe informal për njohje, biseda dhe lidhje të reja.</span></div>
          </article>
          <article>
            <img src="/assets/inst_global_serious.png" alt="Komuniteti gjatë një aktiviteti me të ftuar" loading="lazy" />
            <div><strong>Happy Hour me të ftuar</strong><span>Takim social me një bisedë të shkurtër dhe diskutim me një të ftuar.</span></div>
          </article>
          <article>
            <img src="/assets/cities/Aktivitete%20Octoberfest.jpeg" alt="Anëtarë të Illyrian Brains gjatë një udhëtimi të përbashkët në një qytet tjetër" loading="lazy" />
            <div><strong>Udhëtim në një qytet tjetër</strong><span>Vizitë te një komunitet tjetër IB për t’u njohur dhe organizuar diçka së bashku.</span></div>
          </article>
        </div>
      </div>
    </section>

    <section class="guide-section guide-network" aria-label="Rrjeti i qytetit">
      <div class="guide-container"><CityCommunityNetwork /></div>
    </section>

    <section class="guide-section guide-advanced" aria-labelledby="advanced-title">
      <div class="guide-container">
        <header class="guide-heading"><h2 id="advanced-title">Qyteti 401</h2></header>
        <p class="guide-copy">Pyetje për fazën kur komuniteti po rritet, po krijon grupe të reja dhe po fillon të funksionojë si një organizatë e vogël profesionale — me partnerë, burime dhe ndikim të dukshëm — pa qenë formalisht një OJQ.</p>
        <div class="guide-advanced-list">
          {advancedQuestions.map(item => (
            <details>
              <summary>{item.question}<i aria-hidden="true"></i></summary>
              <p>{item.answer}</p>
              <ul class="guide-todo">{item.todo.map(task => <li>{task}</li>)}</ul>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="guide-section guide-faq" aria-labelledby="faq-title">
      <div class="guide-container">
        <header class="guide-heading"><h2 id="faq-title">Përgjigje të shkurtra.</h2></header>
        <div class="guide-faq-list">{faqs.map(faq => <details><summary>{faq.question}<i aria-hidden="true"></i></summary><p>{faq.answer}</p></details>)}</div>
      </div>
    </section>
  </main>
  <JoinCTA />
</SiteLayout>

<style>
  .guide-container{width:min(100% - 40px,1060px);margin-inline:auto}.guide-hero{padding:88px 0 74px;color:#fff;background:var(--night)}.guide-hero h1{margin:14px 0 20px;font-size:clamp(56px,9vw,94px);font-weight:300;line-height:1;letter-spacing:-.055em}.guide-hero>div>p:last-child{max-width:680px;margin:0;color:#ffffffb0;font-size:20px;line-height:1.65}.guide-section{padding:88px 0;background:#fff}.guide-section+.guide-section{border-top:1px solid var(--line)}.guide-muted,.guide-faq{background:#efeee9}.guide-heading h2{max-width:760px;margin:0;font-size:clamp(34px,4.5vw,52px);font-weight:400;line-height:1.08;letter-spacing:-.04em}.guide-copy{max-width:760px;margin:28px 0 0;color:var(--muted);font-size:17px;line-height:1.75}.guide-foundations{display:grid;grid-template-columns:repeat(3,1fr);margin-top:42px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.guide-foundations article{padding:28px 26px}.guide-foundations article+article{border-left:1px solid var(--line)}.guide-foundations span{color:var(--accent-dark);font-size:13px;font-weight:700}.guide-foundations h3{margin:34px 0 12px;font-size:22px}.guide-foundations p{margin:0;color:var(--muted);font-size:15px;line-height:1.65}.guide-photos{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:46px}.guide-photos figure{margin:0}.guide-photos img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.guide-photos figcaption{padding-top:10px;color:var(--muted);font-size:13px}.guide-roles{margin-top:36px;border-top:1px solid var(--line)}.guide-roles details{border-bottom:1px solid var(--line)}.guide-roles summary{display:grid;grid-template-columns:42px 1fr 34px;gap:16px;align-items:center;padding:24px 0;list-style:none;cursor:pointer}.guide-roles summary::-webkit-details-marker,.guide-faq-list summary::-webkit-details-marker{display:none}.guide-roles summary>span{color:var(--accent-dark);font-size:13px;font-weight:700}.guide-roles h3{margin:0 0 4px;font-size:22px}.guide-roles summary p{margin:0;color:var(--muted);font-size:15px;line-height:1.55}.guide-roles summary i,.guide-faq-list summary i{position:relative;width:30px;height:30px;border:1px solid var(--line);border-radius:50%}.guide-roles summary i::before,.guide-roles summary i::after,.guide-faq-list summary i::before,.guide-faq-list summary i::after{position:absolute;top:50%;left:50%;width:10px;height:1px;background:var(--ink);content:'';transform:translate(-50%,-50%)}.guide-roles summary i::after,.guide-faq-list summary i::after{transform:translate(-50%,-50%) rotate(90deg)}.guide-roles details[open] summary i::after,.guide-faq-list details[open] summary i::after{transform:translate(-50%,-50%)}.guide-roles ul{margin:0;padding:0 0 24px 58px;list-style:none}.guide-roles li{position:relative;padding:6px 0 6px 20px;color:#4c4e53;font-size:15px;line-height:1.6}.guide-roles li::before{position:absolute;left:0;color:var(--accent-dark);content:'—'}.guide-steps{display:grid;grid-template-columns:repeat(4,1fr);margin:40px 0 0;padding:0;border-top:1px solid #c9c8c2;border-bottom:1px solid #c9c8c2;list-style:none}.guide-steps li{padding:26px 22px}.guide-steps li+li{border-left:1px solid #c9c8c2}.guide-steps b{display:grid;width:30px;height:30px;border-radius:50%;color:#fff;background:var(--accent-dark);place-items:center}.guide-steps h3{margin:22px 0 7px;font-size:18px}.guide-steps p{margin:0;color:var(--muted);font-size:14px;line-height:1.55}.guide-events{background:#f8f7f4}.guide-options{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:36px}.guide-options article{padding-left:16px;border-left:2px solid #a5baa9}.guide-options strong,.guide-options span{display:block}.guide-options strong{margin-bottom:7px;font-size:15px}.guide-options span{color:var(--muted);font-size:14px;line-height:1.55}.guide-network{color:#fff;background:#20242a}.guide-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:42px;border-top:1px solid var(--line);border-left:1px solid var(--line)}.guide-info-grid article{padding:28px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.guide-info-grid h3{margin:0 0 10px;font-size:19px}.guide-info-grid p{margin:0;color:var(--muted);font-size:15px;line-height:1.65}.guide-advanced{background:#f8f7f4}.guide-advanced-intro{display:grid;grid-template-columns:220px minmax(0,1fr);gap:28px;margin-top:42px;padding:22px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.guide-advanced-intro strong{font-size:16px}.guide-advanced-intro span{max-width:650px;color:var(--muted);font-size:15px;line-height:1.65}.guide-advanced-areas{display:grid;grid-template-columns:repeat(3,1fr);margin-top:36px;border-top:1px solid var(--line);border-left:1px solid var(--line)}.guide-advanced-area{display:flex;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.guide-advanced-area>header{min-height:150px;padding:26px;background:#efeee9}.guide-advanced-area>header h3{margin:0 0 10px;font-size:21px}.guide-advanced-area>header p,.guide-advanced-area article p{margin:0;color:var(--muted);font-size:14px;line-height:1.65}.guide-advanced-area article{flex:1;padding:24px 26px;background:#fff}.guide-advanced-area article+article{border-top:1px solid var(--line)}.guide-advanced-area h4{margin:0 0 9px;font-size:17px}.guide-faq-list{margin-top:42px;border-top:1px solid #c9c8c2}.guide-faq-list details{border-bottom:1px solid #c9c8c2}.guide-faq-list summary{display:grid;grid-template-columns:1fr 30px;gap:20px;align-items:center;padding:22px 0;font-size:18px;font-weight:600;list-style:none;cursor:pointer}.guide-faq-list details>p{max-width:760px;margin:0;padding:0 50px 24px 0;color:var(--muted);font-size:16px;line-height:1.7}@media(max-width:760px){.guide-container{width:min(100% - 28px,1060px)}.guide-hero{padding:64px 0 54px}.guide-section{padding:64px 0}.guide-foundations{grid-template-columns:1fr}.guide-foundations article+article{border-top:1px solid var(--line);border-left:0}.guide-photos,.guide-info-grid,.guide-steps,.guide-options,.guide-advanced-areas{grid-template-columns:1fr}.guide-advanced-intro{grid-template-columns:1fr;gap:8px}.guide-advanced-area>header{min-height:0}.guide-steps li+li{border-top:1px solid #c9c8c2;border-left:0}.guide-options{gap:18px}.guide-roles summary{grid-template-columns:32px 1fr 30px;gap:10px}.guide-roles ul{padding-left:42px}.guide-faq-list summary{font-size:16px}}
