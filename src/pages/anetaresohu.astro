---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionTitle from '../components/SectionTitle.astro';
import NetworkDirectoryHero from '../components/NetworkDirectoryHero.astro';
import { mailto, emailTemplates } from '../data/emails';

// Three ways in: participants (incl. Miqtë e Rrjetit, monthly donors) need no membership; members are the
// active volunteers, either organizing a city or contributing to the network's teams.
const applyAs = (role: string) => mailto({ ...emailTemplates.membershipApply, subject: `Kërkesë për anëtarësim — ${role}` });
// Card icons (24×24, stroked with currentColor).
const icons = {
  people: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  layers: '<path d="m12 2 10 5-10 5L2 7l10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>',
};
const roles = [
  { title: 'Pjesëmarrës', tag: 'Pa kuotë', icon: icons.people, lead: 'Njihu me komunitetin.', items: [
    'Vjen në takimet e qytetit.',
    'Dhuron kur të duash, edhe si Mik i Rrjetit.',
  ], action: 'Gjej qytetin tënd', href: '/qytetet/', secondary: { action: 'Dhuro për rrjetin', href: '/dhuro/' } },
  { title: 'Anëtar Organizator', tag: '€30 / vit', icon: icons.pin, member: true, accent: '#397b72', lead: 'Ndërto komunitetin në qytetin tënd.', items: [
    'Organizon takimet në qytet.',
    'Ndërton ekipin lokal.',
    'Ke vend në Asamble.',
  ], action: 'Apliko si organizator', href: applyAs('Organizator') },
  { title: 'Anëtar Kontribues', tag: '€30 / vit', icon: icons.layers, member: true, accent: '#6b5aa8', lead: 'Kontribuo me ekspertizën tënde.', items: [
    'Punon në ekipet dhe projektet e rrjetit.',
    'Kontribuon nga kudo që je.',
    'Ke vend në Asamble.',
  ], action: 'Apliko si kontribues', href: applyAs('Kontribues') },
];
// What membership means, per the Statute (nenet 8–10, 13). The €30 annual fee is set by the Board (neni 8.4).
const membership = [
  { title: 'Çfarë merr', accent: '#397b72', bg: '#f2faf8', items: [
    'Vend në Asamblenë e Përgjithshme.',
    'Të drejtë vote pas 6 muajsh aktiv.',
    'Lidhje me profesionistë, qytete dhe ekipe.',
    'Raportin vjetor të rrjetit.',
  ] },
  { title: 'Çfarë presim nga ti', accent: '#6b5aa8', bg: '#f7f5fc', items: [
    'Kuotën vjetore prej €30.',
    'Kontribut në një ekip ose në qytetin tënd.',
    'Të përfaqësosh Illyrian Brains aty ku mundesh.',
    'Respekt për Statutin.',
  ] },
  { title: 'Si anëtarësohesh', accent: '#744761', bg: '#faf7f9', ordered: true, items: [
    'Dërgo kërkesën me LinkedIn dhe rrugën tënde profesionale.',
    'Bordi Drejtues e shqyrton.',
    'Paguaj kuotën vjetore.',
    'Të lidhim me qytetin dhe ekipet.',
  ] },
];
---
<BaseLayout title="Bashkohu · Illyrian Brains" description="Anëtarësohu ose organizo qytetin tënd në rrjetin Illyrian Brains.">
  <Header />
  <main>
    <NetworkDirectoryHero kind="join" eyebrow="Bëhu pjesë e rrjetit" title="Bashkohu." description="Si pjesëmarrës, si organizator në qytetin tënd ose si kontribues në ekipet e rrjetit — ndërto diçka me një komunitet shqiptar pa kufij." showVisual={false}>
      <a class="join-btn join-btn--light" href={mailto(emailTemplates.membershipApply)}>Apliko për anëtarësim <span aria-hidden="true">→</span></a>
      <a class="join-btn join-btn--ghost-light" href="/eventet/">Gjej eventet <span aria-hidden="true">→</span></a>
    </NetworkDirectoryHero>

    <section class="section tone-white" id="menyrat">
      <div class="container">
        <header class="join-overview">
          <p class="eyebrow">Bëhu pjesë</p>
          <h2>Tri mënyra për të qenë pjesë.</h2>
          <p>Për të ardhur në takimet e qytetit nuk ke nevojë të jesh anëtar. Anëtarët janë vullnetarët aktivë — në qytete ose në ekipe.</p>
        </header>
        <div class="membership-roles">
          {roles.map(role => (
            <div class:list={['membership-role', { 'is-member': role.member }]} style={role.accent && `--accent: ${role.accent}; --accent-dark: color-mix(in srgb, ${role.accent} 80%, #000)`}>
              <div class="membership-role-top">
                <span class="membership-role-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={role.icon} /></span>
                <p class="membership-role-tag">{role.tag}</p>
              </div>
              <h3>{role.title}</h3>
              <p class="membership-role-lead">{role.lead}</p>
              <ul>{role.items.map(item => <li>{item}</li>)}</ul>
              <div class="membership-role-actions">
                <a class:list={['join-btn', role.member ? 'join-btn--primary' : 'join-btn--neutral']} href={role.href}>{role.action} <span aria-hidden="true">→</span></a>
                {role.secondary && <a class="join-btn join-btn--outline" href={role.secondary.href}>{role.secondary.action} <span aria-hidden="true">→</span></a>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section tone-grey" id="anetaresia">
      <div class="container">
        <header class="join-overview">
          <p class="eyebrow">Anëtarësia</p>
          <h2>Çfarë do të thotë të jesh anëtar.</h2>
          <p>Anëtarët e drejtojnë rrjetin së bashku — përmes Asamblesë, ekipeve dhe qyteteve.</p>
        </header>
        <div class="membership-grid">
          {membership.map((group, index) => (
            <article class="membership-card" style={`--card-accent: ${group.accent}; --card-bg: ${group.bg}`}>
              <span class="membership-card-index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{group.title}</h3>
              {group.ordered
                ? <ol>{group.items.map(item => <li>{item}</li>)}</ol>
                : <ul>{group.items.map(item => <li>{item}</li>)}</ul>}
            </article>
          ))}
        </div>
        <p class="membership-fee-note"><strong>Je student ose prind i ri?</strong> Kuota mund të reduktohet ose të mos aplikohet. Shkruaje në kërkesë.</p>
        <div class="membership-footer">
          <p class="membership-note">Mund të japësh dorëheqjen kur të duash. Rregullat e plota janë në <a href="/statuti/">Statut</a>.</p>
          <a class="join-btn join-btn--primary" href={mailto(emailTemplates.membershipApply)}>Apliko për anëtarësim <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section tone-white" id="qytet-i-ri">
      <div class="container">
        <SectionTitle kicker="Qytet i ri" title="Nuk ka Illyrian Brains në qytetin tënd?" text="Na trego qytetin dhe ekipin fillestar — e planifikojmë së bashku takimin e parë. Për çdo pyetje tjetër, na shkruaj direkt." />
        <div class="join-actions">
          <a class="join-btn join-btn--primary" href={mailto(emailTemplates.organizeCity)}>Propozo qytetin <span aria-hidden="true">→</span></a>
          <a class="join-btn join-btn--outline" href={mailto(emailTemplates.joinQuestion)}>illyrianbrains@gmail.com <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
<style>
  .join-overview{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,430px);gap:0 70px;align-items:end;margin-bottom:64px}.join-overview .eyebrow{grid-column:1/-1;margin-bottom:20px}.join-overview h2{margin:0;font-size:clamp(42px,5vw,64px);font-weight:400;line-height:.98;letter-spacing:-.045em}.join-overview>p:last-child{margin:0;color:var(--muted);font-size:16px;line-height:1.7}
  .membership-roles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
  .membership-role{display:flex;flex-direction:column;padding:38px 36px;border:1px solid var(--line);border-top:4px solid color-mix(in srgb,var(--ink) 18%,var(--line));border-radius:14px;background:#fff;box-shadow:0 12px 30px rgba(23,24,29,.035);transition:transform .22s ease,box-shadow .22s ease}
  .membership-role:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgba(23,24,29,.08)}
  .membership-role.is-member{border-color:color-mix(in srgb,var(--accent) 28%,var(--line));border-top-color:var(--accent);background:linear-gradient(160deg,color-mix(in srgb,var(--accent) 7%,#fff),#fff 60%)}
  .membership-role-top{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .membership-role-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:13px;color:var(--ink);background:var(--soft,#f6f5f5)}
  .membership-role.is-member .membership-role-icon{color:var(--accent);background:color-mix(in srgb,var(--accent) 13%,#fff)}
  .membership-role-icon svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .membership-role-tag{margin:0;padding:5px 10px;border-radius:999px;color:var(--muted);background:var(--soft,#f6f5f5);font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
  .membership-role.is-member .membership-role-tag{color:#fff;background:var(--accent)}
  .membership-role h3{margin:28px 0 10px;font-size:clamp(25px,2.4vw,30px);font-weight:400;line-height:1.1}
  .membership-role-lead{margin:0 0 26px;padding-bottom:26px;border-bottom:1px solid color-mix(in srgb,var(--accent) 14%,var(--line));color:var(--ink);font-size:15px;line-height:1.55}
  .membership-role:not(.is-member) .membership-role-lead{border-bottom-color:var(--line)}
  .membership-role ul{display:grid;gap:16px;margin:0 0 36px;padding:0;list-style:none}
  .membership-role li{position:relative;padding-left:28px;color:var(--muted);font-size:15px;line-height:1.6}
  .membership-role li::before{content:'✓';position:absolute;left:0;top:.1em;display:grid;place-items:center;width:18px;height:18px;border-radius:50%;color:var(--muted);background:var(--soft,#f6f5f5);font-size:11px;font-weight:800;line-height:1}
  .membership-role.is-member li::before{color:var(--accent);background:color-mix(in srgb,var(--accent) 13%,#fff)}
  .membership-role-actions{display:grid;gap:12px;margin-top:auto}
  .membership-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
  .membership-card{display:flex;flex-direction:column;padding:38px 36px;border:1px solid color-mix(in srgb,var(--card-accent) 24%,var(--line));border-top:4px solid var(--card-accent);border-radius:14px;background:linear-gradient(145deg,var(--card-bg),#fff);box-shadow:0 12px 30px rgba(23,24,29,.045)}
  .membership-card-index{color:var(--card-accent);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}
  .membership-card h3{margin:14px 0 28px;font-size:clamp(25px,2.4vw,31px);font-weight:400;line-height:1.1}
  .membership-card :is(ul,ol){display:grid;gap:18px;margin:0;padding:0;list-style:none;counter-reset:step}
  .membership-card li{position:relative;padding-left:30px;color:var(--muted);font-size:15px;line-height:1.6}
  .membership-card ul li::before{content:'';position:absolute;left:4px;top:.6em;width:8px;height:8px;border-radius:50%;background:var(--card-accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--card-accent) 14%,transparent)}
  .membership-card ol li{counter-increment:step}
  .membership-card ol li::before{content:counter(step);position:absolute;left:0;top:.15em;display:grid;place-items:center;width:20px;height:20px;border-radius:50%;color:#fff;background:var(--card-accent);font-size:11px;font-weight:700;line-height:1}
  .membership-fee-note{margin:40px 0 0;padding:20px 26px;border-left:4px solid #397b72;border-radius:10px;color:var(--muted);background:#f2faf8;font-size:15px;line-height:1.6}.membership-fee-note strong{color:var(--ink)}
  .membership-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:18px 32px;margin-top:24px;padding:26px 32px;border:1px solid var(--line);border-radius:14px;background:#fff}
  .membership-note{margin:0;color:var(--muted);font-size:15px;line-height:1.6}.membership-note a{color:var(--accent);font-weight:700}
  .join-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:40px}
  /* Buttons for this page: primary (main action), outline/neutral (secondary), light/ghost-light (on the dark hero). */
  .join-btn{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-height:50px;padding:14px 20px;border:1px solid transparent;border-radius:10px;font-size:14px;font-weight:700;line-height:1.2;transition:transform .2s ease,background-color .2s ease,border-color .2s ease,box-shadow .2s ease}
  .join-btn span{font-size:17px;font-weight:400;transition:transform .2s ease}
  .join-btn:hover{transform:translateY(-2px)}
  .join-btn:hover span{transform:translateX(3px)}
  .join-btn[href^="#"]:hover span{transform:translateY(2px)}
  .join-btn:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .join-btn--primary{color:#fff;background:var(--accent);box-shadow:0 10px 24px color-mix(in srgb,var(--accent) 28%,transparent)}
  .join-btn--primary:hover{background:var(--accent-dark);box-shadow:0 14px 30px color-mix(in srgb,var(--accent) 34%,transparent)}
  .join-btn--outline{color:var(--accent-dark);background:#fff;border-color:color-mix(in srgb,var(--accent) 35%,var(--line))}
  .join-btn--outline:hover{border-color:var(--accent);background:#faf7f9}
  .join-btn--neutral{color:var(--ink);background:var(--soft,#f6f5f5);border-color:var(--line)}
  .join-btn--neutral:hover{border-color:color-mix(in srgb,var(--ink) 30%,var(--line));background:#fff}
  .join-btn--light{color:var(--ink);background:#fff;box-shadow:0 12px 30px rgba(0,0,0,.28)}
  .join-btn--light:hover{background:#f1e6ec}
  .join-btn--ghost-light{color:#fff;background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.28)}
  .join-btn--ghost-light:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.5)}
  :global(.network-directory-hero--join .network-directory-hero-actions){display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
  @media(max-width:900px){.membership-roles{grid-template-columns:1fr}.membership-grid{grid-template-columns:1fr}.join-overview{grid-template-columns:1fr;gap:20px}}
  @media(max-width:700px){.membership-role,.membership-card{padding:30px 26px}}
  @media(max-width:600px){.join-btn{width:100%}.join-overview{margin-bottom:32px}.join-overview h2{font-size:clamp(38px,11vw,48px)}.join-overview>p:last-child{font-size:15px}}
</style>
