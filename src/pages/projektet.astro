---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';

const projects = [
  { title: 'Atlas', color: '#2f6f9f', icon: '🌍', pitch: 'Udhëzues praktikë, shtet pas shteti, për shqiptarët që jetojnë ose po mendojnë të shkojnë jashtë.', cards: [{ title: 'Dokumentet', text: 'Hapat praktikë për dokumentet dhe imigrimin.' }, { title: 'Jeta e përditshme', text: 'Informacion për integrimin dhe jetën në një shtet të ri.' }, { title: 'Rrjeti', text: 'Përvoja dhe lidhje nga anëtarë që kanë jetuar atje.' }], url: 'https://atlas.illyrianbrains.org/', label: 'Hap Atlas' },
  { title: 'Heritage', color: '#a7472a', icon: '🏛️', pitch: 'Informacion i qartë mbi trashëgiminë natyrore dhe kulturore të Shqipërisë dhe Kosovës.', cards: [{ title: 'Natyra', text: 'Gjendja e zonave natyrore dhe çfarë po mbrohet.' }, { title: 'Ligji', text: 'Kuadri ligjor dhe ndërhyrjet e planifikuara.' }, { title: 'Veprimi', text: 'Organizatat partnere, aktivizmi dhe raportimi.' }], url: 'https://heritage.illyrianbrains.org/', label: 'Hap Heritage' },
  { title: 'Mentoring', color: '#2f7352', icon: '🤝', pitch: 'Programi që lidh përvojën e anëtarëve me njerëzit që duan të bëjnë hapin e radhës.', cards: [{ title: 'Gjej mentor', text: 'Kërko sipas fushës, qytetit dhe përvojës.' }, { title: 'Vendos qëllimin', text: 'Përcakto çfarë dëshiron të arrish para takimit.' }, { title: 'Ndaj përvojën', text: 'Merr pjesë si mentor ose si i mentoruar.' }], url: 'https://mentoring.illyrianbrains.org/', label: 'Hap Mentoring' },
  { title: 'Locals', color: '#a66d00', icon: '🧭', pitch: 'Udhëzues udhëtimi të ngadaltë për të zbuluar Shqipërinë dhe Kosovën përmes njerëzve vendas.', cards: [{ title: 'Guida lokale', text: 'Qytete, vende të fshehta, bujtina dhe zejtarë.' }, { title: 'Planifikimi', text: 'Zgjidh sipas sezonit, kohëzgjatjes dhe llojit të udhëtimit.' }, { title: 'Kontributet', text: 'Shto njohuritë e tua në hartë dhe në burime të hapura.' }], url: 'https://locals.illyrianbrains.org/', label: 'Hap Locals' },
  { title: 'Playground', color: '#744761', icon: '🎮', pitch: 'Lojëra dhe ushtrime të shkurtra për njohje, mësim dhe prezantim brenda komunitetit.', cards: [{ title: 'Lojëra', text: 'Memory Match, Speed Sort dhe aktivitete të shpejta.' }, { title: 'Kuize', text: 'Tema si integrimi dhe AI për inxhinierë.' }, { title: 'Prezantimi', text: 'Ushtrime për t’u njohur dhe për të provuar një pitch.' }], url: '/projektet/playground/', label: 'Hap Playground' },
];
---
<SiteLayout title="Projektet e rrjetit · Illyrian Brains" description="Njihu me projektet e Illyrian Brains dhe me informacionin që ofron secili." mainClass="about-page projects-overview-page">
  <PageHero title="Projektet" eyebrow="Illyrian Brains">
    <p class="about-body">Pesë nisma të rrjetit, ndërtuar mbi njohuritë dhe përvojën e anëtarëve. Kjo faqe të jep një pamje të shpejtë të asaj që mund të gjesh në secilën.</p>
  </PageHero>

  {projects.map((project, index) => (
    <section class:list={['section', 'project-block', index % 2 === 0 ? 'tone-white' : 'tone-grey']} id={project.title.toLowerCase()} style={`--project: ${project.color}`} aria-labelledby={`${project.title.toLowerCase()}-title`}>
      <div class="container city-page">
        <div class="project-block-head">
          <span class="project-block-icon" aria-hidden="true">{project.icon}</span>
          <div><p class="eyebrow">Projekti {index + 1}</p><h2 id={`${project.title.toLowerCase()}-title`}>{project.title}</h2><p>{project.pitch}</p></div>
          <a class="project-block-link" href={project.url} {...(project.url.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {})}>{project.label}</a>
        </div>
        <div class="project-info-grid">
          {project.cards.map((card) => <article><h3>{card.title}</h3><p>{card.text}</p></article>)}
        </div>
      </div>
    </section>
  ))}
</SiteLayout>
