---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { statutiIntro, statutiArticles } from '../data/statuti';
import { organizeClauses, statutiSections } from '../utils/statuti';

const [title, , , ...introBody] = statutiIntro;
const sections = statutiSections.map((section) => ({
  ...section,
  articles: statutiArticles.filter(({ number }) => number >= section.from && number <= section.to),
}));
---
<BaseLayout title="Statuti · Illyrian Brains" description="Statuti i regjistruar i shoqatës Illyrian Brains Network.">
  <Header />
  <main class="about-page">
    <section class="section tone-dark statute-hero">
      <div class="container">
        <p class="eyebrow">Illyrian Brains Network</p>
        <h1>{title}</h1>
        <p class="statute-lead">Organizimi, anëtarësia dhe funksionimi i shoqatës.</p>
        <div class="statute-meta"><span>25 nene</span><span>5 seksione</span><a href="#permbajtja">Shfleto përmbajtjen ↓</a></div>
      </div>
    </section>

    <section class="section tone-white">
      <div class="container statute-layout">
        <section class="statute-intro" aria-labelledby="hyrje">
          <p class="eyebrow">Dokumenti themelor</p>
          <h2 id="hyrje">Hyrje</h2>
          {introBody.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <nav class="statute-toc" id="permbajtja" aria-label="Përmbajtja e statutit">
          <h2>Përmbajtja</h2>
          <div class="statute-toc-grid">
            {sections.map((section) => (
              <details open>
                <summary>{section.title}<small>Nenet {section.from}–{section.to}</small></summary>
                <ol>
                  {section.articles.map((article) => (
                    <li><a href={`#neni-${article.number}`}><span>{article.number.toString().padStart(2, '0')}</span><span>{article.title}</span></a></li>
                  ))}
                </ol>
              </details>
            ))}
          </div>
        </nav>

        <div class="statute-content">
          {sections.map((section, index) => (
            <section class="statute-section" aria-labelledby={section.id}>
              <header class="statute-section-heading" id={section.id}>
                <p class="eyebrow">Seksioni {index + 1} · Nenet {section.from}–{section.to}</p>
                <h2>{section.title}</h2>
              </header>
              {section.articles.map((article) => (
                <article class="statute-article" id={`neni-${article.number}`} aria-labelledby={`titulli-${article.number}`}>
                  <header><a class="statute-article-number" href={`#neni-${article.number}`}>Neni {article.number}</a><h3 id={`titulli-${article.number}`}>{article.title}</h3></header>
                  <div class="statute-clauses">
                    {organizeClauses(article).map((clause) => (
                      <section class:list={['statute-clause', { 'statute-subclause': clause.number.split('.').length > 3 }]} id={clause.id} aria-label={`Pika ${clause.number}`}>
                        <a class="statute-point" href={`#${clause.id}`} aria-label={`Lidhja te pika ${clause.number}`}>{clause.number}</a>
                        <div class="statute-clause-text">
                          <p>{clause.introduction}</p>
                          {clause.items.length > 0 && <ul>{clause.items.map((item) => <li>{item}</li>)}</ul>}
                        </div>
                      </section>
                    ))}
                  </div>
                  <a class="statute-back" href="#permbajtja">↑ Kthehu te përmbajtja</a>
                </article>
              ))}
            </section>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .statute-hero h1 { margin: 0; font-size: clamp(48px, 7vw, 80px); font-weight: 300; }
  .statute-lead { max-width: 540px; color: #d8ced4; font-size: 18px; }
  .statute-meta { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 32px; font-size: 15px; }
  .statute-meta a { text-decoration: underline; text-underline-offset: 5px; }
  .statute-layout { display: block; }
  .statute-toc { margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--line); }
  .statute-toc h2 { margin: 0 0 20px; font-size: 23px; }
  .statute-toc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
  .statute-toc details { padding: 14px 0; border-top: 1px solid var(--line); }
  .statute-toc summary { cursor: pointer; color: var(--accent-dark); font-size: 16px; font-weight: 700; }
  .statute-toc small { display: block; margin: 5px 0 0 16px; color: var(--muted); font-size: 14px; font-weight: 400; }
  .statute-toc ol { list-style: none; padding: 0; margin: 12px 0 0; }
  .statute-toc a { display: grid; grid-template-columns: 24px 1fr; gap: 10px; padding: 12px 8px; border-radius: 5px; font-size: 14px; line-height: 1.6; }
  .statute-toc a:hover { background: var(--soft); color: var(--accent); }
  .statute-toc a span:first-child { color: var(--accent); font-variant-numeric: tabular-nums; }
  .statute-content { min-width: 0; margin-top: 56px; }
  .statute-intro { padding: 28px; border: 1px solid var(--line); border-radius: 12px; background: var(--soft); }
  .statute-intro h2 { margin: 0 0 16px; font-size: 28px; }
  .statute-intro p:not(.eyebrow), .statute-clause-text { font-size: 18px; line-height: 1.8; }
  .statute-intro p:last-child { margin-bottom: 0; }
  .statute-section { margin-top: 64px; }
  .statute-section-heading { padding-bottom: 24px; border-bottom: 2px solid var(--accent); }
  .statute-section-heading h2 { margin: 0; font-size: clamp(28px, 4vw, 36px); font-weight: 400; }
  .statute-article { padding: 32px 0; border-bottom: 1px solid var(--line); }
  .statute-article-number { color: var(--accent); font-size: 15px; font-weight: 700; }
  .statute-article h3 { margin: 10px 0 24px; font-size: 24px; line-height: 1.45; font-weight: 600; overflow-wrap: anywhere; }
  .statute-clause { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 16px; padding: 20px 0; }
  .statute-clause + .statute-clause { border-top: 1px solid #eeeaed; }
  .statute-point { color: var(--accent); font-size: 16px; font-weight: 700; padding-top: 4px; }
  .statute-clause-text p { margin: 0; }
  .statute-clause-text ul { list-style: none; padding: 0 0 0 18px; margin: 16px 0 0; border-left: 2px solid #e3d6df; }
  .statute-clause-text li { padding: 10px 0; }
  .statute-clause-text li + li { border-top: 1px solid #eeeaed; }
  .statute-subclause { padding-left: 12px; }
  .statute-back { display: inline-block; margin-top: 20px; color: var(--muted); font-size: 15px; }
  .statute-back:hover, .statute-point:hover { color: var(--accent-dark); text-decoration: underline; }
  :target { scroll-margin-top: 24px; }
  .statute-clause:target { background: #f7f2f5; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 540px) {
    .statute-intro { padding: 20px; }
    .statute-toc-grid { grid-template-columns: 1fr; }
    .statute-clause { grid-template-columns: 1fr; gap: 8px; }
    .statute-section { margin-top: 44px; }
  }
  @media print {
    .statute-toc, .statute-back, .statute-meta { display: none; }
    .statute-section-heading, .statute-article header { break-after: avoid; }
    .statute-clause { break-inside: avoid; }
  }
</style>
