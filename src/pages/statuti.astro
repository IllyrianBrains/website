---
import SiteLayout from '../layouts/SiteLayout.astro';
import { statutiIntro, statutiArticles } from '../data/statuti';
import { organizeClauses, statutiSections } from '../utils/statuti';

const [title, , , ...introBody] = statutiIntro;
const sections = statutiSections.map(section => ({
  ...section,
  articles: statutiArticles.filter(article => article.number >= section.from && article.number <= section.to),
}));
---
<SiteLayout title="Statuti · Illyrian Brains" description="Statuti i regjistruar i shoqatës Illyrian Brains Network." mainClass="statute-page">
    <section class="statute-hero">
      <div class="statute-document">
        <p class="eyebrow">Illyrian Brains Network</p>
        <h1>{title}</h1>
        <p>Dokumenti themelor për organizimin dhe funksionimin e shoqatës.</p>
      </div>
    </section>

    <section class="statute-body">
      <div class="statute-document">
        <div class="statute-introduction">
          {introBody.map(paragraph => <p>{paragraph}</p>)}
        </div>

        {sections.map(section => (
          <section class="statute-section">
            <h2>{section.title}</h2>
            {section.articles.map(article => (
              <article class="statute-article">
                <h3><span>Neni {article.number}</span>{article.title}</h3>
                <div class="statute-clauses">
                  {organizeClauses(article).map(clause => (
                    <div class="statute-clause">
                      <p>
                        {clause.number && <strong>{clause.number}</strong>}
                        {clause.introduction}
                      </p>
                      {clause.items.length > 0 && (
                        <ul>{clause.items.map(item => <li>{item}</li>)}</ul>
                      )}
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </section>
        ))}
      </div>
    </section>
</SiteLayout>

<style>
  .statute-page{color:var(--ink);background:var(--paper)}
  .statute-document{width:min(100% - 40px,820px);margin-inline:auto}
  .statute-hero{padding:88px 0 72px;color:#fff;background:var(--night)}
  .statute-hero h1{margin:0;font-size:clamp(50px,8vw,78px);font-weight:300;line-height:1}
  .statute-hero>div>p:last-child{max-width:580px;margin:22px 0 0;color:#ffffffb5;font-size:19px;line-height:1.7}
  .statute-body{padding:72px 0 100px}
  .statute-introduction{padding-bottom:42px;border-bottom:1px solid var(--line)}
  .statute-introduction p{margin:0;color:var(--muted);font-size:18px;line-height:1.85}
  .statute-introduction p+p{margin-top:14px}
  .statute-section{padding-top:58px}
  .statute-section+.statute-section{margin-top:34px;border-top:1px solid var(--line)}
  .statute-section>h2{margin:0 0 38px;color:var(--accent-dark);font-size:clamp(28px,4vw,36px);font-weight:500;line-height:1.25}
  .statute-article+.statute-article{margin-top:42px}
  .statute-article h3{margin:0 0 17px;font-size:22px;font-weight:600;line-height:1.45}
  .statute-article h3 span{display:block;margin-bottom:5px;color:var(--accent);font-size:14px;font-weight:700;text-transform:none}
  .statute-clause+.statute-clause{margin-top:15px}
  .statute-article p{margin:0;color:#3f4046;font-size:17px;line-height:1.85;overflow-wrap:anywhere}
  .statute-clause p strong{margin-right:7px;color:var(--accent-dark);font-weight:700}
  .statute-clause ul{margin:13px 0 0;padding:0;list-style:none}
  .statute-clause li{padding:6px 0 6px 22px;color:#3f4046;font-size:17px;line-height:1.75;text-indent:-22px}
  .statute-clause li+li{margin-top:4px}
  @media(max-width:560px){.statute-document{width:min(100% - 30px,820px)}.statute-hero{padding:62px 0 54px}.statute-body{padding:52px 0 76px}.statute-section{padding-top:44px}.statute-section+.statute-section{margin-top:24px}.statute-article+.statute-article{margin-top:34px}.statute-article p{font-size:16px;line-height:1.8}}
  @media print{.statute-hero{padding:20px 0;color:#000;background:#fff}.statute-body{padding-top:20px}.statute-section,.statute-article{break-inside:avoid}}
</style>
