---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Faqja nuk u gjet · Illyrian Brains" description="Faqja që kërkoni nuk ekziston ose është zhvendosur.">
  <Header />
  <main>
    <section class="section tone-dark page-hero">
      <div class="container city-page">
        <h1>404</h1>
        <p class="about-body">Faqja që kërkoni nuk ekziston ose është zhvendosur.</p>
        <div class="join-cta-actions">
          <a class="partner-button" href="/">Kthehu tek Ballina <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
